{
  "Application": {
    "Environment": "local",
    "Domain": "Marketplace",
    "DomainSource": "urn::skedular::marketplace",
    "AppSource": "marketplace-domain-integrationtests"
  },
  "Kafka": {
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "UseSchemaRegistry": true,
    "SchemaRegistry": {
      "Url": "",
      "AutoRegisterSchema": false,
      "UseLatestVersion": false
    }
  },
  "Email": {
    "NewMarketplaceFeedbackSubmittedEmailReceivers": [],
    "NewMarketplaceFeedbackSubmittedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "NewMarketplaceJoinedEmailReceivers": [],
    "NewMarketplaceJoinedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "EnableNewMarketplaceJoinedEmail": false
  }
}
