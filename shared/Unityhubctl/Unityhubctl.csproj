<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1"/>
        <PackageReference Include="DotLiquid" Version="2.2.692"/>
        <PackageReference Include="GraphQL" Version="8.0.2"/>
        <PackageReference Include="GraphQL-Parser" Version="9.5.0"/>

        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.11.20">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Events\Generator\Resources\EventMetadata.liquid"/>
        <EmbeddedResource Include="Events\Generator\Resources\EventWithoutMetadata.liquid"/>
        <EmbeddedResource Include="GraphQL\Generator\Resources\GraphQL.liquid"/>
        <EmbeddedResource Include="GraphQL\Generator\Resources\GraphQLMetadata.liquid"/>
    </ItemGroup>

</Project>
