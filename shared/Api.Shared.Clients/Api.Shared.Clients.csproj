<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Api.Shared.Clients</AssemblyName>
        <AssemblyTitle>Api.Shared.Clients</AssemblyTitle>
        <Product>Skedular Api.Shared.Clients</Product>
        <Description>Skedular Api.Shared.Clients</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/unityhubio/unityhubio</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GitRepositoryRoot>$(SolutionDir)</GitRepositoryRoot>
        <WriteVersionInfoToBuildLog>true</WriteVersionInfoToBuildLog>
        <UseFullSemVerForNuGet>true</UseFullSemVerForNuGet>
        <UpdateVersionProperties>true</UpdateVersionProperties>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Event protobuf classes are generated into obj/ instead of checked-in source paths.
             Suppress the protobuf target warning about those generated files not being in the old expected location. -->
        <Protobuf_NoWarnMissingExpected>true</Protobuf_NoWarnMissingExpected>
    </PropertyGroup>

    <ItemGroup>
        <!-- Build Tools -->
        <PackageReference Include="GitVersion.MsBuild" Version="6.7.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- Build Tools / Event Protobuf Serialization -->
        <PackageReference Include="Grpc.Tools" Version="2.80.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <Protobuf Include="../../api-definitions/events/skedular/booking_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/booking_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/booking_internal_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/booking_internal_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/customer_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/customer_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/location_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/location_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/marketplace_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/marketplace_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/organization_internal_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/organization_internal_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/organization_member_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/organization_member_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/organization_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/organization_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/team_v1_key.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../api-definitions/events/skedular/team_v1_value.proto" GrpcServices="None" ProtoRoot="../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Enterprise.Shared/Enterprise.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="OpenApi\"/>
    </ItemGroup>

    <Target Name="IncludeGeneratedEventProtobufSources" BeforeTargets="CoreCompile">
        <ItemGroup>
            <!-- Event protobuf classes are generated into obj/ and intentionally not checked into the repo.
                 Include those transient outputs after protobuf generation so checked-in metadata companions can compile
                 against them on clean builds and in CI. -->
            <Compile Include="$(IntermediateOutputPath)*Key.g.cs" Visible="false"/>
            <Compile Include="$(IntermediateOutputPath)*Value.g.cs" Visible="false"/>
        </ItemGroup>
    </Target>
</Project>
