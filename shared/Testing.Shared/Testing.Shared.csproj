<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Testing.Shared</AssemblyName>
        <AssemblyTitle>Testing.Shared</AssemblyTitle>
        <Product>Skedular Testing.Shared</Product>
        <Description>Skedular Testing.Shared</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/unityhubio/unityhubio</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GitRepositoryRoot>$(SolutionDir)</GitRepositoryRoot>
        <WriteVersionInfoToBuildLog>true</WriteVersionInfoToBuildLog>
        <UseFullSemVerForNuGet>true</UseFullSemVerForNuGet>
        <UpdateVersionProperties>true</UpdateVersionProperties>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Build Tools -->
        <PackageReference Include="GitVersion.MsBuild" Version="6.7.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Test Framework (xUnit) -->
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>

        <!-- Test Fixtures (AutoFixture) -->
        <PackageReference Include="AutoFixture" Version="5.0.0-preview0012"/>
        <PackageReference Include="AutoFixture.AutoFakeItEasy" Version="5.0.0-preview0012"/>
        <PackageReference Include="AutoFixture.Xunit3" Version="5.0.0-preview0012"/>

        <!-- Mocking -->
        <PackageReference Include="FakeItEasy" Version="9.0.1"/>

        <!-- Assertions -->
        <PackageReference Include="Shouldly" Version="4.3.0"/>

        <!-- GraphQL Client (for integration / API testing) -->
        <PackageReference Include="GraphQL.Client" Version="6.1.0"/>
        <PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" Version="6.1.0"/>

        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Enterprise.Shared/Enterprise.Shared.csproj"/>
    </ItemGroup>
</Project>
