  zones(
    after: String
    first: Int
    before: String
    last: Int
    where: ZoneOrganizationTagWhereInput
    orderBy: [OrganizationTagOrderInput!]
  ): ConnectionOfOrganizationTagEdge! @cost(weight: "10")
  uniqueId: String!
  customDomain: String
  name: String!
  website: String
  customerFacingTermsAndConditionsUrl: String
  logoUrl: String
  industrySubCategories: [OrganizationIndustrySubCategoryReferenceDetails!]!
  contactEmail: String
  contactPhone: String
