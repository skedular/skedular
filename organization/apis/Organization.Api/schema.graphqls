  id: ID!
}

type OrganizationInvitationStatusDetails {
  type: InvitationStatus!
  name: String!
}

type OrganizationJoinInvitationEdge {
  node: InviteCustomerToJoinOrganizationDetails!
  cursor: String!
}

type OrganizationMemberAttendancePercentage {
