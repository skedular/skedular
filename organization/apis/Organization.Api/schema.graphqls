schema {
  query: Query
  mutation: Mutation
}

type Query {
  isAzureTenantInstalled: Boolean! @cost(weight: "10")
  azureTenantAdminConsentUrl: String! @cost(weight: "10")
  azureTenantOrganization: OrganizationDetails @cost(weight: "10")
  organizationBankAccount(id: String!): OrganizationBankAccountDetails
    @cost(weight: "10")
  organizationBankAccountById(id: ID!): OrganizationBankAccountDetails
    @lookup
    @internal
    @cost(weight: "10")
  organizationBankAccounts(
    after: String
    first: Int
    before: String
    last: Int
    where: OrganizationBankAccountWhereInput!
    orderBy: [OrganizationBankAccountOrderInput!]
  ): ConnectionOfOrganizationBankAccountEdge! @cost(weight: "10")
  organizationInvitationStatuses: [OrganizationInvitationStatusDetails!]!
  pendingOrganizationInvitationsCount: Int! @cost(weight: "10")
  myInvitationsToJoinOrganizations(
    after: String
    first: Int
    before: String
    last: Int
    where: MyInvitationsToJoinOrganizationsWhereInput!
    orderBy: [JoinOrganizationInvitationOrderInput!]
  ): ConnectionOfOrganizationJoinInvitationEdge! @cost(weight: "10")
  organizationMemberRoles: [OrganizationMemberRoleDetails!]!
  organizationMemberStatuses: [OrganizationMemberStatusDetails!]!
  organizationOffering(code: String!): OrganizationOfferingDetails!
  organizationTypes: [OrganizationTypeDetails!]!
  organizationBillingCycles: [OrganizationBillingCycleDetails!]!
  organizationXeroBillingModes: [OrganizationXeroBillingModeDetails!]!
  activeOrganizationTermsOfUse: OrganizationTermsOfUse! @cost(weight: "10")
  organizationIndustryMainCategoriesReferences: [OrganizationIndustryMainCategoryReferenceDetails!]!
    @cost(weight: "10")
  organization(id: String, customDomain: String): OrganizationDetails
    @cost(weight: "10")
  organizationPublic(id: String, customDomain: String): OrganizationPublicDetails
    @cost(weight: "10")
  organizationById(id: ID!): OrganizationDetails
    @lookup
    @internal
    @cost(weight: "10")
  organizations(
    after: String
    first: Int
    before: String
    last: Int
    where: OrganizationWhereInput!
    orderBy: [OrganizationOrderInput!]
  ): ConnectionOfOrganizationEdge! @cost(weight: "10")
  myOrganizations(types: [OrganizationType!]): [MyOrganizationDetails!]!
    @cost(weight: "10")
  organizationVersion: Version!
  bookingSlotSizeInMinutes: Int!
  resourceTypes: [OrganizationTagTypeDetails!]!
  locationSpaceTypes: [OrganizationTagTypeDetails!]!
  emailsToShowLatestCapabilities: [String!]!
  emailsToIgnoreObservability: [String!]!
  organizationStripeConnectAccount(id: String!): OrganizationStripeConnectAccountDetails
    @cost(weight: "10")
  organizationStripeConnectAccountById(id: ID!): OrganizationStripeConnectAccountDetails
    @lookup
    @internal
    @cost(weight: "10")
  organizationStripeConnectAccounts(
    after: String
    first: Int
    before: String
    last: Int
    where: OrganizationStripeConnectAccountWhereInput!
    orderBy: [OrganizationStripeConnectAccountOrderInput!]
  ): ConnectionOfOrganizationStripeConnectAccountEdge! @cost(weight: "10")
  deskResourceType: OrganizationTagType!
  roomResourceType: OrganizationTagType!
  parkingResourceType: OrganizationTagType!
  otherResourceType: OrganizationTagType!
  customTag(id: String!): OrganizationTagDetails @cost(weight: "10")
  customTagById(id: ID!): OrganizationTagDetails
    @lookup
    @internal
    @cost(weight: "10")
  zone(id: String!): OrganizationTagDetails @cost(weight: "10")
  zoneById(id: ID!): OrganizationTagDetails
    @lookup
    @internal
    @cost(weight: "10")
  productTag(id: String!): OrganizationTagDetails @cost(weight: "10")
  productTagById(id: ID!): OrganizationTagDetails
    @lookup
    @internal
    @cost(weight: "10")
}

type Mutation {
  addOrganizationBankAccount(input: AddOrganizationBankAccountInput!): OrganizationBankAccountPayload!
    @cost(weight: "10")
  updateOrganizationBankAccount(input: UpdateOrganizationBankAccountInput!): OrganizationBankAccountPayload!
    @cost(weight: "10")
  deleteOrganizationBankAccount(input: DeleteOrganizationBankAccountInput!): OrganizationBankAccountPayload!
    @cost(weight: "10")
  deleteOrganizationBankAccounts(input: DeleteOrganizationBankAccountsInput!): OrganizationBankAccountsPayload!
    @cost(weight: "10")
  setOrganizationBankAccountAsDefault(
    input: SetOrganizationBankAccountAsDefaultInput!
  ): OrganizationBankAccountPayload! @cost(weight: "10")
  updateOrganizationBillingDetails(
    input: UpdateOrganizationBillingDetailsInput!
  ): OrganizationPayload! @cost(weight: "10")
  inviteCustomersToJoinOrganization(
    input: InviteCustomersToJoinOrganizationInput!
  ): InvitationsToJoinOrganizationPayload! @cost(weight: "10")
  acceptInvitationToJoinOrganization(
    input: AcceptInvitationToJoinOrganizationInput!
  ): InvitationToJoinOrganizationPayload! @cost(weight: "10")
  rejectInvitationToJoinOrganization(
    input: RejectInvitationToJoinOrganizationInput!
  ): InvitationToJoinOrganizationPayload! @cost(weight: "10")
  cancelInvitationToJoinOrganization(
    input: CancelInvitationToJoinOrganizationInput!
  ): InvitationToJoinOrganizationPayload! @cost(weight: "10")
  changeOrganizationMemberRole(input: ChangeOrganizationMemberRoleInput!): OrganizationMemberDetailsPayload!
    @cost(weight: "10")
  changeOrganizationMembersStatus(input: ChangeOrganizationMembersStatusInput!): OrganizationMembersDetailsPayload!
    @cost(weight: "10")
  removeOrganizationMembers(input: RemoveOrganizationMembersInput!): OrganizationMembersDetailsPayload!
    @cost(weight: "10")
  completeOrganizationMemberOnboarding(
    input: CompleteOrganizationMemberOnboardingInput!
  ): OrganizationMemberPayload! @cost(weight: "10")
  updateOrganizationOffering(input: UpdateOrganizationOfferingInput!): UpdateOrganizationOfferingPayload!
    @cost(weight: "10")
  cancelOrganizationOffering(input: CancelOrganizationOfferingInput!): CancelOrganizationOfferingPayload!
    @cost(weight: "10")
  addOrganization(input: AddOrganizationInput!): OrganizationPayload!
    @cost(weight: "10")
  updateOrganization(input: UpdateOrganizationInput!): OrganizationPayload!
    @cost(weight: "10")
  deleteOrganization(input: DeleteOrganizationInput!): OrganizationPayload!
    @cost(weight: "10")
  addOrganizationPaymentMethodIntent(
    input: AddOrganizationPaymentMethodIntentInput!
  ): AddOrganizationPaymentMethodIntentPayload! @cost(weight: "10")
  removeOrganizationPaymentMethod(input: RemoveOrganizationPaymentMethodInput!): RemoveOrganizationPaymentMethodPayload!
    @cost(weight: "10")
  updateOrganizationSsoSettings(input: UpdateOrganizationSsoSettingsInput!): OrganizationPayload!
    @cost(weight: "10")
  removeOrganizationSsoSettings(input: RemoveOrganizationSsoSettingsInput!): OrganizationPayload!
    @cost(weight: "10")
  addOrganizationStripeConnectAccount(
    input: AddOrganizationStripeConnectAccountInput!
  ): OrganizationStripeConnectAccountPayload! @cost(weight: "10")
  updateOrganizationStripeConnectAccount(
    input: UpdateOrganizationStripeConnectAccountInput!
  ): OrganizationStripeConnectAccountPayload! @cost(weight: "10")
  deleteOrganizationStripeConnectAccount(
    input: DeleteOrganizationStripeConnectAccountInput!
  ): OrganizationStripeConnectAccountPayload! @cost(weight: "10")
  deleteOrganizationStripeConnectAccounts(
    input: DeleteOrganizationStripeConnectAccountsInput!
  ): OrganizationStripeConnectAccountsPayload! @cost(weight: "10")
  setOrganizationStripeConnectAccountAsDefault(
    input: SetOrganizationStripeConnectAccountAsDefaultInput!
  ): OrganizationStripeConnectAccountPayload! @cost(weight: "10")
  addCustomTag(input: AddCustomTagInput!): OrganizationTagPayload!
    @cost(weight: "10")
  updateCustomTag(input: UpdateOrganizationTagInput!): OrganizationTagPayload!
    @cost(weight: "10")
  deleteCustomTag(input: DeleteCustomTagInput!): OrganizationTagPayload!
    @cost(weight: "10")
  deleteCustomTags(input: DeleteCustomTagsInput!): OrganizationTagsPayload!
    @cost(weight: "10")
  addZone(input: AddZoneInput!): OrganizationTagPayload! @cost(weight: "10")
  updateZone(input: UpdateOrganizationTagInput!): OrganizationTagPayload!
    @cost(weight: "10")
  deleteZone(input: DeleteZoneInput!): OrganizationTagPayload!
    @cost(weight: "10")
  deleteZones(input: DeleteZonesInput!): OrganizationTagsPayload!
    @cost(weight: "10")
  addProductTag(input: AddProductTagInput!): OrganizationTagPayload!
    @cost(weight: "10")
  updateProductTag(input: UpdateOrganizationTagInput!): OrganizationTagPayload!
    @cost(weight: "10")
  deleteProductTag(input: DeleteProductTagInput!): OrganizationTagPayload!
    @cost(weight: "10")
  deleteProductTags(input: DeleteProductTagsInput!): OrganizationTagsPayload!
    @cost(weight: "10")
  updateOrganizationTaxDetails(input: UpdateOrganizationTaxDetailsInput!): OrganizationPayload!
    @cost(weight: "10")
  removeOrganizationTaxDetails(input: RemoveOrganizationTaxDetailsInput!): OrganizationPayload!
    @cost(weight: "10")
  updateOrganizationXeroConnection(
    input: UpdateOrganizationXeroConnectionInput!
  ): OrganizationPayload! @cost(weight: "10")
  disconnectOrganizationXeroConnection(
    input: DisconnectOrganizationXeroConnectionInput!
  ): OrganizationPayload! @cost(weight: "10")
}

type AddOrganizationPaymentMethodIntentPayload {
  clientMutationId: String
  publishedKeys: String!
  clientSecret: String!
}

type CancelOrganizationOfferingPayload {
  clientMutationId: String
}

type CdnFile @shareable {
  url: String!
  height: Int
  width: Int
}

type CdnImageFile @shareable {
  original: CdnFile
  thumbnail: CdnFile
}

type ConnectionOfOrganizationBankAccountEdge {
  pageInfo: PageInfo!
  edges: [OrganizationBankAccountEdge!]!
  totalCount: Int!
}

type ConnectionOfOrganizationEdge {
  pageInfo: PageInfo!
  edges: [OrganizationEdge!]!
  totalCount: Int!
}

type ConnectionOfOrganizationJoinInvitationEdge {
  pageInfo: PageInfo!
  edges: [OrganizationJoinInvitationEdge!]!
  totalCount: Int!
}

type ConnectionOfOrganizationMemberEdge {
  pageInfo: PageInfo!
  edges: [OrganizationMemberEdge!]!
  totalCount: Int!
}

type ConnectionOfOrganizationStripeConnectAccountEdge {
  pageInfo: PageInfo!
  edges: [OrganizationStripeConnectAccountEdge!]!
  totalCount: Int!
}

type ConnectionOfOrganizationTagEdge {
  pageInfo: PageInfo!
  edges: [OrganizationTagEdge!]!
  totalCount: Int!
}

type CustomerDetails @key(fields: "id") {
  id: ID!
}

type InvitationsToJoinOrganizationPayload {
  clientMutationId: String
  invitesCustomersToJoinOrganization: [InviteCustomerToJoinOrganizationDetails!]!
}

type InvitationToJoinOrganizationPayload {
  clientMutationId: String
  inviteCustomerToJoinOrganization: InviteCustomerToJoinOrganizationDetails!
}

type InviteCustomerToJoinOrganizationDetails {
  createdBy: CustomerDetails!
  invitee: CustomerDetails
  email: String
  status: OrganizationInvitationStatusDetails!
  role: OrganizationMemberRole!
  organization: OrganizationDetails!
  id: ID!
}

type ListingMetadata @shareable {
  about: String
  title: String
  subTitle: String
  includedFeatures: [String!]
}

type MyOrganizationDetails {
  uniqueId: String!
  customDomain: String
  name: String!
  website: String
  customerFacingTermsAndConditionsUrl: String
  logoUrl: String
  type: OrganizationTypeDetails!
  contactEmail: String
  contactPhone: String
  isMyOnboardingDone: Boolean!
  featureImages: [CdnImageFile!]!
  listingMetadata: ListingMetadata!
}

type OrganizationActiveOfferingDetails {
  code: String!
  isEnterprise: Boolean!
  name: String!
  start: DateTime!
  end: DateTime!
  unitPrice: Int!
  underPriceLines: [String!]!
  featureSet: [String!]!
  free: Boolean!
  earlyBird: Boolean!
  id: ID!
}

type OrganizationAnalytics {
  memberAttendancePercentage: [OrganizationMemberAttendancePercentage!]!
  dailyBookingsTotals: [OrganizationDailyBookingsTotal!]!
}

type OrganizationBankAccountDetails {
  isDefault: Boolean!
  name: String!
  bankName: String!
  accountHolderName: String!
  accountNumber: String!
  country: String!
  countryCode: String
  organization: OrganizationDetails!
  id: ID!
}

type OrganizationBankAccountEdge {
  node: OrganizationBankAccountDetails!
  cursor: String!
}

type OrganizationBankAccountPayload {
  clientMutationId: String
  organizationBankAccount: OrganizationBankAccountDetails!
}

type OrganizationBankAccountsPayload {
  clientMutationId: String
  organizationBankAccounts: [OrganizationBankAccountDetails!]!
}

type OrganizationBillingCycleDetails {
  type: OrganizationBillingCycle!
  name: String!
}

type OrganizationBillingDetails {
  companyName: String
  email: String!
  osmType: String
  osmId: String
  placeId: String
  longitude: Float
  latitude: Float
  formattedAddress: String
  multilinesFormattedAddress: String
  addressLine1: String!
  addressLine2: String
  suburb: String
  city: String
  province: String
  zipcode: String!
  country: String!
  countryCode: String
  id: ID!
}

type OrganizationDailyBookingsTotal {
  date: DateTime!
  total: Int!
}

type OrganizationDetails @key(fields: "id") @shareable {
  members(
    after: String
    first: Int
    before: String
    last: Int
    where: OrganizationMemberWhereInput
    orderBy: [OrganizationMemberOrderInput!]
  ): ConnectionOfOrganizationMemberEdge! @cost(weight: "10")
  customTags(
    after: String
    first: Int
    before: String
    last: Int
    where: CustomTagOrganizationTagWhereInput
    orderBy: [OrganizationTagOrderInput!]
  ): ConnectionOfOrganizationTagEdge! @cost(weight: "10")
  zones(
    after: String
    first: Int
    before: String
    last: Int
    where: ZoneOrganizationTagWhereInput
    orderBy: [OrganizationTagOrderInput!]
  ): ConnectionOfOrganizationTagEdge! @cost(weight: "10")
  productTags(
    after: String
    first: Int
    before: String
    last: Int
    where: ProductTagOrganizationTagWhereInput
    orderBy: [OrganizationTagOrderInput!]
  ): ConnectionOfOrganizationTagEdge! @cost(weight: "10")
  analytics(from: DateTime!, until: DateTime!): OrganizationAnalytics!
    @cost(weight: "10")
  isSsoTokenValid: Boolean! @cost(weight: "10")
  ssoLoginUrl(redirectUrl: String!): String! @cost(weight: "10")
  customDomain: String
  name: String!
  website: String
  customerFacingTermsAndConditionsUrl: String
  logoUrl: String
  type: OrganizationTypeDetails!
  agreedToTermsOfUse: Boolean!
  termsOfUse: OrganizationTermsOfUse
  contactEmail: String
  contactPhone: String
  refundNotificationEmails: [String!]!
  isOwnershipVerified: Boolean!
  physicalAddress: OrganizationPhysicalAddressDetails
  billingDetails: OrganizationBillingDetails
  availableOfferings: [OrganizationOfferingDetails!]!
  activeOffering: OrganizationActiveOfferingDetails!
  canModify: Boolean!
  canDelete: Boolean!
  canInvitePeople: Boolean!
  canViewAnalytics: Boolean!
  isMyOnboardingDone: Boolean!
  resourceTypes: [OrganizationTagDetails!]!
  locationSpaceTypes: [OrganizationTagDetails!]!
  amenities: [OrganizationTagDetails!]!
  paymentMethods: [OrganizationPaymentMethod!]!
  ssoSettings: OrganizationSsoSettingsDetails
  taxDetails: OrganizationTaxDetails
  xeroConnection: OrganizationXeroConnection
  featureImages: [CdnImageFile!]!
  listingMetadata: ListingMetadata!
  industrySubCategories: [OrganizationIndustrySubCategoryReferenceDetails!]!
  stripeAuthorizeExistingConnectAccountUrl: String!
  hasAttachedPaymentMethod: Boolean!
  marketplaceListingMetadata: ListingMetadata!
  billingCycle: OrganizationBillingCycleDetails!
  invoiceDueInDays: Int!
  id: ID!
}

type OrganizationEdge {
  node: OrganizationDetails!
  cursor: String!
}

type OrganizationIndustryMainCategoryReferenceDetails {
  name: String!
  subCategories: [OrganizationIndustrySubCategoryReferenceDetails!]!
  id: ID!
}

type OrganizationIndustrySubCategoryReferenceDetails {
  name: String!
