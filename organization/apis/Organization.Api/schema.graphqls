}

type OrganizationMemberPayload {
  clientMutationId: String
}

type OrganizationMemberRoleDetails {
  type: OrganizationMemberRole!
  name: String!
}

type OrganizationMembersDetailsPayload {
  clientMutationId: String
  members: [OrganizationMemberDetails!]!
}

type OrganizationMemberStatusDetails {
  type: OrganizationMemberStatus!
  name: String!
}

