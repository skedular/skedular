{
  "Application": {
    "Environment": "local",
    "Domain": "Organization",
    "DomainSource": "urn::skedular::organization",
    "AppSource": "organization-domain-integrationtests"
  },
  "Kafka": {
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "UseSchemaRegistry": true,
    "SchemaRegistry": {
      "Url": "",
      "AutoRegisterSchema": false,
      "UseLatestVersion": false
    }
  },
  "Email": {
    "InviteToJoinOrganizationNewCustomerEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "InviteToJoinOrganizationExistingCustomerEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "NewOrganizationJoinedEmailReceivers": [],
    "NewOrganizationJoinedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "EnableNewOrganizationJoinedEmail": false
  }
}
