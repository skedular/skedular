<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Tools" Version="2.67.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/billing_v1.proto" GrpcServices="Client"/>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/booking_v1.proto" GrpcServices="Client"/>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/customer_v1.proto" GrpcServices="Client"/>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/location_v1.proto" GrpcServices="Client"/>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/notification_v1.proto" GrpcServices="Client"/>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/organization_v1.proto" GrpcServices="Client"/>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/payment_v1.proto" GrpcServices="Client"/>
        <Protobuf Include="../../../api-definitions/grpc/unityhub/team_v1.proto" GrpcServices="Client"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SlackNet" Version="0.15.1"/>
        <PackageReference Include="SlackNet.AspNetCore" Version="0.15.1"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.11.20">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\shared\Api.Shared.Clients\Api.Shared.Clients.csproj"/>
        <ProjectReference Include="..\..\..\shared\Api.Shared.Services\Api.Shared.Services.csproj"/>
        <ProjectReference Include="..\..\..\shared\Enterprise.Shared\Enterprise.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json"/>
    </ItemGroup>

</Project>
