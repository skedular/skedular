{
  "Application": {
    "Environment": "local",
    "Domain": "Slack",
    "DomainSource": "urn::skedular::slack",
    "AppSource": "slack-domain-integrationtests"
  },
  "Kafka": {
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "UseSchemaRegistry": true,
    "SchemaRegistry": {
      "Url": "",
      "AutoRegisterSchema": false,
      "UseLatestVersion": false
    }
  },
  "Email": {
    "NewSlackFeedbackSubmittedEmailReceivers": [],
    "NewSlackFeedbackSubmittedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "NewSlackJoinedEmailReceivers": [],
    "NewSlackJoinedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "EnableNewSlackJoinedEmail": false
  }
}
