{
  "name": "msteams",
  "version": "0.1.0",
  "description": "UnityHub MsTeams Web App",
  "private": true,
  "scripts": {
    "dev": "HTTPS=true PORT=15002 react-scripts start",
    "build": "react-scripts build",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "start": "HTTPS=true PORT=15002 react-scripts start",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "format": "prettier --write --single-quote true --trailing-comma all --print-width 150 ./src && pnpm lint-fix",
    "remove-relay-generated-files": "find ./src -type d -name __generated__ -exec rm -rf {} +",
    "relay": "relay-compiler $@"
  },
  "dependencies": {
