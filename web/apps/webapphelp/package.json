  },
  "dependencies": {
    "next": "^16.0.7",
    "nextra": "^4.6.0",
    "nextra-theme-docs": "^4.6.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
