{
  "name": "skedular-web",
  "description": "Skedular Web",
  "private": true,
  "engines": {
    "node": "^22"
  },
  "packageManager": "pnpm@10.17.1",
  "workspace": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:teams": "turbo run dev:teams",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint-fix": "turbo run lint-fix",
    "format": "turbo run format",
    "relay": "turbo run relay",
    "webapp#build": "turbo run webapp#build",
    "webapp#start": "turbo run webapp#start",
    "webapp#lint": "turbo run webapp#lint",
    "webapp#lint-fix": "turbo run webapp#lint-fix",
    "webapp#format": "turbo run webapp#format",
    "webapp#relay": "turbo run webapp#relay"
  },
  "devDependencies": {
    "@types/relay-runtime": "^19.0.2",
    "eslint": "9.36.0",
    "eslint-plugin-turbo": "^2.5.6",
    "global": "^4.4.0",
    "next": "15.5.3",
    "turbo": "^2.5.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vercel/speed-insights",
      "botbuilder-dialogs",
      "globalize",
      "sharp"
    ],
    "patchedDependencies": {
      "globalize@1.7.0": "patches/globalize@1.7.0.patch"
    }
  }
}
