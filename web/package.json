{
  "name": "unityhub-web",
  "description": "UnityHub Web",
  "private": true,
  "engines": {
    "node": "^20"
  },
  "packageManager": "pnpm@9.15.0",
  "workspace": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint-fix": "turbo run lint-fix",
    "format": "turbo run format",
    "relay": "turbo run relay",
    "publicwebsite#build": "turbo run publicwebsite#build",
    "publicwebsite#start": "turbo run publicwebsite#start",
    "publicwebsite#lint": "turbo run publicwebsite#lint",
    "publicwebsite#lint-fix": "turbo run publicwebsite#lint-fix",
    "publicwebsite#format": "turbo run publicwebsite#format",
    "webapp#build": "turbo run webapp#build",
    "webapp#start": "turbo run webapp#start",
    "webapp#lint": "turbo run webapp#lint",
    "webapp#lint-fix": "turbo run webapp#lint-fix",
    "webapp#format": "turbo run webapp#format",
    "webapp#relay": "turbo run webapp#relay",
    "msteams#build": "turbo run msteams#build",
    "msteams#start": "turbo run msteams#start",
    "msteams#lint": "turbo run msteams#lint",
    "msteams#lint-fix": "turbo run msteams#lint-fix",
    "msteams#format": "turbo run msteams#format",
    "msteams#relay": "turbo run msteams#relay"
  },
  "devDependencies": {
    "@types/relay-runtime": "^18.2.1",
    "eslint": "9.16.0",
    "eslint-plugin-turbo": "^2.3.3",
    "next": "15.1.0",
    "global": "^4.4.0",
    "turbo": "^2.3.3"
  }
}
