{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "All in one",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/all-in-one/AllInOne/bin/Debug/net9.0/AllInOne.dll",
      "cwd": "${workspaceFolder}/src/all-in-one/AllInOne/bin/Debug/net9.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "All Infra",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/all-in-one/AllInfra/bin/Debug/net9.0/AllInfra.dll",
      "cwd": "${workspaceFolder}/src/all-in-one/AllInfra/bin/Debug/net9.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "All Apis",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/all-in-one/AllApis/bin/Debug/net9.0/AllApis.dll",
      "cwd": "${workspaceFolder}/src/all-in-one/AllApis/bin/Debug/net9.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "All Processors",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/all-in-one/AllProcessors/bin/Debug/net9.0/AllProcessors.dll",
      "cwd": "${workspaceFolder}/src/all-in-one/AllProcessors/bin/Debug/net9.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "All Jobs",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/all-in-one/AllJobs/bin/Debug/net9.0/AllJobs.dll",
      "cwd": "${workspaceFolder}/src/all-in-one/AllJobs/bin/Debug/net9.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Webapp - debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/src/web/apps/webapp",
      "envFile": "${workspaceFolder}/src/web/apps/webapp/.env"
    },
    {
      "name": "Webapp - debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:15000",
      "cwd": "${workspaceFolder}/src/web/apps/webapp",
      "port": 9876,
      "env": {
        "NEXTAUTH_SECRET": "XXXX",
        "PORT": "15000"
      }
    },
    {
      "name": "Webapp - debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "cwd": "${workspaceFolder}/src/web/apps/webapp",
      "envFile": "${workspaceFolder}/src/web/apps/webapp/.env"
    }
  ]
}
