      "cwd": "${workspaceFolder}/msteams/MsTeamsAllInOne/bin/Debug/net8.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
