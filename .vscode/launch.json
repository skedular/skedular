{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "All in one",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/all-in-one/AllInOne/bin/Debug/net8.0/AllInOne.dll",
      "cwd": "${workspaceFolder}/all-in-one/AllInOne/bin/Debug/net8.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Webapp - debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/web/apps/webapp",
      "envFile": "${workspaceFolder}/web/apps/webapp/.env",
      "env": {
        "PORT": "15000"
      }
    },
    {
      "name": "Webapp - debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:15002",
      "cwd": "${workspaceFolder}/web/apps/webapp",
      "env": {
        "NEXTAUTH_SECRET": "XXXX",
        "PORT": "15000"
      }
    },
    {
      "name": "Webapp - debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "cwd": "${workspaceFolder}/web/apps/webapp",
      "envFile": "${workspaceFolder}/web/apps/webapp/.env",
      "env": {
        "PORT": "15000"
      }
    }
  ]
}
