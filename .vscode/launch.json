  "version": "0.2.0",
  "configurations": [
    {
      "name": "All in one",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/all-in-one/AllInOne/bin/Debug/net8.0/AllInOne.dll",
      "cwd": "${workspaceFolder}/all-in-one/AllInOne/bin/Debug/net8.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "MsTeams - All in one",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-msteams",
