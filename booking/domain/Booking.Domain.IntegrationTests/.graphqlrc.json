{
  "schema": "schema.graphql",
  "documents": "**/*.graphql",
  "extensions": {
    "strawberryShake": {
      "name": "SkedularGraphQlBookingClientV1",
      "namespace": "Booking.Domain.IntegrationTests.Clients.GraphQL.V1",
      "url": "http://localhost:10300/v1/graphql/",
      "records": {
        "inputs": false,
        "entities": false
      },
      "transportProfiles": [
        {
          "default": "Http",
          "subscription": "WebSocket"
        }
      ]
    }
  }
}
