{
  "Application": {
    "Environment": "local",
    "Domain": "Booking",
    "DomainSource": "urn::skedular::booking",
    "AppSource": "booking-domain-integrationtests"
  },
  "Kafka": {
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "UseSchemaRegistry": true,
    "SchemaRegistry": {
      "Url": "",
      "AutoRegisterSchema": false,
      "UseLatestVersion": false
    }
  },
  "Email": {
    "BookingInvoiceEmailSender": "Skedular <no-reply@staging.skedular.app>"
  }
}
