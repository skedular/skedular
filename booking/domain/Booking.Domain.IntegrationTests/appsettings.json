{
  "Application": {
    "Environment": "local",
    "Domain": "Booking",
    "DomainSource": "urn::skedular::booking",
    "AppSource": "booking-domain-integrationtests"
  },
  "Kafka": {
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "UseSchemaRegistry": true,
    "SchemaRegistry": {
      "Url": "",
      "AutoRegisterSchema": false,
      "UseLatestVersion": false
    }
  },
  "Email": {
    "BookingInvoiceEmailSender": "Skedular <no-reply@staging.skedular.app>"
  },
  "Core": {
    "ApiKey": "integration-test-core-api-key",
    "GrpcUrl": "http://localhost"
  },
  "Organization": {
    "ApiKey": "integration-test-organization-api-key",
    "GrpcUrl": "http://localhost"
  },
  "Xero": {
    "ClientId": "integration-test-client-id",
    "ClientSecret": "integration-test-client-secret",
    "AuthorizeEndpoint": "https://example.test/xero/authorize",
    "TokenEndpoint": "https://example.test/xero/token",
    "WebhookKey": "integration-test-webhook-key",
    "LogWebhookMessages": false,
    "Scopes": "offline_access accounting.transactions accounting.contacts",
    "RefreshBeforeExpiryDays": 1,
    "EncryptionKey": {
      "Key": "0123456789abcdef0123456789abcdef",
      "Iv": "0123456789abcdef"
    }
  }
}
