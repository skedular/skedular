{
  "stryker-config": {
    "reporters": ["html", "cleartext", "cleartexttree", "dots", "json"],
    "additional-timeout": 10000,
    "project": "Booking.Processors.csproj",
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "mutation-level": "Complete",
    "ignore-methods": ["*.Log*"],
    "ignore-mutations": ["string"],
    "mutate": ["!Startup.cs", "!Program.cs", "!**/*.g.cs", "!**/*Migrations/*", "!**/Repositories/*", "!**/Database/*"]
  }
}
