schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

type Query {
  marketplaceBookingRefundPreview(bookingId: String!): MarketplaceRefundPreviewDetails!
    @cost(weight: "10")
  marketplaceBookingSubscriptionRefundPreview(subscriptionId: String!): MarketplaceRefundPreviewDetails!
    @cost(weight: "10")
  marketplaceRefund(id: String!): MarketplaceRefundDetails @cost(weight: "10")
  marketplaceRefunds(organizationCustomDomain: String!, statuses: [String!]): [MarketplaceRefundDetails!]!
    @cost(weight: "10")
  marketplaceRefundStatuses: [MarketplaceRefundStatusDetails!]!
  bookingCategories: [BookingCategoryDetails!]!
  marketplaceBookingCategories: [BookingCategoryDetails!]!
  booking(id: String!): BookingDetails @cost(weight: "10")
  bookingById(id: ID!): BookingDetails @lookup @internal @cost(weight: "10")
  bookings(
    after: String
    first: Int
    before: String
    last: Int
    where: BookingWhereInput!
    orderBy: [BookingOrderInput!]
  ): ConnectionOfBookingEdge! @cost(weight: "10")
  allBookings(where: BookingWhereInput!): [BookingDetails!]! @cost(weight: "10")
  marketplaceBookingSubscriptionCancellationModes: [MarketplaceBookingSubscriptionCancellationModeDetails!]!
  marketplaceBookingSubscriptionStatuses: [MarketplaceBookingSubscriptionStatusDetails!]!
  marketplaceBookingPaymentStatuses: [MarketplaceBookingPaymentStatusDetails!]!
  marketplaceBookingSubscription(id: String!): MarketplaceBookingSubscriptionDetails
    @cost(weight: "10")
  marketplaceBookingSubscriptionById(id: ID!): MarketplaceBookingSubscriptionDetails
    @lookup
    @internal
    @cost(weight: "10")
  marketplaceBookingSubscriptions(
    after: String
    first: Int
    before: String
    last: Int
    where: MarketplaceBookingSubscriptionWhereInput!
    orderBy: [MarketplaceBookingSubscriptionOrderInput!]
  ): ConnectionOfMarketplaceBookingSubscriptionEdge! @cost(weight: "10")
  allMarketplaceBookingSubscriptions(
    where: MarketplaceBookingSubscriptionWhereInput!
  ): [MarketplaceBookingSubscriptionDetails!]! @cost(weight: "10")
  paymentMethodTypes: [PaymentMethodTypeDetails!]!
  paymentStatuses: [PaymentStatusDetails!]!
  organizationBookingPermissions(
    organizationId: String
    organizationCustomDomain: String
  ): OrganizationBookingPermissions! @cost(weight: "10")
  teamBookingPermissions(teamId: String!): TeamBookingPermissions!
    @cost(weight: "10")
  recurringBooking(id: String!): RecurringBookingDetails @cost(weight: "10")
  recurringBookingById(id: ID!): RecurringBookingDetails
    @lookup
    @internal
    @cost(weight: "10")
  recurringBookings(
    after: String
    first: Int
    before: String
    last: Int
    where: RecurringBookingWhereInput!
    orderBy: [RecurringBookingOrderInput!]
  ): ConnectionOfRecurringBookingEdge! @cost(weight: "10")
  allRecurringBookings(where: RecurringBookingWhereInput!): [RecurringBookingDetails!]!
    @cost(weight: "10")
  resourceAvailabilityStatuses: [ResourceAvailabilityClassificationDetails!]!
  resourceDayViews(
    filter: ResourceAvailabilityFilterInput!
    orderBy: [ResourceAvailabilityOrderByInput!]!
  ): ResourceDayViewConnection! @cost(weight: "10")
  availableResources(where: AvailableResourcesWhereInput!): [BookingResourceDetails!]!
    @cost(weight: "10")
  availableResourcesCount(where: AvailableResourcesCountWhereInput!): Int!
    @cost(weight: "10")
  organizationResourcesAvailability(
    where: OrganizationAvailableResourcesWhereInput!
  ): OrganizationAvailableResources! @cost(weight: "10")
  bookingVersion: Version!
}

type Mutation {
  markMarketplaceRefundPendingAccounting(
    input: MarkMarketplaceRefundPendingAccountingInput!
  ): MarketplaceRefundPayload! @cost(weight: "10")
  completeMarketplaceRefund(input: CompleteMarketplaceRefundInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  markMarketplaceRefundManualRequired(
    input: MarkMarketplaceRefundManualRequiredInput!
  ): MarketplaceRefundPayload! @cost(weight: "10")
  markMarketplaceRefundManualCompleted(
    input: MarkMarketplaceRefundManualCompletedInput!
  ): MarketplaceRefundPayload! @cost(weight: "10")
  failMarketplaceRefund(input: FailMarketplaceRefundInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  processMarketplaceRefundInXero(input: ProcessMarketplaceRefundInXeroInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  addPrivateBooking(input: AddPrivateBookingInput!): BookingPayload!
    @cost(weight: "10")
  updatePrivateBooking(input: UpdatePrivateBookingInput!): BookingPayload!
    @cost(weight: "10")
  deletePrivateBooking(input: DeletePrivateBookingInput!): BookingPayload!
    @cost(weight: "10")
  addMarketplaceBooking(input: AddMarketplaceBookingInput!): BookingPayload!
    @cost(weight: "10")
  updateMarketplaceBooking(input: UpdateMarketplaceBookingInput!): BookingPayload!
    @cost(weight: "10")
  deleteMarketplaceBooking(input: DeleteMarketplaceBookingInput!): BookingPayload!
    @cost(weight: "10")
  addMarketplaceBookingSubscription(
    input: AddMarketplaceBookingSubscriptionInput!
  ): MarketplaceBookingSubscriptionPayload! @cost(weight: "10")
  deleteMarketplaceBookingSubscription(
    input: DeleteMarketplaceBookingSubscriptionInput!
  ): MarketplaceBookingSubscriptionPayload! @cost(weight: "10")
  confirmBookingPayment(input: ConfirmBookingPaymentInput!): BookingPayload!
    @cost(weight: "10")
  rejectBookingPayment(input: RejectBookingPaymentInput!): BookingPayload!
    @cost(weight: "10")
  makeBookingPaymentNotRequired(input: MakeBookingPaymentNotRequiredInput!): BookingPayload!
    @cost(weight: "10")
  confirmRecurringBookingPayment(input: ConfirmRecurringBookingPaymentInput!): RecurringBookingPayload!
    @cost(weight: "10")
  rejectRecurringBookingPayment(input: RejectRecurringBookingPaymentInput!): RecurringBookingPayload!
    @cost(weight: "10")
  makeRecurringBookingPaymentNotRequired(
    input: MakeRecurringBookingPaymentNotRequiredInput!
  ): RecurringBookingPayload! @cost(weight: "10")
  addPrivateRecurringBooking(input: AddPrivateRecurringBookingInput!): RecurringBookingPayload!
    @cost(weight: "10")
  updatePrivateRecurringBooking(input: UpdatePrivateRecurringBookingInput!): RecurringBookingPayload!
    @cost(weight: "10")
  deletePrivateRecurringBooking(input: DeletePrivateRecurringBookingInput!): RecurringBookingPayload!
    @cost(weight: "10")
}

type Subscription {
  booking(id: String!): BookingDetails!
  marketplaceBookingSubscription(id: String!): MarketplaceBookingSubscriptionDetails!
  resourceAvailability(
    subscriptionKey: String!
    filter: ResourceAvailabilityFilterInput!
  ): ResourceDayViewConnection!
}

type Booking_LocationDetails {
  uniqueId: String!
  name: String!
}

type BookingCategoryDetails {
  category: BookingCategory!
  name: String!
}

type BookingChannelDetails {
  channel: BookingChannel!
  name: String!
}

type BookingCheckoutSessionDetails {
  uniqueId: String!
  checkoutUrl: String!
}

type BookingDetails {
  involvedCustomers: [CustomerDetails!]!
  createdByCustomer: CustomerDetails
  lastModifiedByCustomer: CustomerDetails
  deletedByCustomer: CustomerDetails
  involvedOrganizations: [OrganizationDetails!]!
  involvedTeams: [TeamDetails!]!
  arrearsInvoices: [OrganizationArrearsInvoiceDetails!]! @cost(weight: "10")
  from: DateTime!
  until: DateTime!
  notes: String
  category: BookingCategoryDetails!
  channel: BookingChannelDetails!
  bookingResources: [BookingResourceDetails!]!
  involvedLocations: [Booking_LocationDetails!]!
  recurringBooking: RecurringBookingDetails
  marketplaceBooking: MarketplaceBookingDetails
  hasRecurringInstanceOverrides: Boolean
  id: ID!
}

type BookingEdge {
  node: BookingDetails!
  cursor: String!
}

type BookingFrequencyDetails {
  frequency: BookingFrequency!
  name: String!
}

type BookingPayload {
  clientMutationId: String
  booking: BookingDetails!
}

type BookingRecurrenceEndTypeDetails {
  endType: RecurringBookingEndType!
  name: String!
}

type BookingResourceDetails {
  customers: [CustomerDetails!]!
  resource: ResourceDetails!
  location: Booking_LocationDetails
}

type BookingWindowDetails {
  bookingId: String!
  from: DateTime!
  until: DateTime!
  isRecurring: Boolean!
  isCheckedIn: Boolean!
  bookedByName: String
  bookedByUserId: String
  notes: String
}

type ConnectionOfBookingEdge {
  pageInfo: PageInfo!
  edges: [BookingEdge!]!
  totalCount: Int!
}

type ConnectionOfMarketplaceBookingSubscriptionEdge {
  pageInfo: PageInfo!
  edges: [MarketplaceBookingSubscriptionEdge!]!
  totalCount: Int!
}

type ConnectionOfRecurringBookingEdge {
  pageInfo: PageInfo!
  edges: [RecurringBookingEdge!]!
  totalCount: Int!
}

type CurrencyDetails @shareable {
  type: Currency!
  name: String!
}

type CustomerDetails @key(fields: "id") {
  id: ID!
}

type DayOfWeekDetails {
  dayOfWeek: DayOfWeek!
  name: String!
}

type ListingMetadata @shareable {
  about: String
  title: String
  subTitle: String
  includedFeatures: [String!]
}

type MarketplaceBookingDetails {
  paidByCustomer: CustomerDetails
  paidByOrganization: OrganizationDetails
  productVersion: ProductVersionDetails!
  refund: MarketplaceRefundDetails @cost(weight: "10")
  quantity: Int!
  productPricing: ProductPricing!
  paymentMethod: PaymentMethodTypeDetails!
  totalAmountExcludeTax: Decimal
  totalAmountExcludeTaxToDisplay: String!
  taxAmount: Decimal
  taxAmountToDisplay: String!
  taxRatePercentage: Decimal
  taxRatePercentageToDisplay: String!
  totalAmount: Decimal
  totalAmountToDisplay: String!
  currency: CurrencyDetails
  currencyToDisplay: String!
  invoiceUrl: String
  invoiceNumber: String
  invoiceEmailList: [String!]!
  billingMode: ProductPricingBillingMode!
  isPaymentRequired: Boolean!
  bookingCheckoutSession: BookingCheckoutSessionDetails
  paymentExpiry: DateTime!
  paymentStatus: PaymentStatusDetails!
  id: ID!
}

type MarketplaceBookingPaymentStatusDetails {
  type: PaymentStatus!
  name: String!
}

type MarketplaceBookingSubscriptionCancellationModeDetails {
  type: MarketplaceBookingSubscriptionCancellationMode!
  name: String!
}

type MarketplaceBookingSubscriptionDetails {
  involvedCustomers: [CustomerDetails!]!
  createdByCustomer: CustomerDetails
  lastModifiedByCustomer: CustomerDetails
  deletedByCustomer: CustomerDetails
  involvedOrganizations: [OrganizationDetails!]!
  involvedTeams: [TeamDetails!]!
  refund: MarketplaceRefundDetails @cost(weight: "10")
  arrearsInvoices: [OrganizationArrearsInvoiceDetails!]! @cost(weight: "10")
  startedAt: DateTime!
  cancelledAt: DateTime
  nextRenewalAt: DateTime
  status: MarketplaceBookingSubscriptionStatusDetails!
  autoRenew: Boolean!
  cancelAtPeriodEnd: Boolean!
  marketplaceBooking: MarketplaceBookingDetails!
  recurringBookings: [RecurringBookingDetails!]!
  id: ID!
}

type MarketplaceBookingSubscriptionEdge {
  node: MarketplaceBookingSubscriptionDetails!
  cursor: String!
}

type MarketplaceBookingSubscriptionPayload {
  clientMutationId: String
  marketplaceBookingSubscription: MarketplaceBookingSubscriptionDetails!
}

type MarketplaceBookingSubscriptionStatusDetails {
  type: MarketplaceBookingSubscriptionStatus!
  name: String!
}

type MarketplaceRefundDetails {
  id: String!
  localEntityType: String!
  localEntityId: String!
  status: MarketplaceRefundStatusDetails!
  requestedAt: DateTime!
  referenceTime: DateTime!
  refundPercentage: Int!
  appliedRuleMinutesBefore: Int
  baseAmount: Decimal
  refundAmount: Decimal
  currency: CurrencyDetails
  currencyToDisplay: String!
  reason: String
  accountingProvider: String
  externalRefundId: String
  externalRefundNumber: String
  lastProcessedAt: DateTime
  lastError: String
  canProcessInXero: Boolean!
  events: [MarketplaceRefundEventDetails!]!
  requestedByCustomerId: String
  requestedByCustomerName: String
  xeroProcessingBlockedReason: String
}

type MarketplaceRefundEventDetails {
  id: String!
  eventType: MarketplaceRefundEventTypeDetails!
  occurredAt: DateTime!
  refundAmount: Decimal
  currencyToDisplay: String!
  reason: String
  accountingProvider: String
  externalRefundId: String
  externalRefundNumber: String
  lastError: String
  actorCustomerId: String
  actorName: String
}

type MarketplaceRefundEventTypeDetails {
  type: String!
  name: String!
}

type MarketplaceRefundPayload {
  clientMutationId: String
  marketplaceRefund: MarketplaceRefundDetails!
}

type MarketplaceRefundPreviewDetails {
  localEntityType: String!
  localEntityId: String!
  requestedAt: DateTime!
  referenceTime: DateTime!
  isRefundable: Boolean!
  refundPercentage: Int!
  appliedRuleMinutesBefore: Int
  baseAmount: Decimal
  refundAmount: Decimal
  currency: CurrencyDetails
  currencyToDisplay: String!
}

type MarketplaceRefundStatusDetails {
  type: String!
  name: String!
}

type OrganizationArrearsInvoiceDetails {
  invoiceNumber: String!
  invoiceUrl: String!
  billingPeriodStartInclusive: DateTime!
  billingPeriodEndExclusive: DateTime!
  currency: String!
  totalAmount: Decimal!
  totalAmountToDisplay: String!
  createdAt: DateTime!
}

type OrganizationAvailableResources {
  resourcesCount: Int!
  availableResourcesCount: Int!
}

type OrganizationBookingPermissions {
  canViewBookings: Boolean!
  canAddBooking: Boolean!
  canUpdateBooking: Boolean!
  canDeleteBooking: Boolean!
  canModifyPaymentMethod: Boolean!
}

type OrganizationDetails @key(fields: "id") @shareable {
  customDomain: String
  id: ID!
}

type OrganizationTagDetails @key(fields: "id") @shareable {
  name: String!
  type: OrganizationTagType
  color: String
  id: ID!
}

type PageInfo @shareable {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type PaymentMethodTypeDetails @shareable {
  type: PaymentMethod!
  name: String!
}

type PaymentStatusDetails {
  type: PaymentStatus!
  name: String!
}

type ProductPricing @shareable {
  id: String!
  index: Int!
  listingMetadata: ListingMetadata!
  purchaseCadence: ProductPricingCadence!
  bookingCadence: ProductPricingCadence!
  price: Decimal!
  isTaxInclusive: Boolean!
  supportsSubscriptionAutoRenewal: Boolean!
  acceptedPaymentMethods: [PaymentMethod!]!
  billingMode: ProductPricingBillingMode!
  minDurationMinutes: Int
  maxDurationMinutes: Int
  maxAllowedResourcesLockTimePaidViaCard: Int!
  maxAllowedResourcesLockTimePaidViaBankTransfer: Int!
  numberOfResourcesToBook: Int!
  cancellationPolicyType: ProductPricingCancellationPolicyType!
  cancellationRefundRules: [ProductPricingCancellationRefundRule!]!
}

type ProductPricingCancellationRefundRule @shareable {
  minutesBefore: Int!
  refundPercentage: Int!
}

type ProductVersionDetails @key(fields: "id") {
  id: ID!
}

type RecurringBookingDetails {
  involvedCustomers: [CustomerDetails!]!
  createdByCustomer: CustomerDetails
  lastModifiedByCustomer: CustomerDetails
  deletedByCustomer: CustomerDetails
  involvedOrganizations: [OrganizationDetails!]!
  involvedTeams: [TeamDetails!]!
  from: DateTime!
  until: DateTime!
  category: BookingCategoryDetails!
  channel: BookingChannelDetails!
  frequency: BookingFrequencyDetails!
  interval: Int!
  byMonthDay: Int
  bySetPosition: Int
  byWeekDays: [DayOfWeekDetails!]!
  endType: BookingRecurrenceEndTypeDetails!
  startDate: DateTime!
  endDate: DateTime
  occurrenceCount: Int
  skippedDates: [DateTime!]!
  requestedResources: [ResourceDetails!]!
  marketplaceBooking: MarketplaceBookingDetails
  id: ID!
}

type RecurringBookingEdge {
  node: RecurringBookingDetails!
  cursor: String!
}

type RecurringBookingPayload {
  clientMutationId: String
  recurringBooking: RecurringBookingDetails!
}

type ResourceAvailabilityClassificationDetails {
  type: ResourceAvailabilityClassification!
  name: String!
}

type ResourceDayViewConnection {
  items: [ResourceDayViewDetails!]!
  subscriptionKey: String!
}

type ResourceDayViewDetails {
  resourceId: String!
  resourceName: String!
  resourceType: String!
  locationId: String!
  locationName: String!
  floorId: String
  floorName: String
  zoneId: String
  zoneName: String
  date: LocalDate!
  status: ResourceAvailabilityClassification!
  openingFrom: LocalTime
  openingUntil: LocalTime
  totalOpeningMinutes: Int!
  bookedMinutes: Int!
  bookingWindows: [BookingWindowDetails!]!
}

type ResourceDetails @key(fields: "id") @shareable {
  name: String!
  inactive: Boolean!
  requireBookingApproval: Boolean!
  color: String
  capacity: Int!
  isAvailableHoursOverridden: Boolean!
  customTags: [OrganizationTagDetails!]!
  zones: [OrganizationTagDetails!]!
  productTags: [OrganizationTagDetails!]!
  resourceType: OrganizationTagDetails!
  id: ID!
}

type TeamBookingPermissions {
  canAddBooking: Boolean!
  canUpdateBooking: Boolean!
  canDeleteBooking: Boolean!
}

type TeamDetails @key(fields: "id") {
  id: ID!
}

type Version @shareable {
  major: Int!
  minor: Int!
  build: Int!
  revision: Int!
}

input AddMarketplaceBookingInput {
  clientMutationId: String
  id: String
  customerIds: [String!]!
  organizationIds: [String!]
  organizationCustomDomains: [String!]
  teamIds: [String!]
  from: DateTime!
  until: DateTime!
  notes: String
  category: BookingCategory
  resourceIds: [String!]
  paymentMethod: PaymentMethod!
  invoiceEmailList: [String!]
  quantity: Int!
  productVersionId: String!
  pricingId: String!
  checkoutReturnUrl: String
}

input AddMarketplaceBookingSubscriptionInput {
  clientMutationId: String
  id: String
  customerIds: [String!]!
  organizationIds: [String!]
  organizationCustomDomains: [String!]
  teamIds: [String!]
  requestedResourceIds: [String!]
  startedAt: DateTime!
  autoRenew: Boolean!
  cancelAtPeriodEnd: Boolean!
  paymentMethod: PaymentMethod!
  invoiceEmailList: [String!]
  quantity: Int!
  productVersionId: String!
  pricingId: String!
  checkoutReturnUrl: String
}

input AddPrivateBookingInput {
  clientMutationId: String
  id: String
  customerIds: [String!]!
  organizationIds: [String!]
  organizationCustomDomains: [String!]
  teamIds: [String!]
  from: DateTime!
  until: DateTime!
  notes: String
  category: BookingCategory
  resourceIds: [String!]
}

input AddPrivateRecurringBookingInput {
  clientMutationId: String
  id: String
  customerIds: [String!]!
  organizationIds: [String!]
  organizationCustomDomains: [String!]
  teamIds: [String!]
  requestedResourceIds: [String!]
  from: DateTime!
  until: DateTime!
  frequency: BookingFrequency!
  interval: Int!
  byMonthDay: Int
  bySetPosition: Int
  byWeekDays: [DayOfWeek!]!
  endType: RecurringBookingEndType!
  startDate: DateTime!
  endDate: DateTime
  occurrenceCount: Int
  skippedDates: [DateTime!]
  category: BookingCategory
}

input AvailableResourcesCountWhereInput {
  organizationId: String
  organizationCustomDomain: String
  locationId: String
  requestedResourceIds: [String!]
  from: DateTime!
  until: DateTime!
  customTagIds: [String!]
  zoneIds: [String!]
  productId: String
}

input AvailableResourcesWhereInput {
  organizationId: String
  organizationCustomDomain: String
  locationId: String
  from: DateTime!
  until: DateTime!
  customTagIds: [String!]
  zoneIds: [String!]
  resourceIdsToInclude: [String!]
  productId: String
}

input BookingOrderInput {
  direction: OrderDirection!
  field: BookingOrderField!
}

input BookingWhereInput {
  fromGt: DateTime
  fromGte: DateTime
  fromLt: DateTime
  fromLte: DateTime
  toGt: DateTime
  toGte: DateTime
  toLt: DateTime
  toLte: DateTime
  notesContains: String
  category: BookingCategory
  channel: BookingChannel
  paymentStatuses: [PaymentStatus!]
  nameContains: String
  organizationId: String
  organizationCustomDomain: String
  locationIds: [String!]
  teamIds: [String!]
  customerIds: [String!]
  recurringBookingIds: [String!]
  includeMineOnly: Boolean
  includeFutureBookingsOnly: Boolean
}

input CompleteMarketplaceRefundInput {
  id: String!
  reason: String
  clientMutationId: String
}

input ConfirmBookingPaymentInput {
  clientMutationId: String
  id: String!
}

input ConfirmRecurringBookingPaymentInput {
  id: String!
  clientMutationId: String
}

input DeleteMarketplaceBookingInput {
  clientMutationId: String
  id: String!
}

input DeleteMarketplaceBookingSubscriptionInput {
  clientMutationId: String
  id: String!
  cancellationMode: MarketplaceBookingSubscriptionCancellationMode!
}

input DeletePrivateBookingInput {
  clientMutationId: String
  id: String!
}

input DeletePrivateRecurringBookingInput {
  clientMutationId: String
  id: String!
}

input FailMarketplaceRefundInput {
  id: String!
  reason: String
  clientMutationId: String
}

input MakeBookingPaymentNotRequiredInput {
  clientMutationId: String
  id: String!
}

input MakeRecurringBookingPaymentNotRequiredInput {
  id: String!
  clientMutationId: String
}

input MarketplaceBookingSubscriptionOrderInput {
  direction: OrderDirection!
  field: MarketplaceBookingSubscriptionOrderField!
}

input MarketplaceBookingSubscriptionWhereInput {
  startedAtGt: DateTime
  startedAtGte: DateTime
  startedAtLt: DateTime
  startedAtLte: DateTime
  cancelledAtGt: DateTime
  cancelledAtGte: DateTime
  cancelledAtLt: DateTime
  cancelledAtLte: DateTime
  nextRenewalAtGt: DateTime
  nextRenewalAtGte: DateTime
  nextRenewalAtLt: DateTime
  nextRenewalAtLte: DateTime
  status: MarketplaceBookingSubscriptionStatus
  statuses: [MarketplaceBookingSubscriptionStatus!]
  paymentStatuses: [PaymentStatus!]
  nameContains: String
  organizationId: String
  organizationCustomDomain: String
  teamIds: [String!]
  customerIds: [String!]
  includeMineOnly: Boolean
}

input MarkMarketplaceRefundManualCompletedInput {
  clientMutationId: String
  id: String!
  reason: String
}

input MarkMarketplaceRefundManualRequiredInput {
  clientMutationId: String
  id: String!
  reason: String
}

input MarkMarketplaceRefundPendingAccountingInput {
  id: String!
  refundAmount: Decimal
  reason: String
  clientMutationId: String
}

input OrganizationAvailableResourcesWhereInput {
  organizationId: String
  organizationCustomDomain: String
  from: DateTime!
  until: DateTime!
}

input ProcessMarketplaceRefundInXeroInput {
  id: String!
  clientMutationId: String
}

input RecurringBookingOrderInput {
  direction: OrderDirection!
  field: RecurringBookingOrderField!
}

input RecurringBookingWhereInput {
  fromGt: DateTime
  fromGte: DateTime
  fromLt: DateTime
  fromLte: DateTime
  toGt: DateTime
  toGte: DateTime
  toLt: DateTime
  toLte: DateTime
  category: BookingCategory
  channel: BookingChannel
  nameContains: String
  organizationId: String
  organizationCustomDomain: String
  teamIds: [String!]
  customerIds: [String!]
  includeMineOnly: Boolean
  includeFutureBookingsOnly: Boolean
}

input RejectBookingPaymentInput {
  clientMutationId: String
  id: String!
}

input RejectRecurringBookingPaymentInput {
  id: String!
  clientMutationId: String
}

input ResourceAvailabilityFilterInput {
  date: LocalDate!
  organizationCustomDomain: String!
  locationIds: [String!]!
  floorId: String
  zoneId: String
  resourceType: String
  statuses: [ResourceAvailabilityClassification!]!
}

input ResourceAvailabilityOrderByInput {
  direction: OrderDirection!
  field: ResourceAvailabilityOrderByField!
}

input UpdateMarketplaceBookingInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [MarketplaceBookingPatchField!]!
  customerIds: [String!]!
  organizationIds: [String!]
  organizationCustomDomains: [String!]
  teamIds: [String!]
  notes: String
  category: BookingCategory
}

input UpdatePrivateBookingInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [PrivateBookingPatchField!]!
  customerIds: [String!]!
  organizationIds: [String!]
  organizationCustomDomains: [String!]
  teamIds: [String!]
  from: DateTime!
  until: DateTime!
  notes: String
  category: BookingCategory
  resourceIds: [String!]
}

input UpdatePrivateRecurringBookingInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [PrivateRecurringBookingPatchField!]!
  customerIds: [String!]!
  organizationIds: [String!]
  organizationCustomDomains: [String!]
  teamIds: [String!]
  requestedResourceIds: [String!]
  from: DateTime!
  until: DateTime!
  frequency: BookingFrequency!
  interval: Int!
  byMonthDay: Int
  bySetPosition: Int
  byWeekDays: [DayOfWeek!]!
  endType: RecurringBookingEndType!
  startDate: DateTime!
  endDate: DateTime
  occurrenceCount: Int
  skippedDates: [DateTime!]
  category: BookingCategory
}

