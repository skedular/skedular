<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/unityhubio/unityhubio</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GitRepositoryRoot>$(SolutionDir)</GitRepositoryRoot>
        <WriteVersionInfoToBuildLog>true</WriteVersionInfoToBuildLog>
        <UseFullSemVerForNuGet>true</UseFullSemVerForNuGet>
        <UpdateVersionProperties>true</UpdateVersionProperties>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Build Tools -->
        <PackageReference Include="GitVersion.MsBuild" Version="6.7.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Test Framework -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1"/>

        <!-- GraphQL Testing (StrawberryShake) -->
        <PackageReference Include="StrawberryShake.Server" Version="16.0.0"/>

        <!-- Code Coverage -->
        <PackageReference Include="coverlet.collector" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Skedular.AppHost/Skedular.AppHost.csproj"/>

        <ProjectReference Include="../../booking/shared/Booking.Shared/Booking.Shared.csproj"/>
        <ProjectReference Include="../../core/shared/Core.Shared/Core.Shared.csproj"/>
        <ProjectReference Include="../../customer/shared/Customer.Shared/Customer.Shared.csproj"/>
        <ProjectReference Include="../../location/shared/Location.Shared/Location.Shared.csproj"/>
        <ProjectReference Include="../../marketplace/shared/Marketplace.Shared/Marketplace.Shared.csproj"/>
        <ProjectReference Include="../../msteams/shared/MsTeams.Shared/MsTeams.Shared.csproj"/>
        <ProjectReference Include="../../organization/shared/Organization.Shared/Organization.Shared.csproj"/>
        <ProjectReference Include="../../shared/Api.Shared.Clients/Api.Shared.Clients.csproj"/>
        <ProjectReference Include="../../shared/Testing.Shared.IntegrationTests/Testing.Shared.IntegrationTests.csproj"/>
        <ProjectReference Include="../../slack/shared/Slack.Shared/Slack.Shared.csproj"/>
        <ProjectReference Include="../../team/shared/Team.Shared/Team.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json"/>
    </ItemGroup>

    <ItemGroup>
        <GraphQL Update="schema.extensions.graphql">
            <Generator>MSBuild:GenerateGraphQLCode</Generator>
        </GraphQL>
        <GraphQL Update="schema.graphql">
            <Generator>MSBuild:GenerateGraphQLCode</Generator>
        </GraphQL>
        <GraphQL Update="Gateway/GraphQl/GetVersion.graphql">
            <Generator>MSBuild:GenerateGraphQLCode</Generator>
        </GraphQL>
    </ItemGroup>
</Project>