{
  "Application": {
    "Environment": "local",
    "Domain": "Team",
    "DomainSource": "urn::skedular::team",
    "AppSource": "team-domain-integrationtests"
  },
  "Kafka": {
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "UseSchemaRegistry": true,
    "SchemaRegistry": {
      "Url": "",
      "AutoRegisterSchema": false,
      "UseLatestVersion": false
    }
  },
  "Email": {
    "NewTeamFeedbackSubmittedEmailReceivers": [],
    "NewTeamFeedbackSubmittedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "NewTeamJoinedEmailReceivers": [],
    "NewTeamJoinedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "EnableNewTeamJoinedEmail": false
  }
}
