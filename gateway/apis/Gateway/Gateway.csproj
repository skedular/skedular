<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HotChocolate.Stitching" Version="13.9.14"/>
        <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="schemas\Billing.graphql" />
        <EmbeddedResource Include="schemas\Booking.graphql" />
        <EmbeddedResource Include="schemas\Customer.graphql" />
        <EmbeddedResource Include="schemas\Location.graphql" />
        <EmbeddedResource Include="schemas\MsTeams.graphql" />
        <EmbeddedResource Include="schemas\Notification.graphql" />
        <EmbeddedResource Include="schemas\Organization.graphql" />
        <EmbeddedResource Include="schemas\Payment.graphql" />
        <EmbeddedResource Include="schemas\Slack.graphql" />
        <EmbeddedResource Include="schemas\Team.graphql" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\shared\Api.Shared.Services\Api.Shared.Services.csproj"/>
        <ProjectReference Include="..\..\..\shared\Enterprise.Shared\Enterprise.Shared.csproj"/>
    </ItemGroup>

</Project>
