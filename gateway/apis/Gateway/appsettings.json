{
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://0.0.0.0:9000",
        "Protocols": "Http1AndHttp2AndHttp3"
      },
      "https": {
        "Url": "http://0.0.0.0:9001",
        "Protocols": "Http1AndHttp2AndHttp3"
      }
    }
  },
  "Application": {
    "Environment": "local",
    "Domain": "Gateway",
    "DomainSource": "urn::unityhub::gateway",
    "AppSource": "gateway",
    "EnableSchemaRegistry": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "ConsoleEnabled": false,
    "ZipkinEnabled": false,
    "ZipkinEndpoint": "http://localhost:9411/api/v2/spans",
    "JaegerEnabled": false,
    "JaegerEndpoint": "http://localhost:14268/api/traces",
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://localhost:4317",
    "MetricsIngestEnabled": false,
    "EntityFrameworkEnabled": false
  },
  "ConnectionStrings": {
    "RedisConnection": "localhost:6379,abortConnect=false"
  },
  "Graphql": {
    "Path": "/gateway/api/v1/graphql",
    "ClientEnabled": true,
    "IntrospectionEnabled": true
  },
  "Subgraphs": {
    "Billing": {
      "Uri": "http://localhost:10800/billing/api/v1/graphql"
    },
    "Booking": {
      "Uri": "http://localhost:10300/booking/api/v1/graphql"
    },
    "Customer": {
      "Uri": "http://localhost:10000/customer/api/v1/graphql"
    },
    "Location": {
      "Uri": "http://localhost:10600/location/api/v1/graphql"
    },
    "MsTeams": {
      "Uri": "http://localhost:10900/msteams/api/v1/graphql"
    },
    "Notification": {
      "Uri": "http://localhost:10400/notification/api/v1/graphql"
    },
    "Organization": {
      "Uri": "http://localhost:10200/organization/api/v1/graphql"
    },
    "Payment": {
      "Uri": "http://localhost:10100/payment/api/v1/graphql"
    },
    "Slack": {
      "Uri": "http://localhost:10700/slack/api/v1/graphql"
    },
    "Team": {
      "Uri": "http://localhost:10500/team/api/v1/graphql"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "billing": {
        "ClusterId": "billing",
        "Match": {
          "Path": "billing/{**catch-all}"
        }
      },
      "booking": {
        "ClusterId": "booking",
        "Match": {
          "Path": "booking/{**catch-all}"
        }
      },
      "customer": {
        "ClusterId": "customer",
        "Match": {
          "Path": "customer/{**catch-all}"
        }
      },
      "location": {
        "ClusterId": "location",
        "Match": {
          "Path": "location/{**catch-all}"
        }
      },
      "msteams": {
        "ClusterId": "msteams",
        "Match": {
          "Path": "msteams/{**catch-all}"
        }
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "notification/{**catch-all}"
        }
      },
      "organization": {
        "ClusterId": "organization",
        "Match": {
          "Path": "organization/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "payment/{**catch-all}"
        }
      },
      "slack": {
        "ClusterId": "slack",
        "Match": {
          "Path": "slack/{**catch-all}"
        }
      },
      "team": {
        "ClusterId": "team",
        "Match": {
          "Path": "team/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "billing": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10800"
          }
        }
      },
      "booking": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10300"
          }
        }
      },
      "customer": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10000"
          }
        }
      },
      "location": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10600"
          }
        }
      },
      "msteams": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10900"
          }
        }
      },
      "notification": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10400"
          }
        }
      },
      "organization": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10200"
          }
        }
      },
      "payment": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10100"
          }
        }
      },
      "slack": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10700"
          }
        }
      },
      "team": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10500"
          }
        }
      }
    }
  }
}
