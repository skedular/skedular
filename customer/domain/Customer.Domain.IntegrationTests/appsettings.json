{
  "Application": {
    "Environment": "local",
    "Domain": "Customer",
    "DomainSource": "urn::skedular::customer",
    "AppSource": "customer-domain-integrationtests"
  },
  "Kafka": {
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "UseSchemaRegistry": true,
    "SchemaRegistry": {
      "Url": "",
      "AutoRegisterSchema": false,
      "UseLatestVersion": false
    }
  },
  "Email": {
    "NewCustomerFeedbackSubmittedEmailReceivers": [],
    "NewCustomerFeedbackSubmittedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "NewCustomerJoinedEmailReceivers": [],
    "NewCustomerJoinedEmailSender": "Skedular <no-reply@staging.skedular.app>",
    "EnableNewCustomerJoinedEmail": false
  }
}
