<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.10.48">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\billing\processors\Billing.Processors\Billing.Processors.csproj"/>
        <ProjectReference Include="..\..\booking\processors\Booking.Processors\Booking.Processors.csproj"/>
        <ProjectReference Include="..\..\customer\processors\Customer.Processors\Customer.Processors.csproj"/>
        <ProjectReference Include="..\..\location\processors\Location.Processors\Location.Processors.csproj"/>
        <ProjectReference Include="..\..\msteams\processors\MsTeams.Processors\MsTeams.Processors.csproj"/>
        <ProjectReference Include="..\..\notification\processors\Notification.Processors\Notification.Processors.csproj"/>
        <ProjectReference Include="..\..\organization\processors\Organization.Processors\Organization.Processors.csproj"/>
        <ProjectReference Include="..\..\payment\processors\Payment.Processors\Payment.Processors.csproj"/>
        <ProjectReference Include="..\..\slack\processors\Slack.Processors\Slack.Processors.csproj"/>
        <ProjectReference Include="..\..\team\processors\Team.Processors\Team.Processors.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
