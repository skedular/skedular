<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>AllProcessors</AssemblyName>
        <AssemblyTitle>AllProcessors</AssemblyTitle>
        <Product>Skedular AllProcessors</Product>
        <Description>Skedular AllProcessors</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2025. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/unityhubio/unityhubio</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GitRepositoryRoot>$(SolutionDir)</GitRepositoryRoot>
        <WriteVersionInfoToBuildLog>true</WriteVersionInfoToBuildLog>
        <UseFullSemVerForNuGet>true</UseFullSemVerForNuGet>
        <UpdateVersionProperties>true</UpdateVersionProperties>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="6.5.1">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\booking\processors\Booking.Processors\Booking.Processors.csproj"/>
        <ProjectReference Include="..\..\customer\processors\Customer.Processors\Customer.Processors.csproj"/>
        <ProjectReference Include="..\..\location\processors\Location.Processors\Location.Processors.csproj"/>
        <ProjectReference Include="..\..\marketplace\processors\Marketplace.Processors\Marketplace.Processors.csproj"/>
        <ProjectReference Include="..\..\msteams\processors\MsTeams.Processors\MsTeams.Processors.csproj"/>
        <ProjectReference Include="..\..\organization\processors\Organization.Processors\Organization.Processors.csproj"/>
        <ProjectReference Include="..\..\slack\processors\Slack.Processors\Slack.Processors.csproj"/>
        <ProjectReference Include="..\..\team\processors\Team.Processors\Team.Processors.csproj"/>
        <ProjectReference Include="..\..\core\processors\Core.Processors\Core.Processors.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
