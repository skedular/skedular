<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\gateway\apis\Gateway\Gateway.csproj"/>
        <ProjectReference Include="..\..\booking\apis\Booking.Api\Booking.Api.csproj"/>
        <ProjectReference Include="..\..\customer\apis\Customer.Api\Customer.Api.csproj"/>
        <ProjectReference Include="..\..\location\apis\Location.Api\Location.Api.csproj"/>
        <ProjectReference Include="..\..\marketplace\apis\Marketplace.Api\Marketplace.Api.csproj"/>
        <ProjectReference Include="..\..\msteams\apis\MsTeams.Api\MsTeams.Api.csproj"/>
        <ProjectReference Include="..\..\organization\apis\Organization.Api\Organization.Api.csproj"/>
        <ProjectReference Include="..\..\slack\apis\Slack.Api\Slack.Api.csproj"/>
        <ProjectReference Include="..\..\team\apis\Team.Api\Team.Api.csproj"/>
        <ProjectReference Include="..\..\core\apis\Core.Api\Core.Api.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
