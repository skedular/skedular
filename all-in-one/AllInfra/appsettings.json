{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka1.localhost:19092",
    "SecurityProtocol": "Plaintext",
    "IncomingTopicPrefix": "local",
    "OutgoingTopicPrefix": "local",
    "SchemaRegistry": {
      "Url": "http://schema-registry.localhost:9100"
    }
  }
}
