<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features>runtime-async=on</Features>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>646a38e8-2a06-407f-82fd-4188c6ec72a9</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Aspire / Infrastructure Hosting -->
        <PackageReference Include="InfinityFlow.Aspire.Temporal" Version="1.0.2"/>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0"/>
        <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0"/>
        <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0"/>
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0"/>
        <PackageReference Include="HotChocolate.Fusion.Aspire" Version="16.7.6"/>

        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../shared/Enterprise.Shared/Enterprise.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
