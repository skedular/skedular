schema {
  query: Query
  mutation: Mutation
}

type Query {
  personalInformationVisibilityTypes: [PersonalInformationVisibilityDetails!]!
  me: CustomerDetails! @cost(weight: "10")
  customer(id: String!): CustomerDetails @cost(weight: "10")
  customerById(id: ID!): CustomerDetails @lookup @internal @cost(weight: "10")
  customerVersion: Version!
  customerReadinessSynced: Boolean! @cost(weight: "10")
  customersByPreferredLocation(
    after: String
    first: Int
    before: String
    last: Int
    where: CustomersByPreferredLocationWhereInput!
    orderBy: [CustomerOrderInput!]
  ): ConnectionOfCustomerEdge! @cost(weight: "10")
}

type Mutation {
  addMyBillingDetails(input: AddMyBillingDetailsInput!): CustomerPayload!
    @cost(weight: "10")
  updateMyBillingDetails(input: UpdateMyBillingDetailsInput!): CustomerPayload!
    @cost(weight: "10")
  updateMyCustomerDetails(input: UpdateMyCustomerDetailsInput!): CustomerPayload!
    @cost(weight: "10")
  updateCustomerDetails(input: UpdateCustomerDetailsInput!): CustomerPayload!
    @cost(weight: "10")
  submitCustomerFeedback(input: SubmitCustomerFeedbackInput!): SubmitCustomerFeedbackPayload!
    @cost(weight: "10")
  addCustomerPaymentMethodIntent(input: AddCustomerPaymentMethodIntentInput!): AddCustomerPaymentMethodIntentPayload!
    @cost(weight: "10")
  removeCustomerPaymentMethod(input: RemoveCustomerPaymentMethodInput!): RemoveCustomerPaymentMethodPayload!
    @cost(weight: "10")
  completeOnboarding(input: CompleteOrganizationOnboardingInput!): CustomerPayload!
    @cost(weight: "10")
  addCustomerPreferredLocation(input: AddCustomerPreferredLocationInput!): CustomerPayload!
    @cost(weight: "10")
  removeCustomerPreferredLocation(input: RemoveCustomerPreferredLocationInput!): CustomerPayload!
    @cost(weight: "10")
  setCustomerDefaultOrganization(input: SetCustomerDefaultOrganizationInput!): CustomerPayload!
    @cost(weight: "10")
  clearCustomerDefaultOrganization(
    input: ClearCustomerDefaultOrganizationInput!
  ): CustomerPayload! @cost(weight: "10")
  addCustomerPreferredOrganizationTag(
    input: AddCustomerPreferredOrganizationTagInput!
  ): CustomerPayload! @cost(weight: "10")
  removeCustomerPreferredOrganizationTag(
    input: RemoveCustomerPreferredOrganizationTagInput!
  ): CustomerPayload! @cost(weight: "10")
  addCustomerPreferredResource(input: AddCustomerPreferredResourceInput!): CustomerPayload!
    @cost(weight: "10")
  removeCustomerPreferredResource(input: RemoveCustomerPreferredResourceInput!): CustomerPayload!
    @cost(weight: "10")
  addCustomerFavouriteLocation(input: AddCustomerFavouriteLocationInput!): CustomerPayload!
    @cost(weight: "10")
  removeCustomerFavouriteLocation(input: RemoveCustomerFavouriteLocationInput!): CustomerPayload!
    @cost(weight: "10")
}

type AddCustomerPaymentMethodIntentPayload {
  clientMutationId: String
  publishedKeys: String!
  clientSecret: String!
}

type ConnectionOfCustomerEdge {
  pageInfo: PageInfo!
  edges: [CustomerEdge!]!
  totalCount: Int!
}

type CustomerBillingDetails {
  companyName: String
  email: String!
  osmType: String
  osmId: String
  placeId: String
  longitude: Float
  latitude: Float
  formattedAddress: String
  multilinesFormattedAddress: String
  addressLine1: String!
  addressLine2: String
  suburb: String
  city: String
  province: String
  zipcode: String!
  country: String!
  countryCode: String
  id: ID!
}

type CustomerDetails @key(fields: "id") {
  organization: OrganizationDetails
  preferredLocations: [LocationDetails!]!
  preferredResources: [ResourceDetails!]!
  favouriteLocations: [LocationDetails!]!
  hasAttachedPaymentMethod: Boolean! @cost(weight: "10")
  paymentMethods: [CustomerPaymentMethod!]! @cost(weight: "10")
  billingDetails: CustomerBillingDetails @cost(weight: "10")
  createdAt: DateTime!
  email: String
  emails: [String!]!
  identities: [CustomerIdentity!]!
  designation: String
  title: String
  name: String
  givenName: String
  middleName: String
  familyName: String
  photoUrl: String
  photoUrl24: String
  photoUrl32: String
  photoUrl48: String
  photoUrl72: String
  photoUrl192: String
  photoUrl512: String
  timezone: String
  locale: String
  phoneNumber: String
  type: CustomerType!
  isOnboardingDone: Boolean!
  preferredZones: [OrganizationTagDetails!]!
  preferredCustomTags: [OrganizationTagDetails!]!
  personalInformationVisibility: PersonalInformationVisibilityDetails!
  id: ID!
}

type CustomerEdge {
  node: CustomerDetails!
  cursor: String!
}

type CustomerIdentity {
  email: String
  verified: Boolean!
  id: ID!
}

type CustomerPayload {
  clientMutationId: String
  customer: CustomerDetails!
}

type CustomerPaymentMethod {
  cardBrand: String
  cardCountry: String
  cardDescription: String
  cardExpiryMonth: Int
  cardExpiryYear: Int
  cardFingerprint: String
  cardFunding: String
  cardIssuer: String
  cardLastFourDigit: String
  id: ID!
}

type LocationDetails @key(fields: "id") {
  id: ID!
}

type OrganizationDetails @key(fields: "id") @shareable {
  customDomain: String
  id: ID!
}

type OrganizationTagDetails @key(fields: "id") @shareable {
  name: String!
  type: OrganizationTagType
  color: String
  id: ID!
}

type PageInfo @shareable {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type PersonalInformationVisibilityDetails {
  type: PersonalInformationVisibility!
  name: String!
}

type RemoveCustomerPaymentMethodPayload {
  clientMutationId: String
}

type ResourceDetails @key(fields: "id") {
  id: ID!
}

type SubmitCustomerFeedbackPayload {
  id: ID!
  clientMutationId: String
}

type Version @shareable {
  major: Int!
  minor: Int!
  build: Int!
  revision: Int!
}

input AddCustomerFavouriteLocationInput {
  clientMutationId: String
  locationId: String!
}

input AddCustomerPaymentMethodIntentInput {
  clientMutationId: String
}

input AddCustomerPreferredLocationInput {
  clientMutationId: String
  locationId: String!
}

input AddCustomerPreferredOrganizationTagInput {
  clientMutationId: String
  organizationTagId: String!
}

input AddCustomerPreferredResourceInput {
  clientMutationId: String
  resourceId: String!
}

input AddMyBillingDetailsInput {
  clientMutationId: String
  id: String
  companyName: String
  email: String!
  osmType: String
  osmId: String
  placeId: String
  longitude: Float
  latitude: Float
  formattedAddress: String
  addressLine1: String!
  addressLine2: String
  suburb: String
  city: String
  province: String
  zipcode: String!
  country: String!
  countryCode: String
}

input ClearCustomerDefaultOrganizationInput {
  clientMutationId: String
}

input CompleteOrganizationOnboardingInput {
  clientMutationId: String
}

input CustomerOrderInput {
  direction: OrderDirection!
  field: CustomerOrderField!
}

input CustomersByPreferredLocationWhereInput {
  locationId: String!
  nameContains: String
}

input RemoveCustomerFavouriteLocationInput {
  clientMutationId: String
  locationId: String!
}

input RemoveCustomerPaymentMethodInput {
  clientMutationId: String
  id: String!
}

input RemoveCustomerPreferredLocationInput {
  clientMutationId: String
  locationId: String!
}

input RemoveCustomerPreferredOrganizationTagInput {
  clientMutationId: String
  organizationTagId: String!
}

input RemoveCustomerPreferredResourceInput {
  clientMutationId: String
  resourceId: String!
}

input SetCustomerDefaultOrganizationInput {
  clientMutationId: String
  organizationId: String
  organizationCustomDomain: String
}

input SubmitCustomerFeedbackInput {
  clientMutationId: String
  id: String
  feedbackContent: String!
  channel: FeedbackChannelType!
}

input UpdateCustomerDetailsInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [CustomerDetailsPatchField!]!
  timezone: String
  designation: String
  title: String
  name: String
  givenName: String
  middleName: String
  familyName: String
  phoneNumber: String
  personalInformationVisibility: PersonalInformationVisibility!
}

input UpdateMyBillingDetailsInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [CustomerBillingDetailsPatchField!]!
  companyName: String
  email: String!
  osmType: String
  osmId: String
  placeId: String
  longitude: Float
  latitude: Float
  formattedAddress: String
  addressLine1: String!
  addressLine2: String
  suburb: String
  city: String
  province: String
  zipcode: String!
  country: String!
  countryCode: String
}

input UpdateMyCustomerDetailsInput {
  clientMutationId: String
  fieldsToUpdate: [CustomerDetailsPatchField!]!
  timezone: String
  designation: String
  title: String
  name: String
  givenName: String
  middleName: String
  familyName: String
  phoneNumber: String
  personalInformationVisibility: PersonalInformationVisibility!
}

enum CustomerBillingDetailsPatchField {
  COMPANY_NAME
  EMAIL
  BILLING_ADDRESS
}

enum CustomerDetailsPatchField {
  TIMEZONE
  DESIGNATION
  TITLE
  NAME
  GIVEN_NAME
  MIDDLE_NAME
  FAMILY_NAME
  PHONE_NUMBER
  PERSONAL_INFORMATION_VISIBILITY
}

enum CustomerOrderField {
  DESIGNATION
  TITLE
  NAME
  GIVEN_NAME
  MIDDLE_NAME
  FAMILY_NAME
  TIMEZONE
  LOCALE
  PHONE_NUMBER
}

enum CustomerType {
  GUEST
  REGISTERED
}

enum FeedbackChannelType {
  WEB
  SLACK
  MS_TEAMS
}

enum OrderDirection {
  ASCENDING
  DESCENDING
}

