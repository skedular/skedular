<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Enterprise.Shared.IntegrationTesting</AssemblyName>
        <AssemblyTitle>Enterprise.Shared.IntegrationTesting</AssemblyTitle>
        <Product>Skedular Enterprise.Shared.IntegrationTesting</Product>
        <Description>Skedular Enterprise.Shared.IntegrationTesting</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/skedular/skedular</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Aspire / Test Hosting -->
        <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.3"/>

        <!-- gRPC -->
        <PackageReference Include="Grpc.Net.Client" Version="2.83.0"/>

        <!-- Contract Testing -->
        <PackageReference Include="PactNet" Version="5.0.1"/>

        <!-- Test Framework -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0"/>
        <PackageReference Include="Xunit.DependencyInjection" Version="12.0.1"/>
        <PackageReference Include="Xunit.DependencyInjection.Logging" Version="12.0.0"/>

        <!-- Test Containers -->
        <PackageReference Include="Testcontainers" Version="4.14.0"/>

        <PackageReference Include="Polly" Version="8.7.0"/>

        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Enterprise.Shared.UnitTesting/Enterprise.Shared.UnitTesting.csproj"/>
    </ItemGroup>
</Project>
