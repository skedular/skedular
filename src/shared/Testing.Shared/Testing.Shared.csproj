<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Testing.Shared</AssemblyName>
        <AssemblyTitle>Testing.Shared</AssemblyTitle>
        <Product>Skedular Testing.Shared</Product>
        <Description>Skedular Testing.Shared</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/unityhubio/unityhubio</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Test Framework (xUnit) -->
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- Test Fixtures (AutoFixture) -->
        <PackageReference Include="AutoFixture" Version="5.0.0-rc.1"/>
        <PackageReference Include="AutoFixture.AutoFakeItEasy" Version="5.0.0-rc.1"/>
        <PackageReference Include="AutoFixture.Xunit3" Version="5.0.0-rc.1"/>

        <!-- Mocking -->
        <PackageReference Include="FakeItEasy" Version="9.0.1" NoWarn="NU1608"/>

        <!-- Assertions -->
        <PackageReference Include="Shouldly" Version="4.3.0"/>

        <!-- GraphQL Client (for integration / API testing) -->
        <PackageReference Include="GraphQL.Client" Version="6.1.0"/>
        <PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" Version="6.1.0"/>

        <!-- Entity Framework Core (In-Memory Testing) -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11"/>
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3"/>

        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Enterprise.Shared/Enterprise.Shared.csproj"/>
    </ItemGroup>
</Project>
