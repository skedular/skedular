<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Api.Shared.Clients</AssemblyName>
        <AssemblyTitle>Api.Shared.Clients</AssemblyTitle>
        <Product>Skedular Api.Shared.Clients</Product>
        <Description>Skedular Api.Shared.Clients</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/unityhubio/unityhubio</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Event protobuf classes are generated into obj/ instead of checked-in source paths.
             Suppress the protobuf target warning about those generated files not being in the old expected location. -->
        <Protobuf_NoWarnMissingExpected>true</Protobuf_NoWarnMissingExpected>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Version="10.0.10"/>
        <PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0"/>

        <!-- Build Tools / Event Protobuf Serialization -->
        <PackageReference Include="Grpc.Tools" Version="2.83.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <Protobuf Include="../../../api-definitions/events/skedular/booking_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/booking_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/booking_internal_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/booking_internal_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/customer_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/customer_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/customer_readiness_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/customer_readiness_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/location_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/location_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/marketplace_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/marketplace_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/organization_internal_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/organization_internal_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/organization_member_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/organization_member_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/organization_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/organization_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/team_v1_key.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
        <Protobuf Include="../../../api-definitions/events/skedular/team_v1_value.proto" GrpcServices="None" ProtoRoot="../../../api-definitions/events/skedular" OutputOptions="file_extension=.g.cs" CompileOutputs="true"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- gRPC service proto definitions — GrpcServices="Both" generates client stubs + server base classes -->
        <Protobuf Include="../../../api-definitions/grpc/skedular/booking/booking_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/booking/booking_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/core/core_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/core/core_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/core/core_infrastructure_test_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/customer/customer_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/customer/customer_admin_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/customer/customer_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/location/location_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/location/location_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/location/location_resources_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/marketplace/marketplace_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/marketplace/marketplace_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/msteams/msteams_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/msteams/msteams_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/organization/organization_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/organization/organization_billing_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/organization/organization_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/organization/organization_tags_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/organization/organization_zones_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/slack/slack_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/slack/slack_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/team/team_core_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
        <Protobuf Include="../../../api-definitions/grpc/skedular/team/team_graphql_v1.proto" GrpcServices="Both" ProtoRoot="../../../api-definitions/grpc/skedular"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Api.Shared/Api.Shared.csproj"/>
    </ItemGroup>

    <Target Name="IncludeGeneratedEventProtobufSources" BeforeTargets="CoreCompile">
        <ItemGroup>
            <!-- Event protobuf classes are generated into obj/ and intentionally not checked into the repo.
                 Include those transient outputs after protobuf generation so checked-in metadata companions can compile
                 against them on clean builds and in CI. -->
            <Compile Include="$(IntermediateOutputPath)*Key.g.cs" Visible="false"/>
            <Compile Include="$(IntermediateOutputPath)*Value.g.cs" Visible="false"/>
        </ItemGroup>
    </Target>
</Project>
