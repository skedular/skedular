<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Testing.Shared.IntegrationTests</AssemblyName>
        <AssemblyTitle>Testing.Shared.IntegrationTests</AssemblyTitle>
        <Product>Skedular Testing.Shared.IntegrationTests</Product>
        <Description>Skedular Testing.Shared.IntegrationTests</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/unityhubio/unityhubio</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Aspire / Test Hosting -->
        <PackageReference Include="Aspire.Hosting.Testing" Version="13.3.5"/>

        <!-- gRPC -->
        <PackageReference Include="Grpc.Net.Client" Version="2.80.0"/>

        <!-- Contract Testing -->
        <PackageReference Include="PactNet" Version="5.0.1"/>

        <!-- Test Framework -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0"/>
        <PackageReference Include="Xunit.DependencyInjection" Version="11.2.1"/>
        <PackageReference Include="Xunit.DependencyInjection.Logging" Version="11.0.0"/>

        <!-- Test Containers -->
        <PackageReference Include="Testcontainers" Version="4.12.0"/>

        <PackageReference Include="Polly" Version="8.6.6"/>

        <!-- Analyzers -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Testing.Shared/Testing.Shared.csproj"/>
    </ItemGroup>
</Project>
