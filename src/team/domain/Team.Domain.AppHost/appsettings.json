{
  "HttpLogging": {
    "Enabled": false,
    "LoggingFields": "All",
    "RequestBodyLogLimit": 65536,
    "ResponseBodyLogLimit": 65536,
    "CombineLogs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
