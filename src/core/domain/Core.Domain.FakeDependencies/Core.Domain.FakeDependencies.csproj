<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <AssemblyName>Core.Domain.FakeDependencies</AssemblyName>
        <AssemblyTitle>Core.Domain.FakeDependencies</AssemblyTitle>
        <Product>Skedular Core Domain Fake Dependencies</Product>
        <Description>Core domain fake dependency host for integration tests</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/skedular/skedular</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- gRPC (Server) -->
        <PackageReference Include="Grpc.AspNetCore" Version="2.83.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../shared/Enterprise.Shared/Enterprise.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json"/>
    </ItemGroup>
</Project>
