<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>AllApisJobs</AssemblyName>
        <AssemblyTitle>AllApisJobs</AssemblyTitle>
        <Product>Skedular AllApisJobs</Product>
        <Description>Skedular AllApisJobs</Description>
        <Author>Skedular Team</Author>
        <Copyright>© Skedular 2026. All rights reserved.</Copyright>
        <Company>Skedular Ltd</Company>
        <RepositoryUrl>https://github.com/skedular/skedular</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../gateway/apis/Gateway/Gateway.csproj"/>

        <ProjectReference Include="../../booking/apis/Booking.Api/Booking.Api.csproj"/>
        <ProjectReference Include="../../booking/jobs/Booking.Jobs/Booking.Jobs.csproj"/>

        <ProjectReference Include="../../customer/apis/Customer.Api/Customer.Api.csproj"/>
        <ProjectReference Include="../../customer/jobs/Customer.Jobs/Customer.Jobs.csproj"/>

        <ProjectReference Include="../../location/apis/Location.Api/Location.Api.csproj"/>
        <ProjectReference Include="../../location/jobs/Location.Jobs/Location.Jobs.csproj"/>

        <ProjectReference Include="../../marketplace/apis/Marketplace.Api/Marketplace.Api.csproj"/>
        <ProjectReference Include="../../marketplace/jobs/Marketplace.Jobs/Marketplace.Jobs.csproj"/>

        <ProjectReference Include="../../msteams/apis/MsTeams.Api/MsTeams.Api.csproj"/>
        <ProjectReference Include="../../msteams/jobs/MsTeams.Jobs/MsTeams.Jobs.csproj"/>

        <ProjectReference Include="../../organization/apis/Organization.Api/Organization.Api.csproj"/>
        <ProjectReference Include="../../organization/jobs/Organization.Jobs/Organization.Jobs.csproj"/>

        <ProjectReference Include="../../slack/apis/Slack.Api/Slack.Api.csproj"/>
        <ProjectReference Include="../../slack/jobs/Slack.Jobs/Slack.Jobs.csproj"/>

        <ProjectReference Include="../../team/apis/Team.Api/Team.Api.csproj"/>
        <ProjectReference Include="../../team/jobs/Team.Jobs/Team.Jobs.csproj"/>

        <ProjectReference Include="../../core/apis/Core.Api/Core.Api.csproj"/>
        <ProjectReference Include="../../core/jobs/Core.Jobs/Core.Jobs.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
