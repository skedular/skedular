  NOT_SET
  PENDING
  REJECTED
  CONFIRMED
  EXPIRED
  RECORD_NEVER_CREATED
  NO_PAYMENT_REQUIRED
}

enum PrivateBookingPatchField {
  PARTICIPANTS
  SCHEDULE
  NOTES
  CATEGORY
  RESOURCES
}

enum PrivateRecurringBookingPatchField {
  PARTICIPANTS
  REQUESTED_RESOURCES
  SCHEDULE
  RECURRENCE
  SKIPPED_DATES
  CATEGORY
}

enum ProductPricingBillingMode {
  NOT_SET
  UPFRONT
  IN_ARREARS
}

enum ProductPricingCadence {
  NOT_SET
  ONE_TIME
  PER_MINUTE
  PER_HOUR
  DAILY
  WEEKLY
  MONTHLY
  HALF_DAY
  PER15_MINUTES
  PER30_MINUTES
  TWO_MONTHS
  QUARTERLY
  FOUR_MONTHS
  FIVE_MONTHS
  SIX_MONTHS
  YEARLY
  FORTNIGHTLY
}

enum ProductPricingCancellationPolicyType {
  NOT_SET
  NO_CANCELLATION
  FULL_REFUND_BEFORE_CUTOFF
  TIERED_REFUND
}

enum ProductPricingFulfillmentType {
  RESERVATION
  ENTITLEMENT
}

enum RecurringBookingEndType {
  NEVER
  UNTIL_DATE
  AFTER_OCCURRENCES
}

enum RecurringBookingOrderField {
  FROM
  TO
  CATEGORY
  CHANNEL
}

enum ResourceAvailabilityClassification {
  AVAILABLE
  UNAVAILABLE
  PARTIALLY_BOOKED
  FULLY_BOOKED
  OCCUPIED
  BLOCKED
}

enum ResourceAvailabilityOrderByField {
  RESOURCE_NAME
  RESOURCE_TYPE
  LOCATION_NAME
  ZONE_NAME
}

enum ScalarSerializationType {
  STRING
  BOOLEAN
  INT
  FLOAT
  OBJECT
  LIST
}

enum SpacesAccessReasonCode {
  NOT_SET
  ALLOWED_TRIAL
  ALLOWED_PAID
  ALLOWED_COMPLIMENTARY_BRIDGE
  ALLOWED_PROTECTIVE_ACTION
  ALLOWED_READ_OR_RECOVERY
  TRIAL_EXPIRED
  PAID_INACTIVE
  MISSING_TRIAL_STATE
  MISSING_OFFERING_STATE
  ACTION_NOT_ALLOWED
}

enum SpacesQuotaReasonCode {
  NOT_SET
  WITHIN_QUOTA
  FREE_TIER_LIMIT_EXCEEDED
  PAID_TIER_LIMIT_EXCEEDED
  CUSTOM_CAPACITY_EXCEEDED
  MISSING_OFFERING_STATE
  OUT_OF_PERIOD_EXCLUDED
  TRIAL_EXPIRED
}

enum SpacesSubscriptionStatus {
  NOT_SET
  TRIAL_ACTIVE
  TRIAL_EXPIRING
  TRIAL_EXPIRED
  COMPLIMENTARY_BRIDGE
  PAID_ACTIVE
  PAID_INACTIVE
  LEGACY_ACTIVE
  MISSING_STATE
}

"The `DateTime` scalar type represents a date and time with time zone offset information."
scalar DateTime
  @serializeAs(
    type: STRING
    pattern: "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,9})?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
  )
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/date-time.html")

"The `Decimal` scalar type represents a decimal floating-point number with high precision."
scalar Decimal
  @serializeAs(type: FLOAT)
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/decimal.html")

scalar FieldSelectionSet

"The `LocalDate` scalar type represents a date without time or time zone information."
scalar LocalDate
  @serializeAs(type: STRING, pattern: "^\\d{4}-\\d{2}-\\d{2}$")
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/local-date.html")

"The `LocalTime` scalar type represents a time of day without date or time zone information."
scalar LocalTime
  @serializeAs(type: STRING, pattern: "^\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,9})?$")
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/local-time.html")

"The `UnsignedInt` scalar type represents an unsigned 32-bit integer."
scalar UnsignedInt
  @serializeAs(type: INT)
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/unsigned-int.html")

"The purpose of the `cost` directive is to define a `weight` for GraphQL types, fields, and arguments. Static analysis can use these weights when calculating the overall cost of a query or response."
directive @cost(
  "The `weight` argument defines what value to add to the overall cost for every appearance, or possible appearance, of a type, field, argument, etc."
  weight: String!
) on
  | SCALAR
  | OBJECT
  | FIELD_DEFINITION
  | ARGUMENT_DEFINITION
  | ENUM
  | INPUT_FIELD_DEFINITION

directive @internal on OBJECT | FIELD_DEFINITION

"""
The @key directive is used to designate an entity's unique key,
which identifies how to uniquely reference an instance of
an entity across different source schemas.
"""
directive @key("The field selection set syntax." fields: FieldSelectionSet!) repeatable on
  | OBJECT
  | INTERFACE

"""
The @lookup directive is used within a source schema to specify output fields
that can be used by the distributed GraphQL executor to resolve an entity by
a stable key.
"""
directive @lookup on FIELD_DEFINITION

directive @serializeAs(
  "The primitive type a scalar is serialized to."
  type: [ScalarSerializationType!]!
  "The ECMA-262 regex pattern that the serialized scalar value conforms to."
  pattern: String
) on SCALAR

directive @shareable repeatable on OBJECT | FIELD_DEFINITION
