enum BookingCategory {
  WORKING_FROM_HOME
  WORKING_FROM_OFFICE
  WORKING_FROM_COWORKING_SPACE
  SICK_LEAVE
  ANNUAL_LEAVE
  WELLBEING_LEAVE
  CLIENT_OFFICE
  VACATION
  TRAVELING_FOR_WORK
  NON_WORKING_DAY
}

enum BookingChannel {
  PRIVATE
  MARKETPLACE
}

enum BookingFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum BookingOrderField {
  FROM
  TO
  NOTES
  CATEGORY
  CHANNEL
}

enum CancellationErrorCode {
  POLICY_RESTRICTION
  OVERRIDE_REASON_REQUIRED
  INSUFFICIENT_MANAGEMENT_PERMISSION
  INVALID_TERMINAL_STATE
}

enum CreditLedgerTransactionType {
  GRANTED
  CONSUMED
  RELEASED
  FORFEITED
  EXPIRED
  ADJUSTED
}

enum Currency {
  NZD
  USD
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum DurationDisplayUnit {
  MINUTES
  HOURS
}

enum EntitlementRenewalStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum EntitlementStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MarketplaceBookingFailureAccountingCleanupStatus {
  UNKNOWN
  NOT_REQUIRED
  PENDING
  TRANSITION_REQUIRED
}

enum MarketplaceBookingFailureResourceReleaseStatus {
  UNKNOWN
  PENDING
  RELEASED
}

enum MarketplaceBookingModificationActorKind {
  CUSTOMER
  ORGANIZATION_OPERATOR
}

enum MarketplaceBookingModificationErrorCode {
  INVALID_INPUT
  NOT_ELIGIBLE
  UNAUTHORIZED
  OPERATOR_REASON_REQUIRED
  STALE_VERSION
  UNAVAILABLE
  INVALID_RESOURCE_SELECTION
  OUTSIDE_SUBSCRIPTION_CYCLE
}

enum MarketplaceBookingPatchField {
  PARTICIPANTS
  NOTES
  CATEGORY
}

enum MarketplaceBookingSubscriptionCancellationMode {
  IMMEDIATE
  AT_PERIOD_END
}

enum MarketplaceBookingSubscriptionOrderField {
  STARTED_AT
  CANCELLED_AT
  NEXT_RENEWAL_AT
  STATUS
}

enum MarketplaceBookingSubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  RENEWAL_FAILED
  PAUSED
}

enum MarketplacePurchaseHistoryOrderField {
  ACTIVITY_AT
  PURCHASED_AT
  BOOKING_FROM
  BOOKING_UNTIL
}

enum MarketplacePurchaseLifecycleState {
  ACTIVE
  CANCELLED
  DELETED
  EXPIRED
  PAYMENT_FAILED
  PENDING
}

enum MarketplacePurchaseRenewalState {
  NOT_APPLICABLE
  RENEWS
  DOES_NOT_RENEW
}

enum MarketplacePurchaseSourceType {
  BOOKING
  SUBSCRIPTION
  ENTITLEMENT
}

enum MarketplaceRefundEventType {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROVIDER_PENDING
  PROCESSING
  SENT_TO_XERO
  ACCOUNTING_PROJECTED
  ACCOUNTING_PROJECTION_REQUIRED
  COMPLETED
  FAILED
  CANCELLED
  RECONCILIATION_REQUIRED
}

enum MarketplaceRefundKind {
  CANCELLATION
  MODIFICATION
  PARTIAL
  ENTITLEMENT_EXPIRY
}

enum MarketplaceRefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  PROVIDER_PENDING
  COMPLETED
  FAILED
  CANCELLED
  RECONCILIATION_REQUIRED
}

enum OrderDirection {
  ASCENDING
  DESCENDING
}

enum OrganizationTagType {
  CUSTOM
  ZONE
  PRODUCT
  RESOURCE_DESK
  RESOURCE_ROOM
  RESOURCE_PARKING
  RESOURCE_OTHERS
  RESOURCE_ENTIRE_LOCATION
  LOCATION_SPACE_TYPE_CAR_PARK_SPACE
  LOCATION_SPACE_TYPE_EVENT_SPACE
  LOCATION_SPACE_TYPE_MEETING_SPACE
  LOCATION_SPACE_TYPE_OFFICE_SPACE
  LOCATION_SPACE_TYPE_RETAIL_SPACE
  LOCATION_SPACE_TYPE_STORAGE_SPACE
  LOCATION_SPACE_TYPE_STUDIO_SPACE
  LOCATION_SPACE_TYPE_COMMERCIAL_KITCHEN
  LOCATION_SPACE_TYPE_SHOOT_LOCATION
  LOCATION_SPACE_TYPE_OTHERS
  AMENITY_HIGH_SPEED_WIFI
  AMENITY_DEDICATED_VLAN
  AMENITY_WIRED_ETHERNET
  AMENITY_GUEST_NETWORK
  AMENITY_VPN_SUPPORT
  AMENITY_BACKUP_INTERNET
  AMENITY_NETWORK_PRINTING
  AMENITY_SECURE_SSID
