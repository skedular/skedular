schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

type Query {
  marketplaceBookingRefundPreview(bookingId: String!): MarketplaceRefundPreviewDetails!
    @cost(weight: "10")
  marketplaceBookingSubscriptionRefundPreview(subscriptionId: String!): MarketplaceRefundPreviewDetails!
    @cost(weight: "10")
  marketplaceRefund(id: String!): MarketplaceRefundDetails @cost(weight: "10")
  marketplaceRefunds(organizationCustomDomain: String!, statuses: [String!]): [MarketplaceRefundDetails!]!
    @cost(weight: "10")
  marketplaceRefundQueue(
    after: String
    first: Int
    before: String
    last: Int
    where: MarketplaceRefundWhereInput!
  ): ConnectionOfMarketplaceRefundEdge! @cost(weight: "10")
  marketplaceExternalRefundReconciliations(
    organizationCustomDomain: String!
    after: String
    first: Int
    before: String
    last: Int
    provider: String
    status: String
  ): ConnectionOfMarketplaceExternalRefundReconciliationEdge!
    @cost(weight: "10")
  marketplaceUnassignedExternalRefundReconciliations(
    after: String
    first: Int
    before: String
    last: Int
    provider: String
    status: String
  ): ConnectionOfMarketplaceExternalRefundReconciliationEdge!
    @cost(weight: "10")
  marketplaceRefundStatuses: [MarketplaceRefundStatusDetails!]!
  marketplaceRefundKinds: [MarketplaceRefundKindDetails!]!
  marketplaceRefundEventTypes: [MarketplaceRefundEventTypeDetails!]!
  marketplaceBookingFailures: [MarketplaceBookingFailureDetails!]!
    @cost(weight: "10")
  bookingCategories: [BookingCategoryDetails!]!
  marketplaceBookingCategories: [BookingCategoryDetails!]!
  booking(id: String!): BookingDetails @cost(weight: "10")
  bookingSpacesQuotaStatus(organizationId: String!): BookingSpacesQuotaStatusDetails!
    @cost(weight: "10")
  spacesPublicBookingAvailability(organizationId: String!): SpacesPublicBookingAvailabilityDetails!
    @cost(weight: "10")
  bookingById(id: ID!): BookingDetails @lookup @internal @cost(weight: "10")
  organizationById(id: ID!): OrganizationDetails @lookup @internal
  bookings(
    after: String
    first: Int
    before: String
    last: Int
    where: BookingWhereInput!
    orderBy: [BookingOrderInput!]
  ): ConnectionOfBookingEdge! @cost(weight: "10")
  allBookings(where: BookingWhereInput!): [BookingDetails!]! @cost(weight: "10")
  myEntitlements: [EntitlementDetails!]! @cost(weight: "10")
  entitlement(id: String!): EntitlementDetails @cost(weight: "10")
  entitlementsByCustomer(customerId: String!): [EntitlementDetails!]!
    @cost(weight: "10")
  organizationEntitlements(organizationId: String!): [EntitlementDetails!]!
    @cost(weight: "10")
  entitlementPurchase(purchaseId: String!): EntitlementPurchaseDetails
    @cost(weight: "10")
  entitlementPurchases: [EntitlementPurchaseDetails!]! @cost(weight: "10")
  organizationEntitlementPurchases(organizationId: String!): [EntitlementPurchaseDetails!]!
    @cost(weight: "10")
  marketplaceBookingSubscriptionCancellationModes: [MarketplaceBookingSubscriptionCancellationModeDetails!]!
  marketplaceBookingSubscriptionStatuses: [MarketplaceBookingSubscriptionStatusDetails!]!
  marketplaceBookingPaymentStatuses: [MarketplaceBookingPaymentStatusDetails!]!
  marketplaceBookingSubscription(id: String!): MarketplaceBookingSubscriptionDetails
    @cost(weight: "10")
  marketplaceBookingSubscriptionById(id: ID!): MarketplaceBookingSubscriptionDetails
    @lookup
    @internal
    @cost(weight: "10")
  marketplaceBookingSubscriptions(
    after: String
    first: Int
    before: String
    last: Int
    where: MarketplaceBookingSubscriptionWhereInput!
    orderBy: [MarketplaceBookingSubscriptionOrderInput!]
  ): ConnectionOfMarketplaceBookingSubscriptionEdge! @cost(weight: "10")
  allMarketplaceBookingSubscriptions(
    where: MarketplaceBookingSubscriptionWhereInput!
  ): [MarketplaceBookingSubscriptionDetails!]! @cost(weight: "10")
  marketplacePurchases(
    after: String
    first: Int
    before: String
    last: Int
    where: MarketplacePurchaseHistoryWhereInput!
    orderBy: [MarketplacePurchaseHistoryOrderInput!]
  ): ConnectionOfMarketplacePurchaseHistoryEdge! @cost(weight: "10")
  paymentMethodTypes: [PaymentMethodTypeDetails!]!
  paymentStatuses: [PaymentStatusDetails!]!
  organizationBookingPermissions(
    organizationId: String
    organizationCustomDomain: String
  ): OrganizationBookingPermissions! @cost(weight: "10")
  teamBookingPermissions(teamId: String!): TeamBookingPermissions!
    @cost(weight: "10")
  recurringBooking(id: String!): RecurringBookingDetails @cost(weight: "10")
  recurringBookingById(id: ID!): RecurringBookingDetails
    @lookup
    @internal
    @cost(weight: "10")
  recurringBookings(
    after: String
    first: Int
    before: String
    last: Int
    where: RecurringBookingWhereInput!
    orderBy: [RecurringBookingOrderInput!]
  ): ConnectionOfRecurringBookingEdge! @cost(weight: "10")
  allRecurringBookings(where: RecurringBookingWhereInput!): [RecurringBookingDetails!]!
    @cost(weight: "10")
  resourceAvailabilityStatuses: [ResourceAvailabilityClassificationDetails!]!
  resourceDayViews(
    filter: ResourceAvailabilityFilterInput!
    orderBy: [ResourceAvailabilityOrderByInput!]!
  ): ResourceDayViewConnection! @cost(weight: "10")
  availableResources(where: AvailableResourcesWhereInput!): [BookingResourceDetails!]!
    @cost(weight: "10")
  availableResourcesCount(where: AvailableResourcesCountWhereInput!): Int!
    @cost(weight: "10")
  organizationResourcesAvailability(
    where: OrganizationAvailableResourcesWhereInput!
  ): OrganizationAvailableResources! @cost(weight: "10")
  bookingVersion: Version!
}

type Mutation {
  approveMarketplaceRefund(input: ApproveMarketplaceRefundInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  rejectMarketplaceRefund(input: RejectMarketplaceRefundInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  recordBankTransferRefundSent(input: RecordBankTransferRefundSentInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  confirmBankTransferRefundReceived(
    input: ConfirmBankTransferRefundReceivedInput!
  ): MarketplaceRefundPayload! @cost(weight: "10")
  retryMarketplaceRefund(input: RetryMarketplaceRefundInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  resolveRefundReconciliationRequired(
    input: ResolveRefundReconciliationRequiredInput!
  ): MarketplaceRefundPayload! @cost(weight: "10")
  cancelMarketplaceRefund(input: CancelMarketplaceRefundInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  createPartialMarketplaceRefund(input: CreatePartialMarketplaceRefundInput!): MarketplaceRefundPayload!
    @cost(weight: "10")
  resolveMarketplaceExternalRefundReconciliation(
    input: ResolveMarketplaceExternalRefundReconciliationInput!
  ): MarketplaceExternalRefundReconciliationPayload! @cost(weight: "10")
  resolveUnassignedMarketplaceExternalRefundReconciliation(
    input: ResolveUnassignedMarketplaceExternalRefundReconciliationInput!
  ): MarketplaceExternalRefundReconciliationPayload! @cost(weight: "10")
  adjustEntitlementCredit(input: AdjustEntitlementCreditInput!): AdjustEntitlementCreditPayload!
    @cost(weight: "10")
  consumeEntitlementCredit(input: ConsumeEntitlementCreditInput!): ConsumeEntitlementCreditPayload!
    @cost(weight: "10")
  acceptPartialMarketplaceBooking(input: ResolvePartialMarketplaceBookingInput!): MarketplaceBookingFailureDetails!
    @cost(weight: "10")
  declinePartialMarketplaceBooking(
    input: ResolvePartialMarketplaceBookingInput!
  ): MarketplaceBookingFailureDetails! @cost(weight: "10")
  addPrivateBooking(input: AddPrivateBookingInput!): BookingPayload!
    @cost(weight: "10")
  updatePrivateBooking(input: UpdatePrivateBookingInput!): BookingPayload!
    @cost(weight: "10")
  deletePrivateBooking(input: DeletePrivateBookingInput!): BookingPayload!
    @cost(weight: "10")
  addMarketplaceBooking(input: AddMarketplaceBookingInput!): BookingPayload!
    @cost(weight: "10")
  addMarketplaceCreditBookings(input: AddMarketplaceBookingInput!): MarketplaceCreditBookingsPayload!
    @cost(weight: "10")
  updateMarketplaceBooking(input: UpdateMarketplaceBookingInput!): BookingPayload!
    @cost(weight: "10")
  modifyMarketplaceBooking(input: ModifyMarketplaceBookingInput!): ModifyMarketplaceBookingPayload!
    @cost(weight: "10")
  deleteMarketplaceBooking(input: DeleteMarketplaceBookingInput!): BookingPayload!
    @cost(weight: "10")
  cancelEntitlement(input: CancelEntitlementInput!): CancelEntitlementPayload!
    @cost(weight: "10")
  setEntitlementRenewalPolicy(input: SetEntitlementRenewalPolicyInput!): SetEntitlementRenewalPolicyPayload!
    @cost(weight: "10")
  createEntitlementPurchase(input: CreateEntitlementPurchaseInput!): EntitlementPurchasePayload!
    @cost(weight: "10")
  confirmEntitlementPurchase(input: ConfirmEntitlementPurchaseInput!): EntitlementPurchasePayload!
    @cost(weight: "10")
  rejectEntitlementPurchase(input: RejectEntitlementPurchaseInput!): EntitlementPurchasePayload!
    @cost(weight: "10")
  makeEntitlementPurchasePaymentNotRequired(
    input: MakeEntitlementPurchasePaymentNotRequiredInput!
  ): EntitlementPurchasePayload! @cost(weight: "10")
  addMarketplaceBookingSubscription(
    input: AddMarketplaceBookingSubscriptionInput!
  ): MarketplaceBookingSubscriptionPayload! @cost(weight: "10")
  deleteMarketplaceBookingSubscription(
    input: DeleteMarketplaceBookingSubscriptionInput!
  ): MarketplaceBookingSubscriptionPayload! @cost(weight: "10")
  confirmBookingPayment(input: ConfirmBookingPaymentInput!): BookingPayload!
    @cost(weight: "10")
  rejectBookingPayment(input: RejectBookingPaymentInput!): BookingPayload!
    @cost(weight: "10")
  makeBookingPaymentNotRequired(input: MakeBookingPaymentNotRequiredInput!): BookingPayload!
    @cost(weight: "10")
  confirmRecurringBookingPayment(input: ConfirmRecurringBookingPaymentInput!): RecurringBookingPayload!
    @cost(weight: "10")
  rejectRecurringBookingPayment(input: RejectRecurringBookingPaymentInput!): RecurringBookingPayload!
    @cost(weight: "10")
  makeRecurringBookingPaymentNotRequired(
    input: MakeRecurringBookingPaymentNotRequiredInput!
  ): RecurringBookingPayload! @cost(weight: "10")
  addPrivateRecurringBooking(input: AddPrivateRecurringBookingInput!): RecurringBookingPayload!
    @cost(weight: "10")
  updatePrivateRecurringBooking(input: UpdatePrivateRecurringBookingInput!): RecurringBookingPayload!
    @cost(weight: "10")
  deletePrivateRecurringBooking(input: DeletePrivateRecurringBookingInput!): RecurringBookingPayload!
    @cost(weight: "10")
}

type Subscription {
  booking(id: String!): BookingDetails!
  entitlementPurchase(purchaseId: String!): EntitlementPurchaseDetails!
  marketplaceBookingSubscription(id: String!): MarketplaceBookingSubscriptionDetails!
  resourceAvailability(
    subscriptionKey: String!
    filter: ResourceAvailabilityFilterInput!
  ): ResourceDayViewConnection!
}

type AdjustEntitlementCreditPayload {
  clientMutationId: String
  ledgerEntry: CreditLedgerEntryDetails
  error: String
}

type Booking_LocationDetails {
  uniqueId: String!
  name: String!
}

type BookingAvailabilityErrorDetails {
  message: String!
  unavailableResourceIds: [String!]!
}

type BookingCategoryDetails {
  category: BookingCategory!
  name: String!
}

type BookingChannelDetails {
  channel: BookingChannel!
  name: String!
}

type BookingCheckoutSessionDetails {
  uniqueId: String!
  checkoutUrl: String!
}

type BookingDetails @key(fields: "id") {
  involvedCustomers: [CustomerDetails!]!
  createdByCustomer: CustomerDetails
  lastModifiedByCustomer: CustomerDetails
  deletedByCustomer: CustomerDetails
  involvedOrganizations: [OrganizationDetails!]!
  involvedTeams: [TeamDetails!]!
  failure: MarketplaceBookingFailureDetails @cost(weight: "10")
  cancellationAvailability: MarketplaceCancellationAvailabilityDetails!
    @cost(weight: "10")
  arrearsInvoices: [OrganizationArrearsInvoiceDetails!]! @cost(weight: "10")
  marketplaceBookingModifications: [MarketplaceBookingModificationDetails!]!
    @cost(weight: "10")
  marketplaceBookingResourceSelection(
    from: DateTime
    until: DateTime
    locationId: String
  ): MarketplaceBookingResourceSelectionDetails! @cost(weight: "10")
  entityFrameworkVersion: UnsignedInt!
  from: DateTime!
  until: DateTime!
  notes: String
  category: BookingCategoryDetails!
  channel: BookingChannelDetails!
  bookingResources: [BookingResourceDetails!]!
  involvedLocations: [Booking_LocationDetails!]!
  recurringBooking: RecurringBookingDetails
  marketplaceBooking: MarketplaceBookingDetails
  cancellationPolicyOverridden: Boolean!
  cancellationOverrideReason: String
  hasRecurringInstanceOverrides: Boolean
  id: ID!
}

type BookingEdge {
  node: BookingDetails!
  cursor: String!
}

type BookingFrequencyDetails {
  frequency: BookingFrequency!
  name: String!
}

type BookingPayload {
  clientMutationId: String
  booking: BookingDetails
  quotaError: BookingSpacesQuotaErrorDetails
  accessError: SpacesAccessErrorDetails
  availabilityError: BookingAvailabilityErrorDetails
  failure: MarketplaceBookingFailureDetails
  cancellationError: CancellationErrorDetails
}

type BookingRecurrenceEndTypeDetails {
  endType: RecurringBookingEndType!
  name: String!
}

type BookingResourceDetails {
  customers: [CustomerDetails!]!
  resource: ResourceDetails!
  location: Booking_LocationDetails
}

type BookingSpacesQuotaErrorDetails {
  errorCode: String!
  reasonCode: SpacesQuotaReasonCodeDetails
  currentUsage: Int!
  quotaLimit: Int!
  attemptedCurrentPeriodCount: Int!
  excludedOutOfPeriodCount: Int!
  totalAttemptedInstanceCount: Int!
  remainingQuota: Int!
  upgradePlans: [UpgradePlanDetails!]!
}

type BookingSpacesQuotaStatusDetails {
  organizationId: String!
  currentPeriodStartUtc: DateTime!
  currentPeriodEndUtc: DateTime!
  planCode: Int
  quotaLimit: Int
  currentUsage: Int!
  attemptedCurrentPeriodCount: Int!
  excludedOutOfPeriodCount: Int!
  totalAttemptedInstanceCount: Int!
  remainingQuota: Int
  quotaExceeded: Boolean!
  reasonCode: SpacesQuotaReasonCodeDetails
  upgradePlans: [UpgradePlanDetails!]!
}

type BookingWindowDetails {
  bookingId: String!
  from: DateTime!
  until: DateTime!
  isRecurring: Boolean!
  isCheckedIn: Boolean!
  bookedByName: String
  bookedByUserId: String
  notes: String
}

type CancelEntitlementPayload {
  clientMutationId: String
  entitlement: EntitlementDetails
  error: String
}

type CancellationErrorDetails {
  code: CancellationErrorCode!
  message: String!
}

type ConnectionOfBookingEdge {
  pageInfo: PageInfo!
  edges: [BookingEdge!]!
  totalCount: Int!
}

type ConnectionOfMarketplaceBookingInstanceEdge {
  pageInfo: PageInfo!
  edges: [MarketplaceBookingInstanceEdge!]!
  totalCount: Int!
}

type ConnectionOfMarketplaceBookingSubscriptionEdge {
  pageInfo: PageInfo!
  edges: [MarketplaceBookingSubscriptionEdge!]!
  totalCount: Int!
}

type ConnectionOfMarketplaceExternalRefundReconciliationEdge {
  pageInfo: PageInfo!
  edges: [MarketplaceExternalRefundReconciliationEdge!]!
  totalCount: Int!
}

type ConnectionOfMarketplacePurchaseHistoryEdge {
  pageInfo: PageInfo!
  edges: [MarketplacePurchaseHistoryEdge!]!
  totalCount: Int!
}

type ConnectionOfMarketplaceRefundEdge {
  pageInfo: PageInfo!
  edges: [MarketplaceRefundEdge!]!
  totalCount: Int!
}

type ConnectionOfRecurringBookingEdge {
  pageInfo: PageInfo!
  edges: [RecurringBookingEdge!]!
  totalCount: Int!
}

type ConsumeEntitlementCreditPayload {
  clientMutationId: String
  ledgerEntry: CreditLedgerEntryDetails
  error: String
}

type CreditLedgerEntryDetails {
  id: String!
  bookingId: String
  quantity: Int!
  transactionType: CreditLedgerTransactionType!
  referenceKey: String!
  createdAt: DateTime!
}

type CurrencyDetails @shareable {
  type: Currency!
  name: String!
}

type CustomerDetails @key(fields: "id") {
  id: ID!
}

type DayOfWeekDetails {
  dayOfWeek: DayOfWeek!
  name: String!
}

type EntitlementDetails {
  id: String!
  customerId: String!
  organizationId: String!
  organizationCustomDomain: String!
  purchaseReference: String!
  pricingId: String!
  productId: String!
  grantedQuantity: Int!
  availableQuantity: Int!
  activatesAt: DateTime!
  expiresAt: DateTime!
  status: EntitlementStatus!
  autoRenew: Boolean!
  cancelAtPeriodEnd: Boolean!
  currency: String!
  restrictions: EntitlementRestrictionsDetails
  renewalStatus: EntitlementRenewalStatus!
  nextRenewalAt: DateTime
  renewalFailureReason: String
  paymentAction: String
  refund: EntitlementRefundDetails
  ledger: [CreditLedgerEntryDetails!]!
  linkedBookingIds: [String!]!
}

type EntitlementPurchaseDetails {
  productVersion: ProductVersionDetails!
  customerName: String @cost(weight: "10")
  entitlement: EntitlementDetails @cost(weight: "10")
  linkedBookings(after: String, first: Int, before: String, last: Int): ConnectionOfBookingEdge!
    @cost(weight: "10")
  id: String!
  paymentStatus: String!
  lifecycleState: String!
  paymentMethod: String!
  paymentExpiry: DateTime!
  serviceStartAt: DateTime!
  amount: Decimal!
  currency: String!
  pricingId: String!
  creditQuantity: Int!
  validityDays: Int!
  customerId: String!
  organizationId: String!
  entitlementId: String
  checkoutReturnUrl: String
  invoiceNumber: String
  invoiceUrl: String
  paymentInstructions: String
  paymentAction: String
  invoiceEmailList: [String!]!
}

type EntitlementPurchasePayload {
  clientMutationId: String
  purchase: EntitlementPurchaseDetails
  error: String
}

type EntitlementRefundDetails {
  id: String!
  amount: Decimal!
  unusedCreditQuantity: Int!
  status: MarketplaceRefundStatus!
  paymentRefundStatus: String
}

type EntitlementRestrictionsDetails {
  productId: String!
  productVersionId: String!
  availableDays: [DayOfWeek!]!
  minDurationMinutes: Int
  maxDurationMinutes: Int
  numberOfResourcesToBook: Int!
}

type ListingMetadata @shareable {
  about: String
  title: String
  subTitle: String
  includedFeatures: [String!]
}

type MarketplaceBookingDetails {
  entitlementPurchaseId: String @cost(weight: "10")
  paidByCustomer: CustomerDetails
  paidByOrganization: OrganizationDetails
  productVersion: ProductVersionDetails!
  refund: MarketplaceRefundDetails @cost(weight: "10")
  failure: MarketplaceBookingFailureDetails @cost(weight: "10")
  quantity: Int!
  entitlementId: String
  consumingCreditLedgerEntryId: String
  productPricing: ProductPricing!
  paymentMethod: PaymentMethodTypeDetails!
  totalAmountExcludeTax: Decimal
  totalAmountExcludeTaxToDisplay: String!
  taxAmount: Decimal
  taxAmountToDisplay: String!
  taxRatePercentage: Decimal
  taxRatePercentageToDisplay: String!
  totalAmount: Decimal
  hostCommissionRatePercentage: Decimal
  hostCommissionAmount: Decimal
  hostPayoutAmount: Decimal
  hostGrossProceedsAmount: Decimal
  totalAmountToDisplay: String!
  currency: CurrencyDetails
  currencyToDisplay: String!
  invoiceUrl: String
  invoiceNumber: String
  invoiceEmailList: [String!]!
  billingMode: ProductPricingBillingMode!
  isPaymentRequired: Boolean!
  bookingCheckoutSession: BookingCheckoutSessionDetails
  paymentExpiry: DateTime!
  paymentStatus: PaymentStatusDetails!
  id: ID!
}

type MarketplaceBookingFailureAccountingCleanupStatusDetails {
  type: MarketplaceBookingFailureAccountingCleanupStatus!
  name: String!
}

type MarketplaceBookingFailureChoiceDetails {
  type: String!
  name: String!
}

type MarketplaceBookingFailureDetails {
  id: String!
  category: MarketplaceBookingFailureChoiceDetails!
  scope: MarketplaceBookingFailureChoiceDetails!
  finalizedAt: DateTime!
  requestedFrom: DateTime
  requestedUntil: DateTime
  customerAction: MarketplaceBookingFailureChoiceDetails!
  resolutionDeadlineAt: DateTime
  resolutionDecidedAt: DateTime
  resolutionDecision: String
  allocatedRefundAmount: Decimal
  resourceReleaseStatus: MarketplaceBookingFailureResourceReleaseStatusDetails!
  accountingCleanupStatus: MarketplaceBookingFailureAccountingCleanupStatusDetails!
}

type MarketplaceBookingFailureResourceReleaseStatusDetails {
  type: MarketplaceBookingFailureResourceReleaseStatus!
  name: String!
}

type MarketplaceBookingInstanceEdge {
  node: RecurringBookingDetails!
  cursor: String!
}

type MarketplaceBookingModificationConflictErrorDetails {
  code: MarketplaceBookingModificationErrorCode!
  message: String!
  currentBooking: BookingDetails
}

type MarketplaceBookingModificationDetails {
  id: String!
  bookingId: String!
  occurredAt: DateTime!
  actorKind: MarketplaceBookingModificationActorKind!
  reason: String
  originalFrom: DateTime!
  originalUntil: DateTime!
  resultFrom: DateTime!
  resultUntil: DateTime!
  originalResourceIds: [String!]!
  resultResourceIds: [String!]!
  originalResourceNames: [String!]!
  resultResourceNames: [String!]!
  subscriptionOccurrenceOverride: Boolean!
}

type MarketplaceBookingModificationEligibilityErrorDetails {
  code: MarketplaceBookingModificationErrorCode!
  message: String!
}

type MarketplaceBookingPaymentStatusDetails {
  type: PaymentStatus!
  name: String!
}

type MarketplaceBookingResourceSelectionDetails {
  canSelectResources: Boolean!
  maximumResourceCount: Int!
  eligibleResources: [BookingResourceDetails!]!
  availableResourceIds: [String!]!
  eligibleLocations: [Booking_LocationDetails!]!
}

type MarketplaceBookingSubscriptionCancellationModeDetails {
  type: MarketplaceBookingSubscriptionCancellationMode!
  name: String!
}

type MarketplaceBookingSubscriptionDetails @key(fields: "id") {
  involvedCustomers: [CustomerDetails!]!
  createdByCustomer: CustomerDetails
  lastModifiedByCustomer: CustomerDetails
  deletedByCustomer: CustomerDetails
  involvedOrganizations: [OrganizationDetails!]!
  involvedTeams: [TeamDetails!]!
  refund: MarketplaceRefundDetails @cost(weight: "10")
  failure: MarketplaceBookingFailureDetails @cost(weight: "10")
  cancellationAvailability: MarketplaceSubscriptionCancellationAvailabilityDetails!
    @cost(weight: "10")
  bookingInstances(
    after: String
    first: Int
    before: String
    last: Int
    from: DateTime
    until: DateTime
  ): ConnectionOfMarketplaceBookingInstanceEdge! @cost(weight: "10")
  linkedBookings(after: String, first: Int, before: String, last: Int): ConnectionOfBookingEdge!
    @cost(weight: "10")
  arrearsInvoices: [OrganizationArrearsInvoiceDetails!]! @cost(weight: "10")
  startedAt: DateTime!
  cancelledAt: DateTime
  nextRenewalAt: DateTime
  status: MarketplaceBookingSubscriptionStatusDetails!
  autoRenew: Boolean!
  cancelAtPeriodEnd: Boolean!
  cancellationPolicyOverridden: Boolean!
  cancellationOverrideReason: String
  weeklySelectedDays: [DayOfWeek!]!
  marketplaceBooking: MarketplaceBookingDetails!
  recurringBookings: [RecurringBookingDetails!]!
  id: ID!
}

type MarketplaceBookingSubscriptionEdge {
  node: MarketplaceBookingSubscriptionDetails!
  cursor: String!
}

type MarketplaceBookingSubscriptionPayload {
  clientMutationId: String
  marketplaceBookingSubscription: MarketplaceBookingSubscriptionDetails
  accessError: SpacesAccessErrorDetails
  cancellationError: CancellationErrorDetails
}

type MarketplaceBookingSubscriptionStatusDetails {
  type: MarketplaceBookingSubscriptionStatus!
  name: String!
}

type MarketplaceCancellationAvailabilityDetails {
  canCancel: Boolean!
  requiresReason: Boolean!
  isPolicyOverride: Boolean!
  unavailableReason: String
  isCreditFunded: Boolean!
  creditOutcome: String
}

type MarketplaceCreditBookingsPayload {
  clientMutationId: String
  bookings: [BookingDetails!]!
}

type MarketplaceExternalRefundReconciliationDetails {
  id: String!
  provider: String!
  externalRefundId: String!
  amount: Decimal
  currency: String
  status: String!
  firstSeenAt: DateTime!
  lastSeenAt: DateTime!
  resolutionReason: String
  resolutionActorCustomerId: String
  resolutionCorrelationId: String
}

type MarketplaceExternalRefundReconciliationEdge {
  node: MarketplaceExternalRefundReconciliationDetails!
  cursor: String!
}

type MarketplaceExternalRefundReconciliationPayload {
  clientMutationId: String
  reconciliation: MarketplaceExternalRefundReconciliationDetails!
}

type MarketplacePurchaseHistoryDetails {
  refund: MarketplaceRefundDetails @cost(weight: "10")
  id: String!
  sourceId: String!
  sourceType: MarketplacePurchaseSourceType!
  sourceTypeName: String!
  lifecycleState: MarketplacePurchaseLifecycleState!
  lifecycleStateName: String!
  renewalState: MarketplacePurchaseRenewalState!
  renewalStateName: String!
  purchasedAt: DateTime!
  activityAt: DateTime!
  bookingFrom: DateTime
  bookingUntil: DateTime
  paymentStatus: PaymentStatus!
  paymentMethod: String
  productVersionId: String
  productTitle: String
  totalAmount: Decimal
  currency: Currency
  customerId: String
  deletedByCustomerId: String
  cancellationReason: String
  refundId: String
  bookingId: String
  entitlementStatus: String
  creditQuantity: Int!
  grantedQuantity: Int!
  availableQuantity: Int!
  isDeleted: Boolean!
}

type MarketplacePurchaseHistoryEdge {
  node: MarketplacePurchaseHistoryDetails!
  cursor: String!
}

type MarketplaceRefundDetails {
  id: String!
