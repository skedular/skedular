{
  "name": "webapp-spaces",
  "version": "0.1.0",
  "description": "Skedular Spaces Web App",
  "private": true,
  "scripts": {
    "dev": "cross-env PORT=15004 next dev --turbopack",
    "dev:teams": "cross-env PORT=15004 next dev --turbopack --experimental-https",
    "build": "next build",
    "start": "cross-env PORT=15004 next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "capture:media": "node ../../scripts/capture-media.mjs webapp-spaces",
    "capture:media:spaces-list": "node ../../scripts/capture-media.mjs webapp-spaces spaces-list --output ./docs-media",
    "lint-fix": "eslint --fix",
    "format": "prettier --write --single-quote true --trailing-comma all --print-width 180 ./src && pnpm lint-fix",
    "relay": "relay-compiler relay.config.js"
  },
  "dependencies": {
    "@date-io/core": "^3.2.0",
    "@date-io/date-fns": "^3.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@microsoft/teamsfx": "^4.0.3",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@mui/system": "^9.3.0",
    "@mui/x-charts": "^9.11.1",
    "@mui/x-data-grid": "^9.11.0",
    "@mui/x-data-grid-premium": "^9.11.0",
    "@mui/x-data-grid-pro": "^9.11.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@mui/x-date-pickers-pro": "^9.11.0",
    "@mui/x-license": "^9.11.0",
    "@mui/x-tree-view": "^9.11.0",
    "@mui/x-tree-view-pro": "^9.11.0",
    "@next/third-parties": "^16.3.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@skedular/shared": "workspace:*",
    "@skedular/ui": "workspace:*",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cookies-next": "^6.1.1",
    "countries-list": "^3.4.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "final-form": "^5.0.1",
    "globalize": "1.7.1",
    "graphql-sse": "^2.6.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "logrocket": "^12.1.1",
    "logrocket-react": "^7.0.1",
    "mui-rff": "^10.0.1",
    "next": "^16.3.1",
    "node-ipinfo": "^4.4.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-final-form": "^7.0.1",
    "react-image-crop": "^11.1.2",
    "react-leaflet": "5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-relay": "^21.0.1",
    "react-svg-credit-card-payment-icons": "^6.0.4",
    "react-toastify": "^11.1.0",
    "relay-runtime": "^21.0.1",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/leaflet": "^1.9.22",
    "@types/logrocket-react": "^3.0.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.1",
    "graphql": "^17.0.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "relay-compiler": "^21.0.1",
    "relay-compiler-language-typescript": "^15.0.1",
    "relay-config": "^12.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
