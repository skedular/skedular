---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeSections from "../components/HomeSections.astro";
import CtaLink from "../components/CtaLink.astro";
import { getCta } from "../data/ctas";
import { homePage } from "../data/home-page";
import { getCanonicalUrl, siteUrl } from "../data/seo";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Skedular",
    url: siteUrl,
    logo: new URL("/images/skedular-logo-primary.svg", siteUrl).toString(),
    sameAs: ["https://www.linkedin.com/company/getskedular/"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Skedular",
    description: homePage.description,
    url: siteUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Skedular",
    description: homePage.description,
    brand: {
      "@type": "Brand",
      name: "Skedular",
    },
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: siteUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homePage.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: getCanonicalUrl("/"),
      },
    ],
  },
];
---

<SiteLayout title={homePage.title} description={homePage.description} canonicalPath="/" structuredData={structuredData}>
  <section class="hero">
    <div class="container hero-stage">
      <div class="hero-copy">
        <h1>{homePage.hero.title}</h1>
        <p class="hero-summary">{homePage.hero.summary}</p>
        <div class="button-row">
          <CtaLink cta={getCta(homePage.heroActions.primary)} />
          <CtaLink cta={getCta(homePage.heroActions.secondary)} variant="text" />
        </div>
      </div>

      <div class="hero-product-frame" aria-label="Skedular workspace booking and management overview">
        <div class="hero-product-toolbar">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="hero-product-shell">
          <div class="product-console">
            <div class="visual-toolbar">
              <div>
                <span class="visual-label">Workspace discovery</span>
                <strong>Skedular</strong>
              </div>
              <span class="availability-dot">Live booking</span>
            </div>
            <div class="product-console-grid">
              <a href="#workspace-discovery" class="console-tile console-tile-active">
                <span>Find workspace</span>
                <strong>Search desks and rooms</strong>
              </a>
              <a href="/teams" class="console-tile">
                <span>Manage workplace</span>
                <strong>Coordinate hybrid work</strong>
              </a>
              <a href="/spaces" class="console-tile">
                <span>Run business</span>
                <strong>Sell space & subscriptions</strong>
              </a>
            </div>
          </div>
          <div class="hero-calendar">
            <div class="calendar-line calendar-line-strong"></div>
            <div class="calendar-grid">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
          <div class="hero-insight">
            <span>Platform coverage</span>
            <strong>Booking to billing</strong>
            <p>Maps, floor plans, payments, invoices, Xero, Slack, Microsoft Teams</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Who Skedular is for">
    <div class="container trust-inner">
      <p>{homePage.trustStatement}</p>
      <div>
        {homePage.trustSignals.map((signal) => <span>{signal}</span>)}
      </div>
    </div>
  </section>

  <HomeSections />

</SiteLayout>
