---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeSections from "../components/HomeSections.astro";
import Sections from "../components/Sections.astro";
import CtaLink from "../components/CtaLink.astro";
import { getCta } from "../data/ctas";
import { homePage } from "../data/home-page";
---

<SiteLayout title={homePage.title} description={homePage.description} canonicalPath="/">
  <section class="hero">
    <div class="container hero-stage">
      <div class="hero-copy">
        <p class="eyebrow">{homePage.hero.eyebrow}</p>
        <h1>{homePage.hero.title}</h1>
        <p class="hero-summary">{homePage.hero.summary}</p>
        <div class="button-row">
          <a class="button" href="#products">Explore products</a>
          <CtaLink cta={getCta("book-demo")} variant="text" />
        </div>
      </div>

      <div class="hero-product-frame" aria-label="Skedular product overview">
        <div class="hero-product-toolbar">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="hero-product-shell">
          <div class="product-console">
            <div class="visual-toolbar">
              <div>
                <span class="visual-label">Workspace platform</span>
                <strong>Skedular</strong>
              </div>
              <span class="availability-dot">Live paths</span>
            </div>
            <div class="product-console-grid">
              <a href="/teams" class="console-tile console-tile-active">
                <span>Teams</span>
                <strong>Manage offices</strong>
              </a>
              <a href="/spaces" class="console-tile">
                <span>Spaces</span>
                <strong>Run inventory</strong>
              </a>
            </div>
          </div>
          <div class="hero-calendar">
            <div class="calendar-line calendar-line-strong"></div>
            <div class="calendar-grid">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
          <div class="hero-insight">
            <span>Today</span>
            <strong>42 bookings</strong>
            <p>Rooms, desks, offices, parking</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <Sections
    eyebrow="Products"
    title="Choose the Skedular product that matches your job"
    body="Each product path explains one part of the platform so visitors can quickly find the version that fits their organization."
    variant="quiet"
  >
    <div id="products">
      <HomeSections />
    </div>
  </Sections>

</SiteLayout>
