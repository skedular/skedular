---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CtaLink from "../../components/CtaLink.astro";
import { getCta } from "../../data/ctas";
import { aiEducationalContent } from "../../data/ai-educational-content";

export function getStaticPaths() {
  return aiEducationalContent.map((page) => ({
    params: { slug: page.path.split("/").pop() },
    props: { page },
  }));
}

const { page } = Astro.props;
const pageTitle = page!.title;
const pageDescription = page!.description;
const pagePath = page!.path;
const educationalType = page!.educationalType;
---

<SiteLayout title={pageTitle} description={pageDescription} canonicalPath={pagePath} structuredDataType={undefined}>
  <>
      <section class="subpage-hero">
        <div class="container">
          <p class="eyebrow">Educational Content</p>
          <h1>{pageTitle}</h1>
          <p>{pageDescription}</p>
          <CtaLink cta={getCta("book-demo")} />
        </div>
      </section>

      <section class="page-section" aria-labelledby="overview-title">
        <div class="container">
          {educationalType === 'definition' && (
            <>
              <h2 id="overview-title">What is this?</h2>
              <p>{pageDescription}</p>
              
              <h3>Key Features</h3>
              <ul>
                <li>Real-time availability and booking</li>
                <li>Multiple workspace types supported</li>
                <li>Hybrid team coordination tools</li>
              </ul>
            </>
          )}
          
        </div>
      </section>

      <section class="page-section page-section-quiet" aria-labelledby="next-steps-title">
        <div class="container">
          <h2 id="next-steps-title">Next Steps</h2>
          <p>Ready to try {educationalType === 'definition' ? 'workspace management software' : 'this feature'}?</p>
          <CtaLink cta={getCta("book-demo")} variant="inverse" />
        </div>
      </section>
  </>
</SiteLayout>
