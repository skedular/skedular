---
import ProductPageSections from "../components/ProductPageSections.astro";
import { teamsPage } from "../data/teams-page";
import { getPublicDestinationUrl } from "../data/public-destination-urls";
import SiteLayout from "../layouts/SiteLayout.astro";

const teamsAppUrl = getPublicDestinationUrl("PUBLIC_SKEDULAR_TEAMS_APP_URL");
---

<SiteLayout
  title="Skedular Teams | Private workplace management"
  description="Desk booking, room booking, parking, attendance, floor plans, analytics, Slack, Microsoft Teams, and enterprise identity for private workplaces."
  canonicalPath="/teams"
  structuredDataType="Product"
>
  <section class="subpage-hero">
    <div class="container teams-page-hero">
      {teamsPage.eyebrow && <p class="eyebrow">{teamsPage.eyebrow}</p>}
      {
        teamsPage.heroHeading ? (
          <>
            <h1>{teamsPage.heroHeading}</h1>
            <p>{teamsPage.heroDescription || teamsPage.summary}</p>
          </>
        ) : (
          <>
            <h1>{teamsPage.title}</h1>
            <p>{teamsPage.summary}</p>
          </>
        )
      }
      <div class="button-row">
        <a href={teamsAppUrl} class="button" data-cta-id="try-teams">Try Teams</a>
        <a href="/pricing/teams" class="text-link">View Teams pricing</a>
      </div>
    </div>
  </section>
  <ProductPageSections page={teamsPage} />
</SiteLayout>
