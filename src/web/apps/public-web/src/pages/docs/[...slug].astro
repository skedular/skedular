---
import { getCollection, render } from "astro:content";
import DocumentationArticle from "../../components/DocumentationArticle.astro";
import DocumentationCardGrid from "../../components/DocumentationCardGrid.astro";
import DocumentationSectionLanding from "../../components/DocumentationSectionLanding.astro";
import DocumentationLayout from "../../components/DocumentationLayout.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { documentationArticles, documentationCategories, documentationProducts, getProductCategories, getCategoryPath, getDocumentationPath, getProductPath, publishedDocumentationArticles, withdrawnDocumentationArticles, type DocumentationArticle as Article, validateDocumentationCatalog } from "../../data/documentation";

const errors = validateDocumentationCatalog();
if (errors.length) throw new Error(`Documentation catalog validation failed:\n${errors.join("\n")}`);
const docs = await getCollection("docs");
const docsById = new Map(docs.map((entry: (typeof docs)[number]) => [entry.data.id, entry]));

export async function getStaticPaths() {
  return [
    ...documentationProducts.map((product) => ({ params: { slug: product }, props: { type: "product", product } })),
    ...documentationProducts.flatMap((product) => getProductCategories(product).filter((item) => !(product === "teams" && ["getting-started", "bookings", "faqs", "best-practices"].includes(item.id)) && !(product === "spaces" && item.id === "customers") && !(product === "host" && ["best-practices", "payments-and-refunds", "managing-your-listing"].includes(item.id))).map((item) => ({ params: { slug: `${product}/${item.id}` }, props: { type: "category", product, category: item.id } }))),
    ...documentationCategories.filter((item) => item.product === "shared").map((item) => ({ params: { slug: `shared/${item.id}` }, props: { type: "category", product: "shared", category: item.id } })),
    ...[...publishedDocumentationArticles, ...withdrawnDocumentationArticles].map((item) => ({ params: { slug: item.publicationState === "published" && item.id === "host-get-started" ? "host/getting-started" : item.publicationState === "published" && item.id === "host-places" ? "host/your-place" : item.publicationState === "published" && (item.id === "host-pricing" || item.id === "host-availability" || item.id === "host-cancellation") ? "host/pricing-and-availability" : item.publicationState === "published" && item.id === "host-bookings" ? "host/bookings-and-renters" : item.publicationState === "published" && item.id === "host-payments" ? "host/payments-and-refunds" : item.publicationState === "published" && item.id === "host-media" ? "host/managing-your-listing" : item.publicationState === "published" && item.id === "host-faq" ? "host/faqs" : item.publicationState === "published" && item.id === "host-operations" ? "host/best-practices" : item.id === "teams-get-started" ? "teams/getting-started" : item.id === "teams-private-bookings" ? "teams/bookings" : item.id === "teams-faq" ? "teams/faqs" : item.id === "teams-best-practices" ? "teams/best-practices" : item.id === "spaces-get-started" ? "spaces/getting-started" : item.id === "spaces-bookings" ? "spaces/bookings" : item.id === "spaces-faq" ? "spaces/faqs" : item.id === "spaces-operations" ? "spaces/best-practices" : item.id === "spaces-analytics" ? "spaces/analytics" : item.id === "spaces-locations-resources" ? "spaces/workspace-setup/locations-and-resources" : item.id === "spaces-zones-floor-plans" ? "spaces/workspace-setup/zones-and-floor-plans" : item.id === "spaces-marketplace-setup" ? "spaces/products-and-marketplace/marketplace-setup" : item.id === "spaces-products-pricing" ? "spaces/products-and-marketplace/products-and-pricing" : item.id === "spaces-marketplace-publishing" ? "spaces/products-and-marketplace/marketplace-publishing" : item.id === "spaces-bank-payments" ? "spaces/billing-and-payments/payment-methods" : item.id === "spaces-refunds" ? "spaces/billing-and-payments/refunds" : item.id === "spaces-xero" ? "spaces/billing-and-payments/xero-accounting" : `${item.product}/${item.category}/${item.slug}` }, props: { type: "article", articleId: item.id } })),
  ];
}

const { type, product, category, articleId } = Astro.props;
const productNames = { teams: "Skedular Teams", spaces: "Skedular Spaces", host: "Skedular Host", shared: "Core Concepts" } as const;
const categoryLabel = (productName: string | undefined, categoryName: string) => productName === "spaces" && categoryName === "core-features" ? "Products and marketplace" : productName === "spaces" && categoryName === "settings" ? "Billing and payments" : documentationCategories.find((item) => item.product === productName && item.id === categoryName)?.label ?? categoryName;
const article = (type === "article" ? documentationArticles.find((item) => item.id === articleId) : undefined) as Article | undefined;
if (type !== "product" && type !== "category" && !article) Astro.response.status = 404;
const entry = article ? docsById.get(article.id) : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const articleRelated: Article[] = article ? article.relatedArticleIds.map((id) => documentationArticles.find((item) => item.id === id)).filter((item): item is Article => item !== undefined) : [];
const articleCategory = article ? publishedDocumentationArticles.filter((item) => item.product === article.product && item.category === article.category) : [];
const articleIndex = article ? articleCategory.findIndex((item) => item.id === article.id) : -1;
const articleProduct = article?.product === "shared" ? undefined : article?.product;
const articleCategoryPath = article?.id === "spaces-refunds" ? "/docs/spaces/billing-and-payments" : article ? getCategoryPath(article.product, article.category) : "/docs";
const pageTitle = article?.id === "shared-concepts" ? "Understanding Skedular | Core Concepts | Skedular Documentation" : article?.id === "teams-best-practices" ? "Best Practices | Skedular Teams documentation" : article?.id === "spaces-operations" ? "Best Practices | Skedular Spaces documentation" : article ? `${article.title} | Skedular Documentation` : "Documentation";
const breadcrumbs = article
  ? [{ name: "Documentation", path: "/docs" }, ...(articleProduct ? [{ name: productNames[articleProduct], path: getProductPath(articleProduct) }, { name: article.id === "spaces-refunds" ? "Billing and payments" : categoryLabel(article.product, article.category), path: articleCategoryPath }] : [{ name: article.category === "administration" ? "Administration" : article.category === "marketplace" ? "Marketplace" : article.category === "commerce" ? "Commerce" : article.category === "insights" ? "Insights" : "Core Concepts", path: getCategoryPath("shared", article.category === "administration" ? "administration" : article.category === "marketplace" ? "marketplace" : article.category === "commerce" ? "commerce" : article.category === "insights" ? "insights" : "core-concepts") }]), ...(article.id === "teams-get-started" || article.id === "teams-private-bookings" || article.id === "teams-faq" || article.id === "teams-best-practices" || article.id === "spaces-get-started" || article.id === "spaces-bookings" || article.id === "spaces-subscriptions" || article.id === "spaces-analytics" || article.id === "spaces-faq" || article.id === "spaces-operations" || article.id === "host-get-started" || article.id === "host-places" || article.id === "host-pricing" || article.id === "host-bookings" || article.id === "host-payments" || article.id === "host-media" || article.id === "host-faq" || article.id === "host-operations" ? [] : [{ name: article.title, path: getDocumentationPath(article) }])]
  : product === "shared" && ["administration", "marketplace", "commerce", "insights"].includes(category)
    ? [{ name: "Documentation", path: "/docs" }, { name: documentationCategories.find((item) => item.product === "shared" && item.id === category)?.label ?? "Section", path: getCategoryPath("shared", category) }]
    : [{ name: "Documentation", path: "/docs" }, { name: productNames[product as keyof typeof productNames], path: type === "product" ? "" : getProductPath(product) }, ...(type === "category" ? [{ name: categoryLabel(product, category), path: getCategoryPath(product, category) }] : [])];
---
{type === "product" && <SiteLayout bodyClass="documentation-page" title={`${productNames[product as keyof typeof productNames]} Documentation | Skedular`} description={product === "teams" ? "Learn how to set up and use Skedular Teams to manage workplace Locations, Resources, Bookings, teams, floor plans, and integrations." : `Guides for ${productNames[product as keyof typeof productNames]}.`} canonicalPath={getProductPath(product)} structuredDataType="BreadcrumbList" breadcrumbs={breadcrumbs}>
  <DocumentationLayout breadcrumbs={breadcrumbs} product={product}><section class="documentation-hero"><h1>{productNames[product as keyof typeof productNames]}</h1><p class="lead">{product === "host" ? "Skedular Host gives you a simple way to make an entire place available for booking. Set up your place, choose when it is available and what it costs, then manage bookings and payments without setting up individual desks, rooms, or other bookable resources." : product === "teams" ? "Learn how to set up and manage your private workplace with Skedular Teams, from organizing Locations and Resources to managing Bookings, Teams, floor plans, and integrations." : "Start with the essentials, then use only the sections that belong to this product."}</p></section>{product === "teams" && <section class="documentation-section-landing" aria-labelledby="teams-overview"><h2 id="teams-overview">Overview</h2><p>Skedular Teams helps Organizations manage private workplaces and coordinate how people use shared Resources. This documentation explains the concepts and workflows Teams users need to organize Locations, Resources, Teams, and Bookings.</p><p>Start with Getting Started, then use Workplace Setup, Bookings, Integrations, FAQs, and Best Practices as you roll out Skedular Teams.</p></section>}{product === "host" ? <DocumentationCardGrid items={[{ title: "Getting Started", description: "Set up and publish your first place.", href: "/docs/host/getting-started" }, { title: "Your place", description: "Keep the place details, location, images, features, and amenities that renters see up to date.", href: "/docs/host/your-place" }, { title: "Pricing and availability", description: "Set prices, booking availability, rules, and cancellation policies for the place.", href: "/docs/host/pricing-and-availability" }, { title: "Bookings and renters", description: "View and manage bookings and understand who has booked your place.", href: "/docs/host/bookings-and-renters" }, { title: "Payments and refunds", description: "Connect payments and manage payment, cancellation, and refund workflows.", href: "/docs/host/payments-and-refunds" }, { title: "Managing your listing", description: "Keep your place information, availability, pricing, and public listing current.", href: "/docs/host/managing-your-listing" }, { title: "FAQs", description: "Find concise answers to common Skedular Host questions.", href: "/docs/host/faqs" }, { title: "Best Practices", description: "Apply practical guidance for creating a clear listing and operating it reliably.", href: "/docs/host/best-practices" }]} /> : <DocumentationCardGrid items={getProductCategories(product).map((item) => ({ title: item.label, description: product === "teams" ? ({ "getting-started": "Set up the essentials and complete your first workplace Booking.", "workplace-setup": "Configure Locations, bookable Resources, people, and workspace organization in a private workplace.", bookings: "Find, create, and manage workplace Bookings for shared Resources.", integrations: "Connect Skedular Teams with Slack and Microsoft Teams to bring workplace Booking into the tools your teams already use.", faqs: "Find concise answers to common Skedular Teams questions and workflow issues.", "best-practices": "Apply practical guidance for configuring and rolling out Skedular Teams." } as Record<string, string>)[item.id] : item.description, href: getCategoryPath(product, item.id) }))} />}</DocumentationLayout>
</SiteLayout>}
{type === "category" && <SiteLayout bodyClass="documentation-page" title={product === "shared" && ["administration", "marketplace", "commerce", "insights"].includes(category) ? `${documentationCategories.find((item) => item.product === "shared" && item.id === category)?.label} | Skedular Documentation` : `${documentationCategories.find((item) => item.product === product && item.id === category)?.label} | ${product === "shared" ? "Skedular concepts" : productNames[product as keyof typeof productNames]} documentation`} description={product === "shared" && category === "administration" ? "Learn how to configure organization-level settings and administration options across Skedular." : product === "shared" && category === "marketplace" ? "Learn how Skedular Spaces operators create Products, manage customers, and handle recurring marketplace access." : product === "shared" && category === "commerce" ? "Understand how Skedular handles payments, billing, invoices, payouts, and financial integrations for commercial workspace activity." : product === "shared" && category === "insights" ? "Understand how Skedular turns Booking activity into occupancy and Resource availability information for Locations." : "Browse canonical Skedular concepts and product guidance."} canonicalPath={getCategoryPath(product, category)} structuredDataType="BreadcrumbList" breadcrumbs={breadcrumbs}>
  <DocumentationLayout breadcrumbs={breadcrumbs} product={product === "shared" ? undefined : product} category={category} shared={product === "shared"}>
    {product === "shared" && category === "administration" ? <DocumentationSectionLanding title="Administration" description="Configure the organization-level settings and operational rules that shape how Skedular works for your organization." overview="Administration covers the settings and configuration managed at the Organization level. These settings control how Skedular is configured and how shared workflows behave across the Organization. This section is primarily intended for Organization owners and administrators." pages={publishedDocumentationArticles.filter((item) => item.product === "shared" && item.category === "administration").map((item) => ({ title: item.title, description: "Manage organization-wide settings that control how your Skedular environment is configured and operates.", href: getDocumentationPath(item) }))} recommended={{ title: "Organization Settings", description: "Start here to understand the settings that apply across your Organization.", href: "/docs/shared/administration/organization-settings" }} related={[{ title: "Core Concepts", description: "Understand the Organizations, Locations, Resources, and Bookings that Administration configures.", href: "/docs/shared/core-concepts" }, { title: "Organizations", description: "Learn how Organization ownership, membership, and structure work.", href: "/docs/shared/core-concepts/organizations" }, { title: "Locations", description: "Learn where Resources exist and where location-level configuration applies.", href: "/docs/shared/core-concepts/locations" }]} /> : product === "shared" && category === "marketplace" ? <DocumentationSectionLanding title="Marketplace" description="Manage how workspace is packaged, offered, and accessed by customers in Skedular Spaces." overview="Marketplace documentation explains how Skedular Spaces operators turn Resources into customer-facing Products, manage Customers, and handle recurring access created through marketplace Products." orientationHeading="Looking for payments, billing, or payouts?" orientationContent={'Marketplace explains what customers can book and purchase. Commerce explains how those transactions are paid, billed, and settled. See <a href="/docs/shared/commerce">Commerce</a> for payment, billing, payout, and accounting guidance.'} pages={publishedDocumentationArticles.filter((item) => item.product === "shared" && item.category === "marketplace").map((item) => ({ title: item.title, description: item.description, href: getDocumentationPath(item) }))} related={[{ title: "Core Concepts", description: "Understand the Resources, Bookings, and shared concepts that marketplace workflows build on.", href: "/docs/shared/core-concepts" }, { title: "Commerce", description: "Learn how marketplace transactions are paid, billed, invoiced, and settled.", href: "/docs/shared/commerce" }, { title: "Skedular Spaces", description: "Learn how workspace operators use Skedular Spaces to manage and sell bookable workspace.", href: "/docs/spaces" }]} /> : product === "shared" && category === "commerce" ? <DocumentationSectionLanding title="Commerce" description="Understand how Skedular handles billing, payments, invoices, payouts, and financial integrations for commercial workspace activity." overview="Commerce handles the financial activity created by marketplace access. It covers the financial records, billing rules, payment paths, and integrations associated with Products, Bookings, and Subscriptions." pages={publishedDocumentationArticles.filter((item) => item.product === "shared" && item.category === "commerce").map((item) => ({ title: item.title, description: item.id === "shared-payments" ? "Understand payment methods, payment status, confirmation, and pending or failed payments." : "Understand billing schedules, upfront and arrears billing, invoice timing, and how operators receive funds.", href: getDocumentationPath(item) }))} related={[{ title: "Marketplace", description: "Understand how Products, Customers, and Subscriptions create commercial activity.", href: "/docs/shared/marketplace" }, { title: "Products", description: "Understand the Products and Prices that define commercial access.", href: "/docs/shared/marketplace/products" }, { title: "Bookings", description: "Understand the Resource reservations connected to commercial activity.", href: "/docs/shared/core-concepts/bookings" }, { title: "Subscriptions", description: "Understand recurring customer access and renewal.", href: "/docs/shared/marketplace/subscriptions" }, { title: "Organizations", description: "Understand the Organization that owns marketplace and Commerce configuration.", href: "/docs/shared/core-concepts/organizations" }]} /> : product === "shared" && category === "insights" ? <DocumentationSectionLanding title="Insights" description="Understand Booking activity, Resource occupancy, and Resource availability across your Locations." overview="Insights is the broader area for understanding operational data in Skedular. It uses existing Booking activity, with Resources and Locations providing context, so organizations can understand Booking activity, occupancy, and Resource availability over time. Insights does not change Booking or Availability data." pages={publishedDocumentationArticles.filter((item) => item.product === "shared" && item.category === "insights").map((item) => ({ title: item.title, description: "Explore Booking activity, Resource occupancy, and availability across your Locations.", href: getDocumentationPath(item) }))} related={[{ title: "Bookings", description: "Understand the activity that provides the basis for Analytics.", href: "/docs/shared/core-concepts/bookings" }, { title: "Resources", description: "Understand the bookable entities measured by Analytics.", href: "/docs/shared/core-concepts/resources" }, { title: "Locations", description: "Understand how Resources are organized within Locations.", href: "/docs/shared/core-concepts/locations" }, { title: "Availability", description: "Understand whether Resources can be booked at a selected time.", href: "/docs/shared/core-concepts/availability" }]} /> : <><h1>{documentationCategories.find((item) => item.product === product && item.id === category)?.label}</h1>{product === "teams" && category === "workplace-setup" && <p class="documentation-section-intro">Learn how Skedular Teams administrators turn an Organization into a working private workplace by setting up bookable Resources, organizing the workspace, and inviting people.</p>}{product === "teams" && category === "integrations" && <p class="documentation-section-intro">Connect Skedular Teams with workplace collaboration tools and your organization's identity system. Choose the guide that matches the way your organization works.</p>}<DocumentationCardGrid items={publishedDocumentationArticles.filter((item) => item.product === product && item.category === category).map((item) => ({ title: item.title, description: product === "teams" && category === "integrations" ? ({ "teams-slack": "Connect your Slack workspace with Skedular Teams for workplace coordination.", "teams-microsoft-teams": "Access Skedular Teams from Microsoft Teams while you coordinate your workplace.", "teams-sso": "Use your organization's existing identity system for centrally managed sign-in." } as Record<string, string>)[item.id] : item.description, href: getDocumentationPath(item) }))} />{product === "teams" && category === "integrations" && <nav class="documentation-pagination" aria-label="Section navigation"><a href="/docs/teams/bookings">← Bookings</a><a href="/docs/teams/faqs">FAQs →</a></nav>}</>}
  </DocumentationLayout>
</SiteLayout>}
{article && <SiteLayout bodyClass="documentation-page" title={pageTitle} description={article.description} canonicalPath={getDocumentationPath(article)} structuredDataType="Article" breadcrumbs={breadcrumbs}>
  <DocumentationLayout breadcrumbs={breadcrumbs} product={articleProduct} category={article.id === "spaces-refunds" ? "billing-and-payments" : article.category} shared={article.product === "shared"} currentArticleId={article.id}>{article.publicationState === "withdrawn" ? <section class="documentation-article"><h1>This guide has been retired</h1><p>This address is no longer a live guide. Continue from the <a href={article.replacementArticleId ? getDocumentationPath(documentationArticles.find((item) => item.id === article.replacementArticleId) ?? article) : "/docs"}>most relevant available documentation</a>.</p></section> : <DocumentationArticle article={article} related={articleRelated} previous={articleCategory[articleIndex - 1]} next={articleCategory[articleIndex + 1]} previousOverride={article.id === "teams-get-started" ? { title: "Skedular Teams", href: "/docs/teams" } : article.id === "teams-best-practices" ? { title: "FAQs", href: "/docs/teams/faqs" } : article.id === "shared-products" ? { title: "Marketplace", href: "/docs/shared/marketplace" } : article.id === "shared-payments" ? { title: "Commerce", href: "/docs/shared/commerce" } : article.id === "shared-analytics" ? { title: "Insights", href: "/docs/shared/insights" } : undefined}>{Content ? <Content /> : <><h2>What this guide covers</h2><p>{article.description}</p><h2>Next step</h2><p>Use the related guidance or return to the product area to continue with the workflow that applies to you.</p></>}</DocumentationArticle>}</DocumentationLayout>
</SiteLayout>}
{type !== "product" && type !== "category" && !article && <SiteLayout bodyClass="documentation-page" title="Documentation not found | Skedular" description="The requested documentation page is unavailable." canonicalPath="/docs"><div class="container"><h1>Documentation page not found</h1><p>Return to the <a href="/docs">Documentation home</a>.</p></div></SiteLayout>}
