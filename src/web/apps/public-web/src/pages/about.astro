---
import { aboutPage } from "../data/about-page";
import SiteLayout from "../layouts/SiteLayout.astro";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Skedular",
  "url": "https://getskedular.com",
  "logo": "https://getskedular.com/logo.png",
  "description": aboutPage.description,
  "founder": [
    {
      "@type": "Person",
      "name": "Leila Alavi"
    },
    {
      "@type": "Person",
      "name": "Morteza Alizadeh"
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Auckland",
    "addressCountry": "NZ"
  }
};
---

<SiteLayout title={aboutPage.title} description={aboutPage.description} canonicalPath={aboutPage.path} structuredDataType="Organization">
  <script type="application/ld+json">{JSON.stringify(structuredData)}</script>
  <section class="subpage-hero">
    <div class="container">
      <p class="eyebrow">{aboutPage.hero.eyebrow}</p>
      <h1>{aboutPage.hero.title}</h1>
      <p>{aboutPage.hero.summary}</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container company-layout">
      <div class="company-story">
        <p class="eyebrow">Our story</p>
        <h2>The Skedular journey so far</h2>
        <p>
          Before we started building software for workspaces, we spent years working in them. We saw the same problems everywhere: desks booked but not used, meeting rooms double-booked, operators spending hours on email coordination.
        </p>
        <p>
          The tools available either did too little or made things more complicated than they needed to be. So we started with a simple question: how do people actually work in shared spaces? and built from there.
        </p>
        <a class="button" href={`mailto:${aboutPage.contactEmail}`}>Contact Skedular</a>
      </div>
      <div class="company-facts">
        {
          aboutPage.facts.map((fact) => (
            <article class="fact-card">
              <span>{fact.label}</span>
              <strong>{fact.value}</strong>
              <p>{fact.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section-quiet">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Who we are</p>
        <h2>Founders who learned by doing</h2>
      </div>
      <div class="founders-grid">
        {
          aboutPage.founders.map((founder) => (
            <article class="content-card founder-card">
              <span>{founder.title}</span>
              <strong>{founder.name}</strong>
              <p>{founder.insight}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section-quiet">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Timeline</p>
        <h2>From UnityHub to Skedular</h2>
      </div>
      <div class="company-timeline">
        {
          aboutPage.timeline.map((item) => (
            <article class="timeline-item">
              <span>{item.year}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container section-inner">
      <div class="section-heading">
        <p class="eyebrow">How we build</p>
        <h2>Software for how people actually work</h2>
      </div>
      <div class="card-grid">
        {
          aboutPage.principles.map((principle) => (
            <article class="content-card">
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
