---
import SiteLayout from "../layouts/SiteLayout.astro";
import PricingSections from "../components/PricingSections.astro";
import { pricingPage } from "../data/pricing";
---

<SiteLayout title={pricingPage.title} description={pricingPage.description} canonicalPath="/pricing" structuredDataType="Product">
  <section class="subpage-hero">
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h1>Choose the Skedular product you need pricing for</h1>
      <p>
        Pick Teams or Spaces to see the pricing model that applies to that product. Each page keeps the options focused so buyers do not have to sort through unrelated plans.
      </p>
    </div>
  </section>
  <section class="page-section">
    <div class="container section-inner">
      <PricingSections />
    </div>
  </section>
</SiteLayout>
