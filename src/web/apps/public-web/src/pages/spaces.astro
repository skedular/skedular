---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductPageSections from "../components/ProductPageSections.astro";
import CtaLink from "../components/CtaLink.astro";
import { getCta } from "../data/ctas";
import { spacesPage } from "../data/spaces-page";
---

<SiteLayout
  title="Skedular Spaces | Workspace operator management"
  description="Manage workspace inventory, products, payments, billing, invoicing, tax, marketplace publishing, and branding."
  canonicalPath="/spaces"
  structuredDataType="Product"
>
  <section class="subpage-hero">
    <div class="container">
      <p class="eyebrow">{spacesPage.eyebrow}</p>
      <h1>{spacesPage.title}</h1>
      <p>{spacesPage.summary}</p>
      <div class="button-row">
        <CtaLink cta={getCta("contact-sales")} />
        <a class="text-link" href="/pricing/spaces">View Spaces pricing</a>
      </div>
    </div>
  </section>
  <section class="page-section">
    <div class="container section-inner">
      <ProductPageSections page={spacesPage} />
    </div>
  </section>
</SiteLayout>
