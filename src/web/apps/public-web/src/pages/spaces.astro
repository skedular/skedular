---
import ProductPageSections from "../components/ProductPageSections.astro";
import { spacesPage } from "../data/spaces-page";
import { getPublicDestinationUrl } from "../data/public-destination-urls";
import SiteLayout from "../layouts/SiteLayout.astro";

const spacesAppUrl = getPublicDestinationUrl("PUBLIC_SKEDULAR_SPACES_APP_URL");
---

<SiteLayout
  title="Skedular Spaces | Workspace operator management"
  description="Manage workspace inventory, products, payments, billing, invoicing, tax, marketplace publishing, and branding."
  canonicalPath="/spaces"
  structuredDataType="Product"
>
  <section class="subpage-hero">
    <div class="container">
      {spacesPage.eyebrow && <p class="eyebrow">{spacesPage.eyebrow}</p>}
      {
        spacesPage.heroHeading ? (
          <>
            <h1>{spacesPage.heroHeading}</h1>
            <p>{spacesPage.heroDescription || spacesPage.summary}</p>
          </>
        ) : (
          <>
            <h1>{spacesPage.title}</h1>
            <p>{spacesPage.summary}</p>
          </>
        )
      }
      <div class="button-row">
        <a href={spacesAppUrl} class="button" data-cta-id="try-spaces">Try Spaces</a>
        <a href="/pricing/spaces" class="text-link">View Spaces pricing</a>
      </div>
    </div>
  </section>
  <ProductPageSections page={spacesPage} />
</SiteLayout>
