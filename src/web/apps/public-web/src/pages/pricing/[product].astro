---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PricingSections from "../../components/PricingSections.astro";
import { pricingPage } from "../../data/pricing";
import { getCanonicalUrl } from "../../data/seo";

export function getStaticPaths() {
  return pricingPage.models
    .filter((model) => model.id === "teams" || model.id === "spaces" || model.id === "host")
    .map((model) => ({
      params: { product: model.id },
      props: { model },
    }));
}

const { model } = Astro.props;
const title = model.seoTitle;
const description = model.seoDescription;
const canonicalPath = `/pricing/${model.id}`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: title,
    description,
    brand: {
      "@type": "Brand",
      name: "Skedular",
    },
    url: getCanonicalUrl(canonicalPath),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: model.faq.map((item: { question: string; answer: string }) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: getCanonicalUrl("/"),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Pricing",
        item: getCanonicalUrl("/pricing"),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: `${model.name} pricing`,
        item: getCanonicalUrl(canonicalPath),
      },
    ],
  },
];
---

<SiteLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>
  <section class="subpage-hero">
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h1>{model.headline}</h1>
      <p>{model.intro}</p>
    </div>
  </section>
  <section class="page-section">
    <div class="container section-inner">
      <PricingSections productId={model.id} />
    </div>
  </section>
</SiteLayout>
