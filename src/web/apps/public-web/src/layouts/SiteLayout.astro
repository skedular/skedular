---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import StructuredData from "../components/StructuredData.astro";
import { ctas } from "../data/ctas";
import { getPublicDestinationUrl } from "../data/public-destination-urls";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  structuredDataType?: "Organization" | "Product" | "FAQPage" | "BreadcrumbList" | "Article";
}

const { title, description, canonicalPath, structuredDataType = "Organization" } = Astro.props;

const demoCta = ctas.find((cta) => cta.id === "book-demo");
const loginCta = ctas.find((cta) => cta.id === "login");
const becomeHostCta = ctas.find((cta) => cta.id === "become-host");
const demoUrl = getPublicDestinationUrl("PUBLIC_SKEDULAR_DEMO_URL");
const loginUrl = getPublicDestinationUrl("PUBLIC_SKEDULAR_SIGNUP_URL");
const becomeHostUrl = getPublicDestinationUrl("PUBLIC_SKEDULAR_BECOME_HOST_URL");
const productLinks = [
  {
    label: "Skedular Teams",
    path: "/teams",
    description: "For organizations managing private workplaces",
  },
  {
    label: "Skedular Spaces",
    path: "/spaces",
    description: "For operators running and selling workspace",
  },
];
const resourceLinks = [
  {
    label: "Blog",
    path: "/blog",
    description: "Workspace planning, booking, operations, payments, and product guidance",
  },
];
const mainLinks = [
  { label: "About", path: "/company" },
  { label: "Pricing", path: "/pricing" },
];
const legalLinks = [
  { label: "Terms", path: "/terms-of-service" },
  { label: "Privacy", path: "/privacy-policy" },
];
const supportLinks = [
  { label: "Support", path: "/support" },
  { label: "Feature overview", path: "/features/resource-booking" },
  { label: "Compare", path: "/compare/skedular-vs-skedda" },
];
const integrationLinks = [
  { label: "Slack", path: "https://slack.com/" },
  { label: "Microsoft Teams", path: "https://www.microsoft.com/en-us/microsoft-teams/download-app" },
];
const socialLinks = [
  {
    label: "LinkedIn",
    path: "https://www.linkedin.com/company/getskedular/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: "Facebook",
    path: "https://www.facebook.com/profile.php?id=61571588471440",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    label: "Discord",
    path: "https://discord.gg/kBczX24y",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`,
  },
  {
    label: "BetaList",
    path: "https://betalist.com/startups/skedular?utm_campaign=badge-skedular&utm_medium=badge&utm_source=badge-featured",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonicalPath={canonicalPath} />
    <StructuredData type={structuredDataType} name={title} description={description} path={canonicalPath} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="header-left">
          <a class="brand-link" href="/" aria-label="Skedular home">
            <img src="/images/skedular-logo-inverse.svg" alt="Skedular" width="156" height="33" />
          </a>
          <nav class="primary-nav" aria-label="Primary navigation">
            <details class="nav-menu">
              <summary>Products</summary>
              <div class="nav-menu-panel">
                {
                  productLinks.map((item) => (
                    <a href={item.path}>
                      <strong>{item.label}</strong>
                      <span>{item.description}</span>
                    </a>
                  ))
                }
              </div>
            </details>
            <details class="nav-menu">
              <summary>Resources</summary>
              <div class="nav-menu-panel nav-menu-panel-small">
                {
                  resourceLinks.map((item) => (
                    <a href={item.path}>
                      <strong>{item.label}</strong>
                      <span>{item.description}</span>
                    </a>
                  ))
                }
              </div>
            </details>
            {mainLinks.map((item) => <a href={item.path}>{item.label}</a>)}
          </nav>
        </div>
        <div class="header-actions">
          {becomeHostCta && <a class="text-link" href={becomeHostUrl} data-cta-id={becomeHostCta.id}>{becomeHostCta.label}</a>}
          {loginCta && <a class="text-link" href={loginUrl} data-cta-id={loginCta.id}>{loginCta.label}</a>}
          {demoCta && <a class="button button-small" href={demoUrl} data-cta-id={demoCta.id}>{demoCta.label}</a>}
        </div>
        <details class="mobile-nav">
          <summary aria-label="Open navigation">
            <span class="sr-only">Menu</span>
            <span class="hamburger-icon" aria-hidden="true"></span>
          </summary>
          <div class="mobile-nav-panel">
            <div>
              <strong>Products</strong>
              {productLinks.map((item) => <a href={item.path}>{item.label}</a>)}
            </div>
            <div>
              <strong>Resources</strong>
              {resourceLinks.map((item) => <a href={item.path}>{item.label}</a>)}
            </div>
            <div>
              <strong>Company</strong>
              {mainLinks.map((item) => <a href={item.path}>{item.label}</a>)}
            </div>
            <div class="mobile-nav-actions">
              {becomeHostCta && <a class="text-link" href={becomeHostUrl} data-cta-id={becomeHostCta.id}>{becomeHostCta.label}</a>}
              {loginCta && <a class="text-link" href={loginUrl} data-cta-id={loginCta.id}>{loginCta.label}</a>}
              {demoCta && <a class="button" href={demoUrl} data-cta-id={demoCta.id}>{demoCta.label}</a>}
            </div>
          </div>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img src="/images/skedular-logo-inverse.svg" alt="Skedular" width="132" height="28" />
          <p>Workspace discovery and workspace operations for modern teams and operators.</p>
          <a href="mailto:support@getskedular.com">support@getskedular.com</a>
        </div>

        <nav class="footer-column" aria-label="Get started">
          <h2>Get Started</h2>
          <a href={demoUrl} data-cta-id="book-demo">Book demo</a>
          <a href={loginUrl} data-cta-id="login">Login</a>
          <a href="/pricing">Pricing</a>
        </nav>

        <nav class="footer-column" aria-label="Product">
          <h2>Product</h2>
          {productLinks.map((item) => <a href={item.path}>{item.label}</a>)}
        </nav>

        <nav class="footer-column" aria-label="Resources and support">
          <h2>Resources</h2>
          {resourceLinks.map((item) => <a href={item.path}>{item.label}</a>)}
          {supportLinks.map((item) => <a href={item.path}>{item.label}</a>)}
        </nav>

        <nav class="footer-column" aria-label="Company">
          <h2>Company</h2>
          <a href="/company">About</a>
          {legalLinks.map((item) => <a href={item.path}>{item.label}</a>)}
        </nav>

        <nav class="footer-column" aria-label="Integrations">
          <h2>Integrations</h2>
          {integrationLinks.map((item) => <a href={item.path}>{item.label}</a>)}
        </nav>
      </div>
      <div class="container footer-bottom">
        <p>© Skedular. All rights reserved.</p>
        <nav class="footer-social" aria-label="Social and community links">
          {socialLinks.map((item) => <a class="footer-social-button" href={item.path} aria-label={item.label} title={item.label} set:html={item.icon} />)}
        </nav>
      </div>
    </footer>

    <script>
      const navMenus = Array.from(document.querySelectorAll<HTMLDetailsElement>(".primary-nav .nav-menu"));

      navMenus.forEach((menu) => {
        menu.addEventListener("toggle", () => {
          if (menu.open) {
            navMenus.forEach((other) => { if (other !== menu) other.open = false; });
          }
        });
      });

      document.addEventListener("click", (e) => {
        if (!navMenus.some((m) => m.contains(e.target as Node))) {
          navMenus.forEach((m) => { m.open = false; });
        }
      });
    </script>
  </body>
</html>
