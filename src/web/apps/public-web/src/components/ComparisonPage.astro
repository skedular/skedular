import { competitors, featureSupport, normalizedFeatures } from "../data/comparison";
import type { ComparisonPageTarget, ComparisonProduct, SupportState } from "../data/content-types";

interface Props {
  pageTarget: ComparisonPageTarget;
}

const { pageTarget } = Astro.props;

const competitor = competitors.find((product) => product.id === pageTarget.competitorId);

const featureIds = [
  "desk-booking",
  "room-booking",
  "floor-plans",
  "booking-rules",
  "resource-permissions",
  "member-management",
  "billing",
  "invoicing",
  "subscription-management",
  "stripe",
  "xero",
  "public-listings",
  "workspace-discovery",
  "slack",
  "teams",
  "sso",
  "custom-domains",
  "api",
];

const categoryLabels: Record<string, string> = {
  "workplace-management": "workplace management",
  "coworking-management": "coworking management",
  "hybrid-workplace": "hybrid workplace coordination",
  "workplace-operations": "workplace operations",
  "marketplace-workspace-network": "workspace marketplace and discovery",
};

const supportLabels: Record<SupportState, string> = {
  supported: "Supported",
  "partially-supported": "Partial Support",
  "not-supported": "Not Supported",
  unknown: "Needs review",
  "not-applicable": "Not Supported",
};

const supportClasses: Record<SupportState, string> = {
  supported: "comparison-support-supported",
  "partially-supported": "comparison-support-partial",
  "not-supported": "comparison-support-missing",
  unknown: "comparison-support-unknown",
  "not-applicable": "comparison-support-unknown",
};

const getSupport = (productId: string, featureId: string) =>
  featureSupport.find((support) => support.productId === productId && support.featureId === featureId);

const featureRows = featureIds
  .map((featureId) => {
    const feature = normalizedFeatures.find((item) => item.id === featureId);
    if (!feature) {
      return null;
    }

    const skedularSupport = getSupport("skedular", featureId);
    const competitorSupport = competitor ? getSupport(competitor.id, featureId) : undefined;

    return {
      feature,
      skedularState: skedularSupport?.state ?? "unknown",
      skedularNote: skedularSupport?.note,
      competitorState: competitorSupport?.state ?? "unknown",
      competitorNote: competitorSupport?.note,
    };
  })
  .filter(Boolean);

