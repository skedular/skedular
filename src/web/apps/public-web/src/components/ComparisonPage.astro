const competitorName = competitor?.name ?? "the alternative";
const competitorCategory = productFocus(competitor);
const isSkedda = competitor?.id === "skedda";
const isOfficeRnD = competitor?.id === "officernd";
const isNexudus = competitor?.id === "nexudus";
const isGable = competitor?.id === "gable";
const isRobin = competitor?.id === "robin";
const isOfficely = competitor?.id === "officely";
const isEnvoy = competitor?.id === "envoy";
const isKadence = competitor?.id === "kadence";
const isArchie = competitor?.id === "archie";
const isDiskbird = competitor?.id === "deskbird";
const visibleCompetitorUseCases = isSkedda
