---
interface Props {
  title: string;
  summary: string;
  items: string[];
}

const { title, summary, items } = Astro.props as Props;
---

<section class="feature-detail">
  <h2>{title}</h2>
  <p>{summary}</p>
  <ul class="check-list">
    {items.map((item: string) => <li>{item}</li>)}
  </ul>
</section>
