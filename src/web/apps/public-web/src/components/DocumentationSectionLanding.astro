---
import DocumentationCardGrid from "./DocumentationCardGrid.astro";
interface Props {
  title: string;
  description: string;
  overview: string;
  pages: Array<{ title: string; description: string; href: string; eyebrow?: string }>;
  recommended?: { title: string; description: string; href: string };
  related: Array<{ title: string; description: string; href: string }>;
  orientationHeading?: string;
  orientationContent?: string;
}
const { title, description, overview, pages, recommended, related, orientationHeading = "Choose the right starting point", orientationContent } = Astro.props;
const relatedItems = title === "Administration" ? related.map((item: Props["related"][number]) => item.title === "Availability" ? { title: "Locations", description: "Learn how Locations define where Resources exist and where location-level configuration applies.", href: "/docs/shared/core-concepts/locations" } : item) : related;
const defaultOrientationContent = title === "Insights" ? "Looking for explanations of Organizations, Locations, Resources, or Bookings? Start with <a href=\"/docs/shared/core-concepts\">Core Concepts</a>. This section focuses on understanding Booking activity, Resource occupancy, and availability." : "Looking for explanations of Organizations, Locations, Resources, or Bookings? Start with <a href=\"/docs/shared/core-concepts\">Core Concepts</a>. This section focuses on configuring how Skedular operates within an Organization.";
---
<section class="documentation-hero"><p class="eyebrow">Documentation section</p><h1>{title}</h1><p class="lead">{description}</p></section>
{title === "Commerce" && <div class="documentation-concept-support"><strong>Available in</strong><span>✅ Skedular Spaces</span></div>}
{title === "Insights" && <div class="documentation-concept-support"><strong>Available in</strong><span>✅ Skedular Teams</span><span>✅ Skedular Spaces</span><span>✅ Skedular Host</span></div>}
<section class="documentation-section-landing" aria-labelledby="section-overview"><h2 id="section-overview">Overview</h2><p>{overview}</p></section>
{title !== "Commerce" && <aside class="documentation-callout documentation-section-orientation" aria-label="Documentation orientation"><strong>{orientationHeading}</strong><p set:html={orientationContent ?? defaultOrientationContent}></p></aside>}
{title === "Insights" && <>
<aside class="documentation-callout" aria-label="Insights core rule"><strong>Core rule</strong><p>Bookings record operational activity; Insights helps organizations understand that activity.</p></aside>
<section class="documentation-section-landing" aria-labelledby="insights-works"><h2 id="insights-works">How Insights Works</h2><div class="documentation-organization-context" aria-label="Insights relationships"><div class="documentation-context-root"><div class="documentation-context-tree"><span>📅 Bookings provide operational activity</span><span>🪑 Resources provide the measured entities</span><span>📍 Locations provide context for grouping Resources</span></div><div class="documentation-context-child"><span>📊 Analytics aggregates and interprets activity</span><div class="documentation-context-child"><span>Booking, occupancy, and availability insights</span></div></div></div></div><p>Operational activity happens first. Analytics interprets Booking activity in its Resource and Location context; it does not change Bookings, Resources, or Availability.</p></section>
<section class="documentation-section-landing" aria-labelledby="insights-analytics"><h2 id="insights-analytics">Insights and Analytics</h2><div class="documentation-concept-grid"><div><strong>Insights</strong><small>The broader area for understanding operational data in Skedular.</small></div><div><strong>Analytics</strong><small>The current capability that turns Booking activity into Booking totals, occupancy, and Resource availability information.</small></div></div><p><strong>Availability</strong> answers whether a Resource can be booked. Insights helps explain Booking activity, occupancy, and Resource availability over time.</p></section>
<section class="documentation-section-landing" aria-labelledby="what-you-can-learn"><h2 id="what-you-can-learn">What You Can Learn</h2><ul><li>How many Bookings an Organization or Location has over a selected period.</li><li>How Resource availability differs across Locations.</li><li>Which Locations have higher or lower desk or room occupancy.</li><li>How Booking activity and Resource availability change over a selected period.</li></ul></section>
</>}
{title === "Commerce" && <>
<aside class="documentation-callout" aria-label="Commerce core rule"><strong>Core rule</strong><p>Marketplace defines what Customers purchase; Commerce handles how that activity is billed, paid, invoiced, and settled.</p></aside>
<section class="documentation-section-landing" aria-labelledby="commerce-flow"><h2 id="commerce-flow">How Commerce Fits Into Skedular</h2><div class="documentation-organization-context" aria-label="Commerce relationships"><div class="documentation-context-root">👤 Customer<div class="documentation-context-child"><span>🛒 Chooses Product + Price</span><div class="documentation-context-child"><span>📅 Booking or Subscription</span><div class="documentation-context-child"><span>💳 Creates financial activity handled by Commerce</span></div></div></div></div><div class="documentation-context-tree"><div><strong>Commerce</strong><div class="documentation-context-child"><span>Payments</span><span>Billing and Invoices</span><span>Payouts and Settlement</span><span>Payment Methods</span><span>Financial Integrations</span></div></div></div></div></section>
<section class="documentation-section-landing" aria-labelledby="marketplace-commerce"><h2 id="marketplace-commerce">Marketplace and Commerce</h2><div class="documentation-concept-grid"><div><strong>Marketplace</strong><small>Defines Products, Prices, Customers, Subscriptions, and the commercial access being sold.</small></div><div><strong>Commerce</strong><small>Handles billing, payments, invoices, payouts, and accounting or payment integrations.</small></div></div><p>Payment status and access status are related but separate. A Booking or Subscription can continue to exist while its associated financial activity is still being processed or requires further action.</p></section>
<section class="documentation-section-landing" aria-labelledby="commerce-handles"><h2 id="commerce-handles">What Commerce Handles</h2><div class="documentation-concept-grid"><div><strong>Payments</strong><small>Tracks payment methods, payment status, confirmation, and pending or failed payments.</small></div><div><strong>Billing</strong><small>Determines when charges become due according to the configured billing model.</small></div><div><strong>Invoices</strong><small>Records amounts due when the configured billing workflow requires an invoice.</small></div><div><strong>Payouts and Settlement</strong><small>Describes how funds reach the workspace operator through the payment path being used.</small></div><div><strong>Payment Methods</strong><small>Defines how Customers can pay, including card payment and bank transfer where configured.</small></div><div><strong>Financial Integrations</strong><small>Connects Commerce with providers such as Stripe and accounting systems such as Xero.</small></div></div></section>
</>}
<section aria-labelledby="browse-section"><h2 id="browse-section">Browse {title}</h2><DocumentationCardGrid items={pages} /></section>
{recommended && title !== "Administration" && <section class="documentation-section-recommended" aria-labelledby="recommended-section"><h2 id="recommended-section">Recommended Starting Point</h2><a class="documentation-card" href={recommended.href}><h3>{recommended.title}</h3><p>{recommended.description}</p><span>Read more <span aria-hidden="true">→</span></span></a></section>}
<section class="documentation-section-related" aria-labelledby="related-section"><h2 id="related-section">Related Documentation</h2><DocumentationCardGrid items={relatedItems} /></section>
