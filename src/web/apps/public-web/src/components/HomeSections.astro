---
import CtaLink from "./CtaLink.astro";
import { getCta } from "../data/ctas";
import { homePage } from "../data/home-page";
---

<section id="workspace-discovery" class="page-section workspace-discovery" aria-labelledby="workspace-discovery-title">
  <div class="container split-section">
    <div class="section-heading">
      <h2 id="workspace-discovery-title">{homePage.discovery.title}</h2>
      <p>{homePage.discovery.body}</p>
      <div class="category-row" aria-label="Bookable workspace types">
        {homePage.resourceCategories.map((category) => <span>{category}</span>)}
      </div>
    </div>

    <div class="workspace-visual discovery-visual" aria-label="Workspace discovery preview">
      <div class="discovery-map">
        <div class="map-canvas" aria-hidden="true">
          <span class="map-pin map-pin-one"></span>
          <span class="map-pin map-pin-two"></span>
          <span class="map-pin map-pin-three"></span>
        </div>
        <div class="listing-stack">
          {homePage.discovery.modules.map((module) => (
            <article>
              <h3>{module.title}</h3>
              <p>{module.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section page-section-quiet" aria-labelledby="audience-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="audience-title">{homePage.audience.title}</h2>
      <p>{homePage.audience.body}</p>
    </div>
    <div class="product-switcher" aria-label="Skedular audience paths">
      {homePage.audience.paths.map((path) => (
        <a class:list={["product-path", `product-path-${path.accent}`]} href={path.href}>
          <h3>{path.title}</h3>
          <p>{path.body}</p>
          <ul class="product-features">
            {path.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <strong>{path.ctaLabel}</strong>
        </a>
      ))}
    </div>
  </div>
</section>

<section id="built-for" class="page-section page-section-quiet built-for-section" aria-labelledby="built-for-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="built-for-title">{homePage.builtFor.title}</h2>
    </div>
    <div class="built-for-grid">
      {homePage.builtFor.items.map((item) => (
        <span class="built-for-chip" aria-label={item.label}>{item.label}</span>
      ))}
    </div>
  </div>
</section>

<section class="page-section" aria-labelledby="why-skedular-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="why-skedular-title">{homePage.whySkedular.title}</h2>
      <p>Skedular connects the daily experience of finding and booking space with the operational systems needed to manage and monetize it.</p>
    </div>
    <div class="feature-board-grid benefit-grid">
      {homePage.whySkedular.pillars.map((pillar) => (
        <article class="feature-board-card">
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="differentiation" class="page-section page-section-quiet differentiation-section" aria-labelledby="differentiation-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="differentiation-title">{homePage.differentiation.title}</h2>
      <p>{homePage.differentiation.subtitle}</p>
      {homePage.differentiation.supportingText && (
        <p>{homePage.differentiation.supportingText}</p>
      )}
    </div>
    <div class="feature-board-grid benefit-grid">
      {homePage.differentiation.pillars.map((pillar) => (
        <article class="feature-board-card">
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="page-section page-section-quiet" aria-labelledby="product-showcase-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="product-showcase-title">Solutions built around real workspace workflows.</h2>
      <p>Choose the workflow that matches your business - whether you're booking space, managing a workplace, or running a workspace business.</p>
    </div>
    <div class="showcase-stack" aria-label="Skedular product details">
      {
        homePage.productShowcases.map((showcase, index) => (
          <article class:list={["showcase-panel", index % 2 === 1 && "showcase-panel-reverse"]}>
            <div class="showcase-copy">
              <p class="eyebrow">{showcase.productName}</p>
              <h3>{showcase.title}</h3>
              <p>{showcase.body}</p>
              <a class="text-link" href={showcase.href}>
                {showcase.ctaLabel}
              </a>
            </div>
            <div class:list={["showcase-visual", `showcase-visual-${showcase.accent}`]} aria-label={`${showcase.visualTitle} preview`}>
              <div class="showcase-window workflow-window">
                <div class="showcase-window-header">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <strong>{showcase.visualTitle}</strong>
                <div class="workflow-steps">
                  {showcase.visualStats.map((stat) => (
                    <span>{stat}</span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="become-a-host" class="page-section page-section-quiet become-host-section" aria-labelledby="become-host-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="become-host-title">{homePage.becomeAHost.title}</h2>
      <p>{homePage.becomeAHost.subtitle}</p>
      {homePage.becomeAHost.supportingText && (
        <p>{homePage.becomeAHost.supportingText}</p>
      )}
      <a class="text-link" href={homePage.becomeAHost.href}>{homePage.becomeAHost.ctaLabel}</a>
    </div>
  </div>
</section>

<section class="page-section" aria-labelledby="features-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="features-title">{homePage.featureHighlights.title}</h2>
      <p>Key capabilities are surfaced directly so visitors can connect Skedular to the workflows they already recognize.</p>
    </div>
    <div class="feature-highlight-grid">
      {homePage.featureHighlights.groups.map((feature) => (
        <article class="feature-highlight-card">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="page-section customer-trust-section" aria-labelledby="customer-trust-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="customer-trust-title">{homePage.customerTrust.title}</h2>
      <p>{homePage.customerTrust.body}</p>
    </div>
    <h3 class="customer-logo-title">{homePage.customerTrust.logoHeading}</h3>
    <div class="customer-logo-wall" aria-label="Current Skedular clients">
      {
        homePage.customerTrust.customerLogos.map((logo) => (
          <span>
            <img src={logo.src} alt={logo.name} width={logo.width} height={logo.height} loading="lazy" />
          </span>
        ))
      }
    </div>
    {homePage.customerTrust.metrics.length > 0 && (
      <div class="metric-grid" aria-label="Customer metrics">
        {homePage.customerTrust.metrics.map((metric) => (
          <article>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </article>
        ))}
      </div>
    )}
    {homePage.customerTrust.testimonials.length > 0 && (
      <div class="testimonial-band" aria-label="Customer testimonials">
        {
          homePage.customerTrust.testimonials.map((testimonial) => (
            <figure>
              <blockquote>{testimonial.quote}</blockquote>
              <figcaption>
                <strong>{testimonial.name}</strong>
                <span>{testimonial.role}, {testimonial.company}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    )}
    {homePage.customerTrust.caseStudies.length > 0 && (
      <div class="case-study-grid" aria-label="Customer case studies">
        {homePage.customerTrust.caseStudies.map((caseStudy) => (
          <article class="case-study-card">
            <span>{caseStudy.industry}</span>
            <h3>{caseStudy.locations}</h3>
            <p>{caseStudy.users}</p>
            <ul class="product-features">
              {caseStudy.results.map((result) => <li>{result}</li>)}
            </ul>
            <a class="text-link" href={caseStudy.href}>View case study</a>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<section class="page-section" aria-labelledby="integration-title">
  <div class="container">
    <div class="integration-band">
      <div>
        <h2 id="integration-title">{homePage.integrations.title}</h2>
        <p>{homePage.integrations.body} <a href="/pricing">View pricing</a> for integration availability.</p>
      </div>
      <div class="integration-grid">
        {homePage.integrations.items.map((integration) => <span>{integration}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="page-section page-section-quiet" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div class="section-heading">
      <h2 id="faq-title">Workspace booking and management FAQ.</h2>
      <p>Short answers help visitors, search engines, and AI assistants understand what Skedular does.</p>
    </div>
    <div class="faq-list">
      {homePage.faq.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="page-section final-cta-section" aria-labelledby="final-cta-title">
  <div class="container">
    <div class="final-cta-panel">
      <h2 id="final-cta-title">{homePage.finalCta.title}</h2>
      <p>{homePage.finalCta.body}</p>
      <div class="button-row">
        <CtaLink cta={getCta("book-demo")} variant="inverse" />
        <a class="text-link" href="/teams">Explore Teams</a>
        <a class="text-link" href="/spaces">Explore Spaces</a>
        <a class="text-link" href="/pricing">View Pricing</a>
      </div>
    </div>
  </div>
</section>
