---
import type { ResourceArticle } from "../data/content-types";

interface Props {
  articles: ResourceArticle[];
}

const { articles } = Astro.props;

const sortedArticles = [...articles].sort((a, b) =>
  b.publishedDate.localeCompare(a.publishedDate)
);

const formatPublishedDate = (date: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T00:00:00Z`));
---

<div class="resource-list">
  {sortedArticles.map((article) => (
    <article class="resource-card">
      <p class="eyebrow">{article.topicTags.join(" / ")}</p>
      <time class="article-meta" datetime={article.publishedDate}>{formatPublishedDate(article.publishedDate)}</time>
      <h2><a href={article.destinationPath}>{article.title}</a></h2>
      <p>{article.summary}</p>
    </article>
  ))}
</div>
