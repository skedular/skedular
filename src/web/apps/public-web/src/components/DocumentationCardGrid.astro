---
interface Props { items: Array<{ title: string; description: string; href: string; eyebrow?: string }>; }
const { items } = Astro.props;
const isSpacesWorkspaceSetup = items.some((item: (typeof items)[number]) => item.title === "Locations and resources") && items.some((item: (typeof items)[number]) => item.title === "Zones and floor plans");
const isSpacesProductsMarketplace = items.some((item: (typeof items)[number]) => item.title === "Marketplace setup") && items.some((item: (typeof items)[number]) => item.title === "Products and pricing");
---
{isSpacesWorkspaceSetup && <section class="documentation-section-landing"><p class="documentation-section-intro">Workspace setup is where a Spaces operator prepares the physical workspace before creating Products and making them available to customers.</p><p>A <strong>Location</strong> represents a physical place you manage. Its <strong>Resources</strong> are the bookable entities within it. Optional <strong>Zones</strong> can organize related Resources, while optional <strong>Floor Plans</strong> can represent them visually. Once this physical setup is ready, Products determine how the workspace is offered to customers.</p></section>}
{isSpacesProductsMarketplace && <section class="documentation-section-landing"><p class="documentation-section-intro">Products and marketplace is where a Spaces operator turns a prepared workspace into customer-facing offerings.</p><p>After preparing your physical <strong>Locations</strong> and <strong>Resources</strong>, use marketplace settings, Products, and pricing to shape how your workspace is presented and made available to customers. Products can use <strong>Product Tags</strong> to determine which Resources are eligible to be included in an offering.</p></section>}
<div class="documentation-card-grid">
  {items.map((item: (typeof items)[number]) => <a class="documentation-card" href={item.href}>
    {item.eyebrow && <p class="eyebrow">{item.eyebrow}</p>}
    <h2>{item.title}</h2><p>{item.description}</p><span>Read more <span aria-hidden="true">→</span></span>
  </a>)}
</div>
{isSpacesWorkspaceSetup && <section class="documentation-section-landing"><h2>Next step</h2><p>Once the physical workspace is ready, continue to <a href="/docs/spaces/products-and-marketplace">Products and marketplace</a> to create Products and configure how the workspace is offered to customers.</p></section>}
{isSpacesProductsMarketplace && <section class="documentation-section-landing"><h2>Next step</h2><p>Once your offering is configured and available, continue to <a href="/docs/spaces/bookings">Bookings</a> to manage the reservations customers create through those Products.</p></section>}
