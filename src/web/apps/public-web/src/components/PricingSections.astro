---
import { getCta } from "../data/ctas";
import { pricingPage } from "../data/pricing";
import CtaLink from "./CtaLink.astro";

interface Props {
  productId?: string;
}

const { productId } = Astro.props;
const productPricingModels = pricingPage.models.filter((model) => model.id === "teams" || model.id === "spaces" || model.id === "host");
const selectedModel = productPricingModels.find((model) => model.id === productId);
---

{
  selectedModel ? (
    <div class="pricing-focused-layout">
      <nav class="pricing-switcher" aria-label="Pricing product switcher">
        {productPricingModels.map((model) => (
          <a class:list={[model.id === selectedModel.id && "pricing-switcher-active"]} href={`/pricing/${model.id}`}>
            {model.name}
          </a>
        ))}
      </nav>

      <article class:list={["pricing-product-card", "pricing-product-card-focused", `pricing-product-card-${selectedModel.id}`]}>
        <div class="pricing-card-header">
          <p class="eyebrow">{selectedModel.basis}</p>
          <h2>{selectedModel.name}</h2>
          <p>{selectedModel.audience}</p>
        </div>

        <div class="tier-list tier-list-focused">
          {selectedModel.tiers.map((tier) => (
            <div class="tier">
              <strong>{tier.name}</strong>
              <span>{tier.price}</span>
              <p>{tier.summary}</p>
              <p class="tier-best-for">{tier.bestFor}</p>
              <ul>
                {tier.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
              {tier.price === "Contact Us" && (
                <a class="tier-contact-link" href="mailto:support@getskedular.com">
                  Contact us
                </a>
              )}
            </div>
          ))}
        </div>

        <div class="pricing-marketplace-note">
          <strong>How billing works</strong>
          <span>{selectedModel.basis}</span>
          <p>{selectedModel.buyingNote}</p>
        </div>

        <div class="pricing-card-cta">
          <CtaLink cta={getCta(selectedModel.ctaId as Parameters<typeof getCta>[0])} />
        </div>
      </article>

      {selectedModel.explanationTitle && selectedModel.explanationBody && (
        <section class="pricing-detail-section" aria-labelledby={`${selectedModel.id}-explanation-title`}>
          <h2 id={`${selectedModel.id}-explanation-title`}>{selectedModel.explanationTitle}</h2>
          <p>{selectedModel.explanationBody}</p>
        </section>
      )}

      <section class="pricing-detail-section" aria-labelledby={`${selectedModel.id}-included-title`}>
        <h2 id={`${selectedModel.id}-included-title`}>{selectedModel.includedTitle}</h2>
        <ul class="pricing-included-list">
          {selectedModel.includedItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section class="pricing-detail-section" aria-labelledby={`${selectedModel.id}-faq-title`}>
        <h2 id={`${selectedModel.id}-faq-title`}>Pricing FAQ</h2>
        <div class="pricing-faq-list">
          {selectedModel.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  ) : (
    <div class="pricing-selector-grid">
      {productPricingModels.map((model) => (
        <a class:list={["pricing-selector-card", `pricing-selector-card-${model.id}`]} href={`/pricing/${model.id}`}>
          <span>{model.basis}</span>
          <strong>{model.name}</strong>
          <p>{model.audience}</p>
          <p>{model.intro}</p>
          <em>View {model.name} pricing</em>
        </a>
      ))}
    </div>
  )
}

{
  !selectedModel && (
    <div class="pricing-review-note">
      <div>
        <p class="eyebrow">Pricing note</p>
        <h2>Choose the pricing model that matches how you operate</h2>
      </div>
      <p>{pricingPage.note}</p>
    </div>
  )
}
