---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  robots?: string;
}

import { defaultSocialImageUrl, getArticleMetadataForPath, getCanonicalUrl, getRobotsForPath } from "../data/seo";

const { title, description, canonicalPath, robots = getRobotsForPath(canonicalPath) } = Astro.props;
const canonicalUrl = getCanonicalUrl(canonicalPath);
const article = getArticleMetadataForPath(canonicalPath);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={defaultSocialImageUrl} />
<meta property="og:image:alt" content="Skedular logo" />
{article && <meta property="article:published_time" content={article.publishedDate} />}
{article && <meta property="article:modified_time" content={article.publishedDate} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={defaultSocialImageUrl} />
<link rel="icon" href="/images/skedular-logo-primary.svg" type="image/svg+xml" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
