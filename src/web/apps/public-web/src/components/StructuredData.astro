---
interface Props {
  type?: "Organization" | "Product" | "FAQPage" | "BreadcrumbList" | "Article" | "BlogPosting" | "WebSite" | "SoftwareApplication";
  name: string;
  description?: string;
  path?: string;
  breadcrumbs?: Array<{ name: string; path: string }>;
  graph?: Record<string, unknown> | Record<string, unknown>[];
}

const { type = "Organization", name, description, path = "/", breadcrumbs = [], graph: providedGraph } = Astro.props;

import { defaultSocialImageUrl, getArticleMetadataForPath, getCanonicalUrl, siteUrl } from "../data/seo";

const article = getArticleMetadataForPath(path);
const url = getCanonicalUrl(path);
let graph: any = {};

if (type === "BreadcrumbList") {
  graph = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb: { name: string; path: string }, index: number) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: getCanonicalUrl(crumb.path),
    })),
  };
} else if (type === "Article" || type === "BlogPosting") {
  graph = {
    "@context": "https://schema.org",
    "@type": type,
    headline: name,
    description,
    url,
    image: defaultSocialImageUrl,
    datePublished: article?.publishedDate,
    dateModified: article?.publishedDate,
    author: {
      "@type": "Organization",
      name: "Skedular",
      url: siteUrl,
    },
    publisher: {
      "@type": "Organization",
      name: "Skedular",
      url: siteUrl,
      logo: new URL("/images/skedular-logo-primary.svg", siteUrl).toString(),
    },
  };
} else if (type === "Product") {
  graph = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name,
    description,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    brand: {
      "@type": "Brand",
      name: "Skedular",
    },
    url,
    image: defaultSocialImageUrl,
  };
} else if (providedGraph) {
  graph = providedGraph;
} else {
  graph = {
    "@context": "https://schema.org",
    "@type": type,
    name,
    description,
    url,
  };
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
