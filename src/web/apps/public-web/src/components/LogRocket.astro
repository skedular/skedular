---
const logRocketAppId = import.meta.env.PUBLIC_LOGROCKET_APP_ID?.trim();
---

{
  logRocketAppId && (
    <script>
      import LogRocket from "logrocket";

      const appId = import.meta.env.PUBLIC_LOGROCKET_APP_ID?.trim();

      if (appId) {
        LogRocket.init(appId);
      }
    </script>
  )
}
