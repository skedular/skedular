---
import type { DocumentationArticle as Article } from "../data/documentation";
import { getDocumentationPath } from "../data/documentation";
import SlackInstallButton from "./SlackInstallButton.astro";
interface Props { article: Article; related: Article[]; previous?: Article; next?: Article; previousOverride?: { title: string; href: string }; }
const { article, related, previous, next, previousOverride } = Astro.props;
const resolvedPreviousOverride = article.id === "host-places" ? { title: "Getting Started", href: "/docs/host/getting-started" } : article.id === "host-pricing" ? { title: "Your place", href: "/docs/host/your-place" } : article.id === "host-bookings" ? { title: "Pricing and availability", href: "/docs/host/pricing-and-availability" } : article.id === "host-payments" ? { title: "Bookings and renters", href: "/docs/host/bookings-and-renters" } : article.id === "host-media" ? { title: "Payments and refunds", href: "/docs/host/payments-and-refunds" } : article.id === "host-faq" ? { title: "Managing your listing", href: "/docs/host/managing-your-listing" } : article.id === "host-operations" ? { title: "FAQs", href: "/docs/host/faqs" } : article.id === "spaces-operations" ? { title: "FAQs", href: "/docs/spaces/faqs" } : article.id === "spaces-faq" ? { title: "Operator analytics", href: "/docs/spaces/analytics" } : article.id === "spaces-analytics" ? { title: "Xero accounting", href: "/docs/spaces/billing-and-payments/xero-accounting" } : article.id === "spaces-xero" ? { title: "Refunds", href: "/docs/spaces/billing-and-payments/refunds" } : article.id === "spaces-refunds" ? { title: "Payment methods", href: "/docs/spaces/billing-and-payments/payment-methods" } : article.id === "spaces-bank-payments" ? { title: "Billing and payments", href: "/docs/spaces/billing-and-payments" } : article.id === "spaces-subscriptions" ? { title: "Bookings", href: "/docs/spaces/bookings" } : article.id === "spaces-bookings" ? { title: "Products and pricing", href: "/docs/spaces/products-and-marketplace/products-and-pricing" } : article.id === "teams-set-up-workplace" ? { title: "Workplace Setup", href: "/docs/teams/workplace-setup" } : article.id === "teams-private-bookings" ? { title: "Organize your people", href: "/docs/teams/workplace-setup/organize-your-people" } : article.id === "teams-slack" ? { title: "Integrations", href: "/docs/teams/integrations" } : article.id === "teams-faq" ? { title: "Enterprise sign-in", href: "/docs/teams/integrations/enterprise-sign-in" } : previousOverride;
const resolvedNext = article.id === "host-places" ? { title: "Pricing and availability", href: "/docs/host/pricing-and-availability" } : article.id === "host-pricing" ? { title: "Bookings and renters", href: "/docs/host/bookings-and-renters" } : article.id === "host-bookings" ? { title: "Payments and refunds", href: "/docs/host/payments-and-refunds" } : article.id === "host-payments" ? { title: "Managing your listing", href: "/docs/host/managing-your-listing" } : article.id === "host-media" ? { title: "FAQs", href: "/docs/host/faqs" } : article.id === "host-faq" ? { title: "Best Practices", href: "/docs/host/best-practices" } : article.id === "host-get-started" ? { title: "Your place", href: "/docs/host/your-place" } : article.id === "spaces-faq" ? { title: "Best Practices", href: "/docs/spaces/best-practices" } : article.id === "spaces-analytics" ? { title: "FAQs", href: "/docs/spaces/faqs" } : article.id === "spaces-xero" ? { title: "Operator analytics", href: "/docs/spaces/analytics" } : article.id === "spaces-refunds" ? { title: "Xero accounting", href: "/docs/spaces/billing-and-payments/xero-accounting" } : article.id === "spaces-bank-payments" ? { title: "Refunds", href: "/docs/spaces/billing-and-payments/refunds" } : article.id === "spaces-subscriptions" ? { title: "Billing and payments", href: "/docs/spaces/billing-and-payments" } : article.id === "spaces-bookings" ? { title: "Subscriptions", href: "/docs/spaces/bookings/subscriptions" } : article.id === "teams-organize-people" ? { title: "Bookings", href: "/docs/teams/bookings" } : article.id === "teams-private-bookings" ? { title: "Integrations", href: "/docs/teams/integrations" } : article.id === "teams-sso" ? { title: "FAQs", href: "/docs/teams/faqs" } : article.id === "teams-faq" ? { title: "Best Practices", href: "/docs/teams/best-practices" } : next;
const showRelated = related.length > 0 && !["shared-organizations", "shared-locations", "shared-resources", "shared-tags", "shared-zones", "shared-organization-settings", "shared-products", "shared-customers", "shared-subscriptions", "shared-payments", "shared-billing-payouts", "shared-analytics", "teams-faq", "teams-best-practices", "spaces-faq", "spaces-operations", "spaces-analytics", "spaces-get-started", "spaces-bookings", "spaces-subscriptions", "spaces-bank-payments", "spaces-refunds", "spaces-xero", "spaces-locations-resources", "spaces-zones-floor-plans", "spaces-marketplace-setup", "spaces-products-pricing", "host-get-started", "host-places", "host-pricing", "host-bookings", "host-payments", "host-media", "host-faq", "host-operations"].includes(article.id);
const relatedHtml = showRelated ? `<section class="documentation-related" aria-labelledby="related-articles"><h2 id="related-articles">${article.product === "shared" ? "Continue learning" : "Related Documentation"}</h2><ul>${related.map((item: Article) => `<li><a href="${getDocumentationPath(item)}">${item.title}</a></li>`).join("")}</ul></section>` : "";
---
<article class="documentation-article">
  <header><p class="eyebrow">{article.category === "administration" ? "Administration guide" : article.category === "marketplace" ? "Marketplace guide" : article.category === "commerce" ? "Commerce guide" : article.category === "insights" ? "Insights guide" : article.product === "teams" ? "Skedular Teams guide" : article.product === "spaces" ? "Skedular Spaces" : article.product === "host" ? "Skedular Host" : article.id === "shared-organizations" ? "🏢 Organization" : article.id === "shared-users" ? "👤 User" : article.id === "shared-teams" ? "👥 Team" : article.id === "shared-bookings" ? "📅 Booking" : article.id === "shared-floor-plans" ? "🗺 Floor Plan" : article.id === "shared-availability" ? "⏱ Availability" : article.id === "shared-tags" ? "🏷 Tag" : article.id === "shared-zones" ? "🔲 Zone" : article.product === "shared" ? "Shared Skedular concept" : `Skedular ${article.product}`}</p><h1>{article.title}</h1><p class="lead">{article.description}</p></header>
  <div class="documentation-prose">{article.id === "teams-slack" && <SlackInstallButton />}<slot /></div>
  {(resolvedPreviousOverride || previous || resolvedNext) && <nav class="documentation-pagination" aria-label="Article navigation">
    {resolvedPreviousOverride ? <a href={resolvedPreviousOverride.href}>← {resolvedPreviousOverride.title}</a> : previous ? <a href={getDocumentationPath(previous)}>← {previous.title}</a> : <span />}
    {resolvedNext && <a href={resolvedNext.href ?? getDocumentationPath(resolvedNext)}>{resolvedNext.title} →</a>}
  </nav>}
  <Fragment set:html={relatedHtml} />
</article>
