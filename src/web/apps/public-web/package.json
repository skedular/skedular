{
  "name": "public-web",
  "version": "0.1.0",
  "description": "Skedular public website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 15008",
    "build": "astro check && astro build && node ./scripts/report-build.mjs",
    "preview": "astro preview --port 15008",
    "start": "pnpm preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "^7.4.4",
    "logrocket": "^12.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
