{
  "name": "public-web",
  "version": "0.1.0",
  "description": "Skedular public website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 15008",
    "build": "astro check && astro build && node ./scripts/report-build.mjs",
    "preview": "astro preview --port 15008",
    "start": "pnpm preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "^7.2.4",
    "logrocket": "^12.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.2.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
