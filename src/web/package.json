{
  "name": "skedular-web",
  "description": "Skedular Web",
  "private": true,
  "engines": {
    "node": "^22"
  },
  "packageManager": "pnpm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:teams": "turbo run dev:teams",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "node ./scripts/test-ui.mjs",
    "capture:media": "node ./scripts/capture-media.mjs",
    "capture:media:webapp": "node ./scripts/capture-media.mjs webapp login-flow --output ./docs-media",
    "capture:media:webapp-spaces": "node ./scripts/capture-media.mjs webapp-spaces spaces-list --output ./docs-media",
    "capture:media:webapp-teams": "node ./scripts/capture-media.mjs webapp-teams teams-list --output ./docs-media",
    "capture:media:all": "pnpm capture:media:webapp && pnpm capture:media:webapp-spaces && pnpm capture:media:webapp-teams",
    "lint-fix": "turbo run lint-fix",
    "format": "turbo run format",
    "postinstall": "pnpm --filter webapp exec playwright install chromium",
    "check:workspace-version-sync": "node ./scripts/check-workspace-version-sync.mjs",
    "relay": "turbo run relay",
    "webapp#build": "turbo run webapp#build",
    "webapp#start": "turbo run webapp#start",
    "webapp#lint": "turbo run webapp#lint",
    "webapp#test": "turbo run webapp#test",
    "webapp#test:watch": "turbo run webapp#test:watch",
    "webapp#lint-fix": "turbo run webapp#lint-fix",
    "webapp#format": "turbo run webapp#format",
    "webapp#relay": "turbo run webapp#relay",
    "webapp-teams#build": "turbo run webapp-teams#build",
    "webapp-teams#start": "turbo run webapp-teams#start",
    "webapp-teams#lint": "turbo run webapp-teams#lint",
    "webapp-teams#test": "turbo run webapp-teams#test",
    "webapp-teams#test:watch": "turbo run webapp-teams#test:watch",
    "webapp-teams#lint-fix": "turbo run webapp-teams#lint-fix",
    "webapp-teams#format": "turbo run webapp-teams#format",
    "webapp-teams#relay": "turbo run webapp-teams#relay",
    "webapp-spaces#build": "turbo run webapp-spaces#build",
    "webapp-spaces#start": "turbo run webapp-spaces#start",
    "webapp-spaces#lint": "turbo run webapp-spaces#lint",
    "webapp-spaces#test": "turbo run webapp-spaces#test",
    "webapp-spaces#test:watch": "turbo run webapp-spaces#test:watch",
    "webapp-spaces#lint-fix": "turbo run webapp-spaces#lint-fix",
    "webapp-spaces#format": "turbo run webapp-spaces#format",
    "webapp-spaces#relay": "turbo run webapp-spaces#relay",
    "webapp-host#build": "turbo run webapp-host#build",
    "webapp-host#start": "turbo run webapp-host#start",
    "webapp-host#lint": "turbo run webapp-host#lint",
    "webapp-host#test": "turbo run webapp-host#test",
    "webapp-host#test:watch": "turbo run webapp-host#test:watch",
    "webapp-host#lint-fix": "turbo run webapp-host#lint-fix",
    "webapp-host#format": "turbo run webapp-host#format",
    "webapp-host#relay": "turbo run webapp-host#relay",
    "public-web#dev": "turbo run public-web#dev",
    "public-web#build": "turbo run public-web#build",
    "public-web#start": "turbo run public-web#start",
    "public-web#test": "turbo run public-web#test",
    "public-web#lint": "turbo run public-web#lint",
    "public-web#lint-fix": "turbo run public-web#lint-fix",
    "public-web#format": "turbo run public-web#format"
  },
  "devDependencies": {
    "@types/relay-runtime": "^20.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-turbo": "^2.10.8",
    "global": "^4.4.0",
    "next": "^16.3.0",
    "turbo": "^2.10.8"
  }
}
