}

input AddResourceInput {
  clientMutationId: String
  id: String
  name: String!
  inactive: Boolean!
  locationId: String!
  customTagIds: [String!]!
  zoneIds: [String!]!
  productTagIds: [String!]!
  requireBookingApproval: Boolean!
  color: String
  capacity: Int!
  organizationResourceTypeId: String!
}

input AreaRangeInput {
  fromInSqm: String!
  toInSqm: String!
}

input BulkAddResourceRowInput {
  organizationResourceTypeTagId: String!
  baseName: String
  quantity: Int!
  customTagIds: [String!]!
  zoneIds: [String!]!
  productTagIds: [String!]!
}

input BulkAddResourcesInput {
  clientMutationId: String
  locationId: String!
  rows: [BulkAddResourceRowInput!]!
}

input CdnFileInput {
  url: String!
  height: Int
  width: Int
}

input CdnImageFileInput {
  original: CdnFileInput
  thumbnail: CdnFileInput
}

input ClaimLocationOwnershipInput {
  clientMutationId: String
  id: String
  uniqueClaimCode: String!
  organizationId: String
  organizationCustomDomain: String
}

input ContactDetailsInput {
  contactPeople: [String!]
  contactEmails: [String!]
  contactPhones: [String!]
}

input DeactivateResourcesInput {
  clientMutationId: String
  ids: [String!]!
}

input DeleteFloorPlanInput {
  clientMutationId: String
  id: String!
}

input DeleteLocationInput {
  clientMutationId: String
  id: String!
}

input DeleteLocationRestrictedInformationInput {
  clientMutationId: String
  id: String!
}

input DeleteResourceInput {
  clientMutationId: String
  id: String!
}

input DeleteResourcesInput {
  clientMutationId: String
  ids: [String!]!
}

input FloorPlanOrderInput {
  direction: OrderDirection!
  field: FloorPlanOrderField!
}

input FloorPlanWhereInput {
  locationId: String!
}

input ListingMetadataInput {
  about: String
  title: String
  subTitle: String
  includedFeatures: [String!]
}

input LocationExtraMetadataInput {
  contactDetails: ContactDetailsInput
  areaRange: AreaRangeInput
  peopleCapacity: PeopleCapacityInput
  website: String
  relatedImageLinks: [String!]
  relatedVideoLinks: [String!]
  otherLinks: [String!]
}

input LocationOrderInput {
  direction: OrderDirection!
  field: LocationOrderField!
}

input LocationPhysicalAddressInput {
  osmType: String
  osmId: String
  placeId: String
  longitude: Float
  latitude: Float
  formattedAddress: String
  addressLine1: String!
  addressLine2: String
  suburb: String
  city: String
  province: String
  zipcode: String!
  country: String!
  countryCode: String
}

input LocationWhereInput {
  organizationCustomDomain: String
  locationIds: [String!]
  nameContains: String
  customTagIds: [String!]
  zoneIds: [String!]
  types: [LocationType!]
  searchBoundaries: PolygonInput
  notContactedYet: Boolean
  resourceType: OrganizationTagType
  productIds: [String!]
}

input MarketplaceLocationWhereInput {
  organizationId: String
  organizationCustomDomain: String
  locationIds: [String!]
  nameContains: String
  customTagIds: [String!]
  zoneIds: [String!]
  searchBoundaries: PolygonInput
  resourceType: OrganizationTagType
  productIds: [String!]
}

input OpeningHoursDetailsInput {
  closed: Boolean!
  openAllDay: Boolean!
  from: String
  until: String
}

input PeopleCapacityInput {
  from: String!
  to: String!
}

input PointCoordinatesInput {
  longitude: Float!
  latitude: Float!
}

input PolygonInput {
  northEast: PointCoordinatesInput!
  southWest: PointCoordinatesInput!
}

input ResourceOrderInput {
  direction: OrderDirection!
  field: ResourceOrderField!
}

input ResourcePositionInput {
  resourceId: String!
  x: Int!
  y: Int!
}

input ResourceWhereInput {
  nameContains: String
  customTagIds: [String!]
  zoneIds: [String!]
  productTagIds: [String!]
  floorPlanId: String
}

input ToggleContactedViaCallInput {
  clientMutationId: String
  locationId: String!
}

input ToggleContactedViaEmailInput {
  clientMutationId: String
  locationId: String!
}

input ToggleContactedViaSmsInput {
  clientMutationId: String
  locationId: String!
}

input ToggleContactedViaWhatsappInput {
  clientMutationId: String
  locationId: String!
}

input UpdateFloorPlanInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [FloorPlanPatchField!]!
  name: String!
  image: CdnImageFileInput!
  resourcePositions: [ResourcePositionInput!]
}

input UpdateLocationInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [LocationPatchField!]!
  name: String!
  timezone: String
  type: LocationType!
  tagIds: [String!]!
  featureImages: [CdnImageFileInput!]
  extraMetadata: LocationExtraMetadataInput
  listingMetadata: ListingMetadataInput
}

input UpdateLocationOpeningHoursInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [LocationOpeningHoursPatchField!]!
  weekOpeningHours: WeekOpeningHoursInput!
}

input UpdateLocationPhysicalAddressInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [LocationPhysicalAddressPatchField!]!
  osmType: String
  osmId: String
  placeId: String
  longitude: Float
  latitude: Float
  formattedAddress: String
  addressLine1: String!
  addressLine2: String
  suburb: String
  city: String
  province: String
  zipcode: String!
  country: String!
  countryCode: String
}

input UpdateLocationResourceAvailableHoursInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [LocationResourceAvailableHoursPatchField!]!
  overrideAvailableHours: Boolean!
  availableHours: WeekOpeningHoursInput
}

input UpdateLocationRestrictedInformationInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [LocationRestrictedInformationPatchField!]!
  title: String!
  category: LocationRestrictedInformationCategory!
  content: String!
  active: Boolean!
  sortOrder: Int!
}

input UpdateResourceInput {
  clientMutationId: String
  id: String!
  fieldsToUpdate: [ResourcePatchField!]!
  name: String!
  inactive: Boolean!
  requireBookingApproval: Boolean!
  color: String
  capacity: Int!
  customTagIds: [String!]!
  zoneIds: [String!]!
  productTagIds: [String!]!
  organizationResourceTypeId: String!
}

input UpdateResourcePositionsInput {
  clientMutationId: String
  floorPlanId: String!
  fieldsToUpdate: [ResourcePositionsPatchField!]!
  resourcePositions: [ResourcePositionInput!]!
}

input WeekOpeningHoursInput {
  monday: OpeningHoursDetailsInput!
  tuesday: OpeningHoursDetailsInput!
  wednesday: OpeningHoursDetailsInput!
  thursday: OpeningHoursDetailsInput!
  friday: OpeningHoursDetailsInput!
  saturday: OpeningHoursDetailsInput!
  sunday: OpeningHoursDetailsInput!
}

enum FloorPlanOrderField {
  NAME
}

enum FloorPlanPatchField {
  NAME
  IMAGE
  RESOURCE_POSITIONS
}

enum LocationOpeningHoursPatchField {
  WEEK_OPENING_HOURS
}

enum LocationOrderField {
  NAME
  TIMEZONE
  TYPE
}

enum LocationPatchField {
  NAME
  TIMEZONE
  TYPE
  ORGANIZATION
  TAGS
  FEATURE_IMAGES
  EXTRA_METADATA
  LISTING_METADATA
  PHYSICAL_ADDRESS
  UNIQUE_CLAIM_CODE
}

enum LocationPhysicalAddressPatchField {
  ADDRESS
}

enum LocationResourceAvailableHoursPatchField {
  AVAILABLE_HOURS
}

enum LocationRestrictedInformationCategory {
  OTHER
  WIFI
  ACCESS
  PARKING
  CHECK_IN
  CHECK_OUT
  AFTER_HOURS
  DELIVERIES
  GUESTS
  EQUIPMENT
  KITCHEN
  MEETING_ROOMS
  NOISE
  MAINTENANCE
  ACCESSIBILITY
  STORAGE
  CLEANING
  WASTE
  SECURITY
  EVACUATION
  PETS
  SMOKING
  HOUSE_RULES
}

enum LocationRestrictedInformationPatchField {
  TITLE
  CATEGORY
  CONTENT
  ACTIVE
  SORT_ORDER
}

enum LocationType {
  PRIVATE
  MARKETPLACE
}

enum OrderDirection {
  ASCENDING
  DESCENDING
}

