schema {
  query: Query
  mutation: Mutation
}

type Query {
  locationsAnalytics(
    from: DateTime!
    until: DateTime!
    where: LocationWhereInput
    orderBy: [LocationOrderInput!]
  ): [LocationAnalytics!]! @cost(weight: "10")
  floorPlan(id: String!): FloorPlanDetails @cost(weight: "10")
  floorPlanById(id: ID!): FloorPlanDetails @lookup @internal @cost(weight: "10")
  floorPlans(
    after: String
    first: Int
    before: String
    last: Int
    where: FloorPlanWhereInput!
    orderBy: [FloorPlanOrderInput!]
  ): ConnectionOfFloorPlanEdge! @cost(weight: "10")
  locationTypes: [LocationTypeDetails!]!
  locationRestrictedInformationCategories: [LocationRestrictedInformationCategoryDetails!]!
  location(id: String!): LocationDetails @cost(weight: "10")
  locationById(id: ID!): LocationDetails @lookup @internal @cost(weight: "10")
  locations(
    after: String
    first: Int
    before: String
    last: Int
    where: LocationWhereInput!
    orderBy: [LocationOrderInput!]
  ): ConnectionOfLocationEdge! @cost(weight: "10")
  marketplaceLocations(
    after: String
    first: Int
    before: String
    last: Int
    where: MarketplaceLocationWhereInput!
    orderBy: [LocationOrderInput!]
  ): ConnectionOfLocationEdge! @cost(weight: "10")
  myLocations(organizationId: String, organizationCustomDomain: String): [LocationDetails!]
    @cost(weight: "10")
  resource(id: String!): ResourceDetails @cost(weight: "10")
  resourceById(id: ID!): ResourceDetails @lookup @internal @cost(weight: "10")
  locationVersion: Version!
  locationCustomerRecordSynced: Boolean! @cost(weight: "10")
}

type Mutation {
  toggleContactedViaEmail(input: ToggleContactedViaEmailInput!): LocationPayload!
    @cost(weight: "10")
  toggleContactedViaCall(input: ToggleContactedViaCallInput!): LocationPayload!
    @cost(weight: "10")
  toggleContactedViaSms(input: ToggleContactedViaSmsInput!): LocationPayload!
    @cost(weight: "10")
  toggleContactedViaWhatsapp(input: ToggleContactedViaWhatsappInput!): LocationPayload!
    @cost(weight: "10")
  addFloorPlan(input: AddFloorPlanInput!): FloorPlanPayload! @cost(weight: "10")
  updateFloorPlan(input: UpdateFloorPlanInput!): FloorPlanPayload!
    @cost(weight: "10")
  deleteFloorPlan(input: DeleteFloorPlanInput!): FloorPlanPayload!
    @cost(weight: "10")
  updateResourcePositions(input: UpdateResourcePositionsInput!): FloorPlanPayload!
    @cost(weight: "10")
  addLocation(input: AddLocationInput!): LocationPayload! @cost(weight: "10")
  updateLocation(input: UpdateLocationInput!): LocationPayload!
    @cost(weight: "10")
  deleteLocation(input: DeleteLocationInput!): LocationPayload!
    @cost(weight: "10")
  updateLocationOpeningHours(input: UpdateLocationOpeningHoursInput!): LocationPayload!
    @cost(weight: "10")
  addLocationRestrictedInformation(
    input: AddLocationRestrictedInformationInput!
  ): LocationPayload! @cost(weight: "10")
  updateLocationRestrictedInformation(
    input: UpdateLocationRestrictedInformationInput!
  ): LocationPayload! @cost(weight: "10")
  deleteLocationRestrictedInformation(
    input: DeleteLocationRestrictedInformationInput!
  ): LocationPayload! @cost(weight: "10")
  claimLocationOwnership(input: ClaimLocationOwnershipInput!): LocationPayload!
    @cost(weight: "10")
  addLocationPhysicalAddress(input: AddLocationPhysicalAddressInput!): LocationPayload!
    @cost(weight: "10")
  updateLocationPhysicalAddress(input: UpdateLocationPhysicalAddressInput!): LocationPayload!
    @cost(weight: "10")
  addResource(input: AddResourceInput!): ResourcePayload! @cost(weight: "10")
  updateResource(input: UpdateResourceInput!): ResourcePayload!
    @cost(weight: "10")
  deleteResource(input: DeleteResourceInput!): ResourcePayload!
    @cost(weight: "10")
  deleteResources(input: DeleteResourcesInput!): ResourcesPayload!
    @cost(weight: "10")
  activateResources(input: ActivateResourcesInput!): ResourcesPayload!
    @cost(weight: "10")
  deactivateResources(input: DeactivateResourcesInput!): ResourcesPayload!
    @cost(weight: "10")
  updateLocationResourceAvailableHours(
    input: UpdateLocationResourceAvailableHoursInput!
  ): ResourcePayload! @cost(weight: "10")
  bulkAddResources(input: BulkAddResourcesInput!): BulkAddResourcesPayload!
    @cost(weight: "10")
}

type AreaRange {
  fromInSqm: String!
  toInSqm: String!
}

type BulkAddResourceRowResult {
  rowIndex: Int!
  createdResources: [ResourceDetails!]!
  failureReason: String
}

type BulkAddResourcesPayload {
  clientMutationId: String
  results: [BulkAddResourceRowResult!]!
}

type CdnFile @shareable {
  url: String!
  height: Int
  width: Int
}

type CdnImageFile @shareable {
  original: CdnFile
  thumbnail: CdnFile
}

type ConnectionOfFloorPlanEdge {
  pageInfo: PageInfo!
  edges: [FloorPlanEdge!]!
  totalCount: Int!
}

type ConnectionOfLocationEdge {
  pageInfo: PageInfo!
  edges: [LocationEdge!]!
  totalCount: Int!
}

type ConnectionOfResourceEdge {
  pageInfo: PageInfo!
  edges: [ResourceEdge!]!
  totalCount: Int!
}

type ContactDetails {
  contactPeople: [String!]
  contactEmails: [String!]
  contactPhones: [String!]
}

type DesksOccupancyPercentage {
  date: DateTime!
  percentage: Float!
}

type FloorPlanDetails {
  name: String!
  image: CdnImageFile!
  resourcePositions: [ResourcePositionDetails!]!
  resourceCount: Int!
  id: ID!
}

type FloorPlanEdge {
  node: FloorPlanDetails!
  cursor: String!
}

type FloorPlanPayload {
  clientMutationId: String
  floorPlan: FloorPlanDetails!
}

type ListingMetadata @shareable {
  about: String
  title: String
  subTitle: String
  includedFeatures: [String!]
}

type LocationAnalytics {
  name: String!
  desksOccupancyPercentage: [DesksOccupancyPercentage!]!
  roomsOccupancyPercentage: [RoomsOccupancyPercentage!]!
  dailyBookingsTotals: [LocationDailyBookingsTotal!]!
  resourceAvailabilitySnapshots: [ResourceAvailabilityDailySnapshot!]!
}

type LocationDailyBookingsTotal {
  date: DateTime!
  total: Int!
}

type LocationDetails {
  organization: OrganizationDetails!
  products: [ProductDetails!]!
  analytics(from: DateTime!, until: DateTime!): LocationAnalytics!
    @cost(weight: "10")
  resources(
    after: String
    first: Int
    before: String
    last: Int
    where: ResourceWhereInput
    orderBy: [ResourceOrderInput!]
  ): ConnectionOfResourceEdge! @cost(weight: "10")
  name: String!
  timezone: String
  type: LocationTypeDetails!
  openingHours: OpeningHours!
  deskCapacity: Int!
  roomCapacity: Int!
  canModify: Boolean!
  canDelete: Boolean!
  canViewAnalytics: Boolean!
  physicalAddress: LocationPhysicalAddressDetails
  customTags: [OrganizationTagDetails!]!
  zones: [OrganizationTagDetails!]!
  spaceTypes: [OrganizationTagDetails!]!
  amenities: [OrganizationTagDetails!]!
  resourceTypes: [OrganizationTagDetails!]!
  featureImages: [CdnImageFile!]!
  floorPlanCount: Int!
  extraMetadata: LocationExtraMetadata
  uniqueClaimCode: String
  contactedViaEmail: Boolean!
  contactedViaSms: Boolean!
  contactedViaCall: Boolean!
  contactedViaWhatsapp: Boolean!
  listingMetadata: ListingMetadata!
  restrictedInformation: [LocationRestrictedInformationDetails!]!
  id: ID!
}

type LocationEdge {
  node: LocationDetails!
  cursor: String!
}

type LocationExtraMetadata {
  contactDetails: ContactDetails
  areaRange: AreaRange
  peopleCapacity: PeopleCapacity
  website: String
  relatedImageLinks: [String!]
  relatedVideoLinks: [String!]
  otherLinks: [String!]
}

type LocationPayload {
  clientMutationId: String
  location: LocationDetails!
}

type LocationPhysicalAddressDetails {
  osmType: String
  osmId: String
  placeId: String
  longitude: Float
  latitude: Float
  formattedAddress: String
  multilinesFormattedAddress: String
  addressLine1: String!
  addressLine2: String
  suburb: String
  city: String
  province: String
  zipcode: String!
  country: String!
  countryCode: String
  organization: LocationDetails!
  id: ID!
}

type LocationRestrictedInformationCategoryDetails {
  category: LocationRestrictedInformationCategory!
  name: String!
}

type LocationRestrictedInformationDetails {
  title: String!
  category: LocationRestrictedInformationCategory!
  content: String!
  active: Boolean!
  sortOrder: Int!
  locationId: String!
  id: ID!
}

type LocationTypeDetails {
  type: LocationType!
  name: String!
}

type OpeningHours {
  weekOpeningHours: WeekOpeningHours!
  closedDates: [DateTime!]!
  datesWithVariedOpeningHours: [VariedDateOpeningHours!]!
}

type OpeningHoursDetails {
  closed: Boolean!
  openAllDay: Boolean!
  from: String
  until: String
}

type OrganizationDetails @key(fields: "id") @shareable {
  customDomain: String
  id: ID!
}

type OrganizationTagDetails @key(fields: "id") @shareable {
  name: String!
  type: OrganizationTagType
  color: String
  id: ID!
}

type PageInfo @shareable {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type PeopleCapacity {
  from: String!
  to: String!
}

type ProductDetails @key(fields: "id") {
  id: ID!
}

type ResourceAvailabilityDailySnapshot {
  date: DateTime!
  resourceType: String!
  availableCount: Int!
  unavailableCount: Int!
  bookedCount: Int!
  availableResourceNames: [String!]!
  unavailableResourceNames: [String!]!
  bookedResourceNames: [String!]!
}

type ResourceDetails @key(fields: "id") @shareable {
  name: String!
  inactive: Boolean!
  requireBookingApproval: Boolean!
  color: String
  capacity: Int!
  customTags: [OrganizationTagDetails!]!
  zones: [OrganizationTagDetails!]!
  productTags: [OrganizationTagDetails!]!
  resourceType: OrganizationTagDetails!
  isAvailableHoursOverridden: Boolean!
  availableHours: OpeningHours
  id: ID!
}

type ResourceEdge {
  node: ResourceDetails!
  cursor: String!
}

type ResourcePayload {
  clientMutationId: String
  resource: ResourceDetails!
}

type ResourcePositionDetails {
  x: Int!
  y: Int!
  resource: ResourceDetails!
  id: ID!
}

type ResourcesPayload {
  clientMutationId: String
  resources: [ResourceDetails!]!
}

type RoomsOccupancyPercentage {
  date: DateTime!
  percentage: Float!
}

type VariedDateOpeningHours {
  date: DateTime!
  openingHoursDetails: OpeningHoursDetails!
}

type Version @shareable {
  major: Int!
  minor: Int!
  build: Int!
  revision: Int!
}

type WeekOpeningHours {
  monday: OpeningHoursDetails!
  tuesday: OpeningHoursDetails!
  wednesday: OpeningHoursDetails!
  thursday: OpeningHoursDetails!
  friday: OpeningHoursDetails!
  saturday: OpeningHoursDetails!
  sunday: OpeningHoursDetails!
}

input ActivateResourcesInput {
  clientMutationId: String
  ids: [String!]!
}

input AddFloorPlanInput {
  clientMutationId: String
  id: String
  locationId: String!
  name: String!
  image: CdnImageFileInput!
  resourcePositions: [ResourcePositionInput!]
}

input AddLocationInput {
  clientMutationId: String
  id: String
  name: String!
  organizationId: String
  organizationCustomDomain: String
  timezone: String
  type: LocationType!
  tagIds: [String!]!
  featureImages: [CdnImageFileInput!]
  physicalAddress: LocationPhysicalAddressInput
  extraMetadata: LocationExtraMetadataInput
  weekOpeningHours: WeekOpeningHoursInput
  listingMetadata: ListingMetadataInput
}

input AddLocationPhysicalAddressInput {
  clientMutationId: String
  id: String
  locationId: String!
